{
  "name": "lamaui",
  "version": "0.1.0",
  "private": false,
  "description": "Accessible, styled Astro UI primitives.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/lib/styles.ts",
    "./styles.css": "./src/styles/global.css",
    "./effects": "./src/scripts/components.ts",
    "./data-display/*": "./src/components/data-display/*.astro",
    "./feedback/*": "./src/components/feedback/*.astro",
    "./forms/*": "./src/components/forms/*.astro",
    "./layout/*": "./src/components/layout/*.astro",
    "./navigation/*": "./src/components/navigation/*.astro",
    "./overlays/*": "./src/components/overlays/*.astro",
    "./ui/*": "./src/components/ui/*.astro",
    "./components/*": "./src/components/*"
  },
  "files": [
    "src/assets/fonts",
    "src/assets/icons/wrap-off.svg",
    "src/assets/icons/wrap-on.svg",
    "src/components/data-display",
    "src/components/feedback",
    "src/components/forms",
    "src/components/layout",
    "src/components/navigation",
    "src/components/overlays",
    "src/components/ui",
    "src/icons/package.ts",
    "src/lib/accents.ts",
    "src/lib/classes.ts",
    "src/lib/styles.ts",
    "src/scripts/alert.ts",
    "src/scripts/browser-theme.ts",
    "src/scripts/code-block.ts",
    "src/scripts/components.ts",
    "src/scripts/custom-select.ts",
    "src/scripts/details-menu.ts",
    "src/scripts/dialog.ts",
    "src/scripts/drawer.ts",
    "src/scripts/dropdown-menu.ts",
    "src/scripts/effect-shape.ts",
    "src/scripts/hover.ts",
    "src/scripts/password-input.ts",
    "src/scripts/ripple.ts",
    "src/scripts/slider.ts",
    "src/scripts/surfaces.ts",
    "src/scripts/table-scroll.ts",
    "src/scripts/tabs.ts",
    "src/scripts/toast.ts",
    "src/scripts/toggle.ts",
    "src/scripts/tooltip.ts",
    "src/styles/animations.css",
    "src/styles/fonts.css",
    "src/styles/global.css",
    "src/styles/scrollbars.css",
    "src/styles/theme.css",
    "src/types",
    "src/index.ts",
    "README.md"
  ],
  "keywords": [
    "astro",
    "astro-component",
    "ui",
    "accessibility",
    "tailwindcss",
    "withastro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lama-development/lamaui.git"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "check:package": "node scripts/check-package.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:consumer": "astro build --root tests/fixtures/package-consumer",
    "test:package": "npm pack --dry-run --cache .npm-cache",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "shiki": "^4.5.0"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.6.4",
    "astro": "^7.3.5",
    "jspdf": "^4.2.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2"
  }
}
