---
interface Props {
  gap?: 1 | 2 | 3 | 4 | 6 | 8;
  align?: "start" | "center" | "end" | "baseline";
  justify?: "start" | "center" | "end" | "between";
  wrap?: boolean;
  class?: string;
  as?: string;
}
const { gap = 3, align = "center", justify = "start", wrap = true, class: className, as = "div" } = Astro.props;
const Tag = as;
const gaps = { 1: "gap-1", 2: "gap-2", 3: "gap-3", 4: "gap-4", 6: "gap-6", 8: "gap-8" };
const alignment = { start: "items-start", center: "items-center", end: "items-end", baseline: "items-baseline" };
const distribution = { start: "justify-start", center: "justify-center", end: "justify-end", between: "justify-between" };
---

<Tag class:list={["flex", gaps[gap], alignment[align], distribution[justify], wrap && "flex-wrap", className]}><slot /></Tag>
