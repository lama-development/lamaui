---
interface Props { columns?:1|2|3|4; gap?:2|3|4|6|8; class?:string; as?:string }
const {columns=3,gap=4,class:className,as='div'}=Astro.props; const Tag=as; const cols={1:'grid-cols-1',2:'grid-cols-1 sm:grid-cols-2',3:'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',4:'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4'};
---
<Tag class:list={['grid',cols[columns],`gap-${gap}`,className]}><slot /></Tag>
