---
interface Props {
  gap?: 1 | 2 | 3 | 4 | 5 | 6 | 8 | 10 | 12;
  align?: "start" | "center" | "end" | "stretch";
  class?: string;
  as?: string;
}
const { gap = 4, align = "stretch", class: className, as = "div" } = Astro.props;
const Tag = as;
const gaps = { 1: "gap-1", 2: "gap-2", 3: "gap-3", 4: "gap-4", 5: "gap-5", 6: "gap-6", 8: "gap-8", 10: "gap-10", 12: "gap-12" };
const alignment = { start: "items-start", center: "items-center", end: "items-end", stretch: "items-stretch" };
---

<Tag class:list={["flex flex-col", gaps[gap], alignment[align], className]}><slot /></Tag>
