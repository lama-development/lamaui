---
interface Option {
  value: string;
  label: string;
  description?: string;
  disabled?: boolean;
}
interface Props {
  name: string;
  label: string;
  options: Option[];
  value?: string;
  inline?: boolean;
}
const { name, label, options, value, inline = false } = Astro.props;
---

<fieldset>
  <legend class="lui-label">{label}</legend><div
    class:list={["flex gap-3", inline ? "flex-row flex-wrap" : "flex-col"]}
  >
    {
      options.map((o) => (
        <label class:list={["lui-choice", o.description && "has-description"]}>
          <>
            <input
              type="radio"
              {name}
              value={o.value}
              checked={o.value === value}
              disabled={o.disabled}
              class="lui-choice-control size-5 appearance-none rounded-full border-[5px] border-(--input) bg-(--input) outline outline-1 outline-(--border) checked:bg-(--accent) checked:outline-(--accent)"
            />
            <span>
              <span class="font-semibold">{o.label}</span>
              {o.description && (
                <span class="muted block text-sm">{o.description}</span>
              )}
            </span>
          </>
        </label>
      ))
    }
  </div>
</fieldset>
