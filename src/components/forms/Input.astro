---
import type { HTMLAttributes } from "astro/types";
import { fieldStyles } from "../../lib/styles";
interface Props extends HTMLAttributes<"input"> {
  id?: string;
  type?: HTMLAttributes<"input">["type"];
  invalid?: boolean;
  class?: string;
}
const { type = "text", invalid = false, class: className, ...rest } = Astro.props;
---

<input {...rest} {type} aria-invalid={invalid || undefined} class:list={[fieldStyles, className]} />
