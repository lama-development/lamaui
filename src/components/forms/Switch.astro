---
interface Props {
  label: string;
  description?: string;
  checked?: boolean;
  disabled?: boolean;
  name?: string;
}
const { label, description, checked = false, disabled = false, name } = Astro.props;
---

<label class:list={["lamaui-switch flex items-center justify-between gap-4", disabled ? "cursor-not-allowed opacity-50" : "cursor-pointer"]}><span><span class="block font-semibold">{label}</span>{description && <span class="muted mt-1 block text-[0.9375rem] leading-normal text-muted-label">{description}</span>}</span><span class="relative inline-flex shrink-0"><input type="checkbox" role="switch" {name} {checked} {disabled} class="peer sr-only" /><span class="lamaui-switch-track h-6 w-10 rounded-full bg-outline peer-checked:bg-accent peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ring"></span><span data-switch-thumb class="lamaui-switch-thumb absolute top-0.5 left-0.5 size-5 rounded-full bg-white shadow peer-checked:translate-x-4 peer-checked:bg-accent-label"></span></span></label>
