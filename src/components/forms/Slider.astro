---
interface Props {
  label: string;
  min?: number;
  max?: number;
  value?: number;
  step?: number;
  name?: string;
}
const { label, min = 0, max = 100, value = 50, step = 1, name } = Astro.props;
const progress = ((value - min) / (max - min)) * 100;
---

<label class="lui-slider-field"
  ><span class="lui-slider-label"
    ><span>{label}</span><output data-slider-output>{value}</output></span
  ><input
    type="range"
    {name}
    {min}
    {max}
    {value}
    {step}
    class="lui-slider"
    style={`--slider-progress:${progress}%`}
    data-slider
  /></label
>
