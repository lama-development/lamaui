---
import { fieldStyles } from "@/lib/styles";
interface Props {
  invalid?: boolean;
  rows?: number;
  class?: string;
  [key: string]: any;
}
const { invalid = false, rows = 4, class: className, ...rest } = Astro.props;
---

<textarea {...rest} {rows} aria-invalid={invalid || undefined} class:list={[`${fieldStyles} min-h-28 resize-y`, className]}><slot /></textarea>
