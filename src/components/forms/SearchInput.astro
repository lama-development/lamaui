---
import type { ComponentProps } from "astro/types";
import { svgSearch } from "../../icons/package";
import Input from "./Input.astro";
import Icon from "../ui/Icon.astro";
interface Props extends Omit<ComponentProps<typeof Input>, "type"> {
  label?: string;
  class?: string;
}
const { label = "Search", class: className, ...rest } = Astro.props;
---

<div class:list={["lamaui-input-with-icon relative", className]}><span aria-hidden="true" class="lamaui-input-leading pointer-events-none absolute top-[50%] left-3.25 z-1 grid transform-[translateY(-50%)] place-items-center text-muted-label"><Icon src={svgSearch} size={18} /></span><Input {...rest} type="search" aria-label={label} class="lamaui-search-field" /></div>
