---
import Input from "./Input.astro";
import Icon from "@/components/ui/Icon.astro";
interface Props {
  label?: string;
  class?: string;
  [key: string]: any;
}
const { label = "Search", class: className, ...rest } = Astro.props;
---

<div class:list={["lui-input-with-icon relative", className]}><span aria-hidden="true" class="lui-input-leading pointer-events-none absolute top-[50%] left-3.25 z-1 grid transform-[translateY(-50%)] place-items-center text-muted-label"><Icon name="search" size={18} /></span><Input {...rest} type="search" aria-label={label} class="lui-search-field" /></div>
