---
import Input from './Input.astro';
interface Props { label?:string; class?:string; [key:string]:any }
const {label='Search',class:className,...rest}=Astro.props;
---
<div class:list={['relative',className]}><span aria-hidden="true" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 muted">⌕</span><Input {...rest} type="search" aria-label={label} class="pl-9"/></div>
