---
import { svgEye, svgEyeSlash } from "../../icons/package";
import Input from "./Input.astro";
import Icon from "../ui/Icon.astro";
interface Props {
  label?: string;
  class?: string;
  [key: string]: any;
}
const { label = "Password", class: className, ...rest } = Astro.props;
const disabled = Boolean(rest.disabled);
---

<div class:list={["relative", className]} data-password>
  <Input {...rest} type="password" aria-label={label} class="lamaui-password-field" data-password-input /><button type="button" {disabled} class="lamaui-input-action absolute top-[50%] right-1.5 grid h-8 w-8 transform-[translateY(-50%)] place-items-center rounded-lg border-0 bg-transparent p-0 text-muted-label hover:bg-surface-hover hover:text-label disabled:pointer-events-none disabled:opacity-50 [&>_span]:flex" aria-label="Show password" title="Show password" data-password-toggle><span data-password-show><Icon src={svgEye} size={19} /></span><span data-password-hide hidden><Icon src={svgEyeSlash} size={19} /></span></button>
</div>

<script>
  import "../../scripts/password-input";
</script>
