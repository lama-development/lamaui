---
import Input from "./Input.astro";
import Icon from "@/components/ui/Icon.astro";
interface Props {
  label?: string;
  class?: string;
  [key: string]: any;
}
const { label = "Password", class: className, ...rest } = Astro.props;
---

<div class:list={["relative", className]} data-password>
  <Input
    {...rest}
    type="password"
    aria-label={label}
    class="lui-password-field"
    data-password-input
  /><button
    type="button"
    class="lui-input-action"
    aria-label="Show password"
    title="Show password"
    data-password-toggle><span data-password-show><Icon name="eye" size={19}/></span><span data-password-hide hidden><Icon name="eye-slash" size={19}/></span></button>
</div>
