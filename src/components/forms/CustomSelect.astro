---
import { svgChevronDown, svgCheck } from "../../icons/package";
import { fieldStyles, menuItemStyles, menuStyles } from "../../lib/styles";
import Icon from "../ui/Icon.astro";
import Label from "./Label.astro";
interface Option {
  value: string;
  label: string;
  icon?: string;
  disabled?: boolean;
}
interface Props {
  id: string;
  name: string;
  label: string;
  options: Option[];
  value?: string;
  class?: string;
  placement?: "top" | "bottom";
  help?: string;
  error?: string;
  disabled?: boolean;
}
const { id, name, label, options, value, class: className, placement = "bottom", help, error, disabled = false } = Astro.props;
const selected = options.find((option) => option.value === value && !option.disabled) ?? options.find((option) => !option.disabled);
const unavailable = disabled || !selected;
const messageId = help || error ? `${id}-message` : undefined;
---

<div class:list={["relative", className]} data-select>
  <Label for={`${id}-button`}><span id={`${id}-label`}>{label}</span></Label>
  <button id={`${id}-button`} type="button" disabled={unavailable} class={`${fieldStyles} group flex items-center justify-between text-left`} aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-list`} aria-labelledby={`${id}-label ${id}-value`} aria-describedby={messageId} aria-invalid={error ? "true" : undefined} data-select-trigger>
    <span class="flex min-w-0 items-center gap-2">
      <span data-select-value-icon class="shrink-0" hidden={!selected?.icon}>{selected?.icon && <Icon src={selected.icon} size={18} />}</span>
      <span id={`${id}-value`} data-select-value class="custom-select-value inline-block truncate [&.is-swapping]:-translate-y-1 [&.is-swapping]:opacity-0 [&.is-swapping]:blur-[2px]">{selected?.label ?? "No options available"}</span>
    </span>
    <Icon src={svgChevronDown} size={16} class="custom-select-chevron shrink-0 text-muted-label group-aria-expanded:rotate-180" />
  </button>
  <div data-surface-level="2" data-surface-lift="1" id={`${id}-list`} role="listbox" aria-labelledby={`${id}-label`} class:list={[`${menuStyles} grid max-h-64 w-full min-w-0 gap-1 overflow-y-auto`, placement === "top" ? "bottom-full mb-2" : "top-full mt-2"]} hidden inert data-select-list>
    {
      options.map((option) => (
        <button type="button" role="option" tabindex="-1" aria-selected={option === selected} disabled={option.disabled} data-value={option.value} data-label={option.label} class={`${menuItemStyles} disabled:cursor-not-allowed disabled:opacity-50 aria-selected:bg-accent-subtle aria-selected:text-accent`}>
          {option.icon && (
            <span data-option-icon class="shrink-0">
              <Icon src={option.icon} size={18} />
            </span>
          )}
          <span class="min-w-0 flex-1 truncate">{option.label}</span>
          <span class="text-accent" hidden={option !== selected} data-option-check>
            <Icon src={svgCheck} size={16} />
          </span>
        </button>
      ))
    }
  </div>
  <input type="hidden" {id} {name} value={selected?.value ?? ""} disabled={unavailable} data-select-input />
  {
    (error || help) && (
      <p id={messageId} class:list={["lamaui-help mt-2 mb-0 text-[0.9375rem] leading-normal text-muted-label", error && "lamaui-error text-destructive"]}>
        {error || help}
      </p>
    )
  }
</div>
<script>
  import "../../scripts/custom-select";
</script>
