---
import Label from './Label.astro';
interface Props { id:string; label:string; help?:string; error?:string; required?:boolean; class?:string }
const { id,label,help,error,required=false,class:className }=Astro.props;
const messageId=(help||error)?`${id}-message`:undefined;
---
<div class={className}><Label for={id} {required}>{label}</Label><slot aria-describedby={messageId}/>{(error||help)&&<p id={messageId} class:list={['lui-help',error&&'lui-error']}>{error||help}</p>}</div>
