---
interface Props { id:string; title:string; side?:'left'|'right'; class?:string }
const {id,title,side='right',class:className}=Astro.props;
---
<dialog {id} data-drawer class:list={['fixed inset-y-0 h-dvh max-h-none w-[min(26rem,90vw)] border-0 bg-[var(--surface-elevated)] p-0 text-[var(--foreground)] shadow-[var(--shadow-lg)] backdrop:bg-[var(--overlay)]',side==='right'?'ml-auto mr-0':'ml-0 mr-auto',className]}><div class="flex h-full flex-col"><header class="flex items-center gap-3 border-b border-[var(--border)] p-4"><h2 class="m-0 flex-1 text-lg font-bold">{title}</h2><button type="button" class="lui-control lui-ghost lui-icon" aria-label="Close drawer" data-dialog-close>×</button></header><div class="flex-1 overflow-auto p-5"><slot /></div></div></dialog>
