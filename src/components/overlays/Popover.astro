---
import { controlStyles, menuStyles, outlineStyles } from "@/lib/styles";
interface Props {
  label: string;
  position?: "left" | "right";
  class?: string;
}
const { label, position = "left", class: className } = Astro.props;
---

<details class:list={["lamaui-popover relative inline-block", className]} data-animated-menu><summary class={`${controlStyles} ${outlineStyles} list-none`}>{label}</summary><div data-surface-level="2" data-surface-lift="1" data-origin={position === "right" ? "top-right" : "top-left"} class:list={[`${menuStyles} t-dropdown lamaui-popover-panel top-full mt-2 w-72 max-w-[calc(100vw-4rem)] p-3.5 leading-tight *:first:m-0 *:first:block *:first:leading-[1.25] *:last:mb-0 [&_p]:m-[0.375rem_0_0]`, position === "right" ? "right-0" : "left-0"]}><slot /></div></details>

<script>
  import "@/scripts/details-menu";
</script>
