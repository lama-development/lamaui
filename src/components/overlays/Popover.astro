---
import { controlStyles, menuStyles, outlineStyles } from "@/lib/styles";
interface Props {
  label: string;
  position?: "left" | "right";
  class?: string;
}
const { label, position = "left", class: className } = Astro.props;
---

<details class:list={["lui-popover relative inline-block", className]}><summary class={`${controlStyles} ${outlineStyles} list-none`}>{label}</summary><div class:list={[`${menuStyles} lui-popover-panel top-full mt-2 w-72 p-3.5 leading-tight *:first:m-0 *:first:block *:first:leading-[1.25] *:last:mb-0 [&_p]:m-[0.375rem_0_0]`, position === "right" ? "right-0" : "left-0"]}><slot /></div></details>
