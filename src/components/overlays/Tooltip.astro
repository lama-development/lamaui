---
interface Props {
  text: string;
  position?: "top" | "bottom";
  class?: string;
}
const { text, position = "top", class: className } = Astro.props;
---

<span class:list={["relative inline-flex", className]} data-tooltip data-tooltip-position={position}><slot /><span popover="manual" role="tooltip" aria-hidden="true" class="lamaui-tooltip pointer-events-none fixed inset-auto z-200 m-0 rounded-[0.375rem] border-0 bg-label px-2 py-1 text-xs whitespace-nowrap text-page opacity-0 shadow data-[open=true]:opacity-100"><span data-tooltip-label>{text}</span><span aria-hidden="true" class="absolute left-1/2 size-2 -translate-x-1/2 rotate-45 bg-label" data-tooltip-arrow></span></span></span>
