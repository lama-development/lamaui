---
interface Props {
  text: string;
  position?: "top" | "bottom";
  class?: string;
}
const { text, position = "top", class: className } = Astro.props;
---

<span class:list={["group relative inline-flex", className]}
  ><slot /><span
    role="tooltip"
    class:list={[
      "lui-tooltip pointer-events-none absolute left-1/2 z-50 whitespace-nowrap bg-(--foreground) px-2 py-1 text-xs text-(--background) shadow",
      position === "top" ? "bottom-full mb-2" : "top-full mt-2",
    ]}>{text}</span
  ></span
>
