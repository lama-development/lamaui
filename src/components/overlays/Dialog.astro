---
import { dialogCloseStyles } from "@/lib/styles";
import Icon from "@/components/ui/Icon.astro";
interface Props {
  id: string;
  title: string;
  description?: string;
  size?: "sm" | "md" | "lg";
  class?: string;
}
const { id, title, description, size = "md", class: className } = Astro.props;
const sizes = { sm: "max-w-sm", md: "max-w-lg", lg: "max-w-2xl" };
---

<dialog {id} class:list={["lamaui-dialog fixed inset-0 m-auto w-[calc(100%-2rem)] rounded-2xl border border-outline bg-surface-elevated p-0 text-label shadow-(--shadow-lg) backdrop:bg-overlay", sizes[size], className]}>
  <div class="p-6">
    <header class="mb-5 flex gap-4">
      <div class="flex-1">
        <h2 class="m-0 text-xl font-bold">{title}</h2>{description && <p class="muted mt-1 mb-0 text-muted-label">{description}</p>}
      </div><button type="button" class={dialogCloseStyles} aria-label="Close dialog" data-dialog-close><Icon name="close" size={18} /></button>
    </header><slot />
  </div>
</dialog>
