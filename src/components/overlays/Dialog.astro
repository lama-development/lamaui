---
import { dialogCloseStyles } from "@/lib/styles";
import Icon from "@/components/ui/Icon.astro";
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"dialog"> & {
  id: string;
  title: string;
  description?: string;
  size?: "sm" | "md" | "lg";
  class?: string;
};
const { id, title, description, size = "md", class: className, ...rest } = Astro.props;
const sizes = { sm: "max-w-sm", md: "max-w-lg", lg: "max-w-2xl" };
const titleId = `${id}-title`;
const descriptionId = description ? `${id}-description` : undefined;
---

<dialog {...rest} {id} aria-labelledby={titleId} aria-describedby={descriptionId} data-surface-level="5" data-surface-lift="4" class:list={["lamaui-dialog fixed inset-0 m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] overflow-y-auto overscroll-contain rounded-2xl border border-outline bg-surface-elevated p-0 text-label shadow-(--surface-shadow) backdrop:bg-overlay", sizes[size], className]}>
  <div class="p-6">
    <header class="mb-5 flex gap-4">
      <div class="flex-1">
        <h2 id={titleId} class="m-0 text-xl font-bold">{title}</h2>{
          description && (
            <p id={descriptionId} class="muted mt-1 mb-0 text-muted-label">
              {description}
            </p>
          )
        }
      </div><button type="button" class={dialogCloseStyles} aria-label="Close dialog" data-dialog-close><Icon name="close" size={18} /></button>
    </header><slot />
  </div>
</dialog>
