---
import { toastCloseStyles } from "@/lib/styles";
import Icon from "@/components/ui/Icon.astro";
interface Props {
  id?: string;
  title?: string;
  variant?: "success" | "warning" | "destructive";
  class?: string;
  [key: string]: any;
}
const { id = "lui-toast", title = "Saved", variant = "success", class: className, ...rest } = Astro.props;
---

<div {...rest} {id} role="status" aria-live="polite" class:list={["lui-toast fixed right-4 bottom-4 z-100 hidden w-[min(24rem,calc(100%-2rem))] grid-cols-[1.5rem_minmax(0,1fr)_2rem] items-start gap-x-3 rounded-2xl border border-outline bg-surface-elevated p-4 shadow-(--shadow-lg)", className]} data-toast>
  <span class:list={["lui-toast-icon grid h-6 w-6 place-items-center self-center font-bold", variant === "success" ? "text-success" : variant === "warning" ? "text-warning" : "text-destructive"]}><Icon name={variant === "success" ? "check" : variant === "warning" ? "feedback" : "close"} size={20} /></span><div class="lui-toast-body min-w-0 *:first:leading-[1.35] [&>_div]:mt-0.75 [&>_div]:leading-tight">
    <p class="m-0 font-bold">{title}</p><div class="muted text-sm text-muted-label">
      <slot />
    </div>
  </div><button type="button" class={toastCloseStyles} aria-label="Dismiss" data-toast-close><Icon name="close" size={16} /></button>
</div>
