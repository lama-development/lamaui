---
interface Props {
  label?: string;
  size?: "sm" | "md" | "lg";
  class?: string;
  decorative?: boolean;
}
const { label = "Loading", size = "md", class: className, decorative = false } = Astro.props;
const sizes = {
  sm: "size-4 border-2",
  md: "size-6 border-2",
  lg: "size-10 border-[3px]"
};
---

<span role={decorative ? undefined : "status"} aria-label={decorative ? undefined : label} aria-hidden={decorative || undefined} class:list={["lamaui-spinner inline-block shrink-0 rounded-full border-current border-r-transparent", sizes[size], !decorative && "text-accent", className]}></span>
