---
import { alertCloseStyles } from "@/lib/styles";
import type { Status } from "@/types";
import Icon from "@/components/ui/Icon.astro";
import type { IconName } from "@/components/ui/Icon.astro";
interface Props {
  variant?: Exclude<Status, "neutral">;
  title?: string;
  dismissible?: boolean;
  icon?: IconName;
  color?: string;
  background?: string;
  borderColor?: string;
  class?: string;
}
const { variant = "info", title, dismissible = false, icon, color, background, borderColor, class: className } = Astro.props;
const colors = {
  info: ["var(--info)", "var(--info-subtle)"],
  success: ["var(--success)", "var(--success-subtle)"],
  warning: ["var(--warning)", "var(--warning-subtle)"],
  destructive: ["var(--destructive)", "var(--destructive-subtle)"]
};
const icons = { info: "feedback", success: "check", warning: "warning", destructive: "close" } as const;
const alertStyle = `color:${color ?? colors[variant][0]};background:${background ?? colors[variant][1]};border-color:${borderColor ?? "color-mix(in srgb, currentColor 15%, transparent)"}`;
---

<div role={variant === "destructive" ? "alert" : "status"} class:list={["lamaui-alert grid grid-cols-[1.5rem_minmax(0,1fr)_auto] items-start gap-x-3 rounded-2xl border p-4", className]} style={alertStyle}>
  <span aria-hidden="true" class="lamaui-alert-icon grid h-6 w-6 place-items-center self-center"><Icon name={icon ?? icons[variant]} size={20} /></span><div class="lamaui-alert-body min-w-0 *:first:leading-[1.35] [&>_div]:mt-0.75 [&>_div]:leading-tight">
    {title && <p class="m-0 font-bold">{title}</p>}<div class="text-sm opacity-90">
      <slot />
    </div>
  </div>{
    dismissible && (
      <button type="button" aria-label="Dismiss" class={alertCloseStyles} data-dismiss>
        <Icon name="close" size={16} />
      </button>
    )
  }
</div>
