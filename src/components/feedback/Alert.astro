---
import type { Status } from "@/types";
import Icon from "@/components/ui/Icon.astro";
interface Props {
  variant?: Exclude<Status, "neutral">;
  title?: string;
  dismissible?: boolean;
  class?: string;
}
const {
  variant = "info",
  title,
  dismissible = false,
  class: className,
} = Astro.props;
const styles = {
  info: "bg-(--info-subtle) text-(--info)",
  success: "bg-(--success-subtle) text-(--success)",
  warning: "bg-(--warning-subtle) text-(--warning)",
  destructive: "bg-(--destructive-subtle) text-(--destructive)",
};
const icons = { info: "feedback", success: "check", warning: "feedback", destructive: "close" } as const;
---

<div
  role={variant === "destructive" ? "alert" : "status"}
  class:list={[
    "flex gap-3 rounded-2xl border border-current/15 p-4",
    styles[variant],
    className,
  ]}
>
  <span aria-hidden="true" class="mt-0.5 shrink-0"><Icon name={icons[variant]} size={18} /></span
  ><div class="min-w-0 flex-1">
    {title && <p class="m-0 font-bold">{title}</p>}<div
      class="text-sm opacity-90"
    >
      <slot />
    </div>
  </div>{
    dismissible && (
      <button
        type="button"
        aria-label="Dismiss"
        class="self-start rounded-md px-1 hover:bg-black/5"
        data-dismiss
      >
        <Icon name="close" size={16} />
      </button>
    )
  }
</div>
