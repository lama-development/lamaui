---
import { controlStyles, ghostStyles, iconControlStyles, smallControlStyles } from "@/lib/styles";
import Icon from "@/components/ui/Icon.astro";
interface Link {
  label: string;
  href: string;
  active?: boolean;
}
interface Props {
  brand?: string;
  links?: Link[];
  class?: string;
  menuId?: string;
}
const { brand = "LamaUI", links = [], class: className, menuId = "lamaui-navbar-menu" } = Astro.props;
---

<header data-surface-level="2" data-surface-lift="1" class:list={["relative border-b border-outline bg-surface", className]}>
  <div class="mx-auto flex min-h-16 max-w-(--container) items-center gap-5 px-4">
    <a href="/" class="flex items-center gap-2 font-bold no-underline"><span class="grid size-8 place-items-center rounded-xl bg-accent text-accent-label">L</span>{brand}</a><button class={`${controlStyles} ${ghostStyles} ${iconControlStyles} lamaui-navbar-toggle min-[861px]:hidden! ml-auto`} aria-label="Open navigation" aria-controls={menuId} aria-expanded="false" data-nav-toggle>
      <span data-nav-open-icon><Icon name="menu" /></span>
      <span data-nav-close-icon hidden><Icon name="close" /></span>
    </button><nav id={menuId} class="lamaui-navbar-menu ml-auto flex items-center gap-1 [@media(width<=860px)]:absolute [@media(width<=860px)]:inset-[100%_0_auto] [@media(width<=860px)]:z-30 [@media(width<=860px)]:flex [@media(width<=860px)]:flex-col [@media(width<=860px)]:items-stretch [@media(width<=860px)]:gap-1 [@media(width<=860px)]:border-b [@media(width<=860px)]:border-outline [@media(width<=860px)]:bg-surface [@media(width<=860px)]:p-3 [@media(width<=860px)]:shadow-(--shadow-md) [@media(width<=860px)]:data-[open=false]:hidden [@media(width<=860px)]:[&_.lamaui-control]:justify-start" data-nav-menu data-open="false">
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.active ? "page" : undefined} class={`${controlStyles} ${ghostStyles} ${smallControlStyles} aria-[current=page]:bg-accent-subtle aria-[current=page]:text-accent`}>
            {l.label}
          </a>
        ))
      }<slot />
    </nav>
  </div>
</header>
