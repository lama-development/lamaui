---
import Icon from "@/components/ui/Icon.astro";
interface Link {
  label: string;
  href: string;
  active?: boolean;
}
interface Props {
  brand?: string;
  links?: Link[];
  class?: string;
  menuId?: string;
}
const { brand = "LamaUI", links = [], class: className, menuId = "lui-navbar-menu" } = Astro.props;
---

<header class:list={["relative border-b border-(--border) bg-(--surface)", className]}>
  <div
    class="mx-auto flex min-h-16 max-w-(--container) items-center gap-5 px-4"
  >
    <a href="/" class="flex items-center gap-2 font-bold no-underline"
      ><span
        class="grid size-8 place-items-center rounded-xl bg-(--accent) text-(--accent-foreground)"
        >L</span
      >{brand}</a
    ><button
      class="lui-control lui-ghost lui-icon lui-navbar-toggle ml-auto"
      aria-label="Open navigation"
      aria-controls={menuId}
      aria-expanded="false"
      data-nav-toggle>
      <span data-nav-open-icon><Icon name="menu" /></span>
      <span data-nav-close-icon hidden><Icon name="close" /></span>
    </button
    ><nav id={menuId} class="lui-navbar-menu" data-nav-menu data-open="false">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={l.active ? "page" : undefined}
            class="lui-control lui-ghost lui-sm aria-[current=page]:bg-(--accent-subtle) aria-[current=page]:text-(--accent)"
          >
            {l.label}
          </a>
        ))
      }<slot />
    </nav>
  </div>
</header>
