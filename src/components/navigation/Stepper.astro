---
interface Step { label:string; description?:string }
interface Props { steps:Step[]; current:number }
const {steps,current}=Astro.props;
---
<ol class="m-0 grid list-none gap-3 p-0 sm:grid-cols-[repeat(var(--count),1fr)]" style={`--count:${steps.length}`}>{steps.map((step,i)=><li aria-current={i+1===current?'step':undefined} class="relative flex gap-3"><span class:list={['grid size-8 shrink-0 place-items-center rounded-full border text-sm font-bold',i+1<=current?'border-[var(--accent)] bg-[var(--accent)] text-[var(--accent-foreground)]':'border-[var(--border)] bg-[var(--surface)] muted']}>{i < current - 1 ? '✓' : i + 1}</span><span><span class="block font-semibold">{step.label}</span>{step.description&&<span class="muted block text-sm">{step.description}</span>}</span></li>)}</ol>
