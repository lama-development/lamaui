---
import { controlStyles, ghostStyles, smallControlStyles } from "../../lib/styles";
interface Props {
  current: number;
  total: number;
  href?: string;
  label?: string;
}
const { current, total, href = "?page=", label = "Pagination" } = Astro.props;
const pageCount = Number.isFinite(total) ? Math.max(0, Math.floor(total)) : 0;
const currentPage = Number.isFinite(current) ? Math.min(pageCount, Math.max(1, Math.floor(current))) : 1;
const start = Math.max(2, Math.min(currentPage - 1, pageCount - 4));
const end = Math.min(pageCount - 1, Math.max(currentPage + 1, 5));
const pages: (number | "ellipsis")[] = [];
if (pageCount > 0) pages.push(1);
if (start > 2) pages.push("ellipsis");
for (let page = start; page <= end; page++) pages.push(page);
if (end < pageCount - 1) pages.push("ellipsis");
if (pageCount > 1) pages.push(pageCount);
const styles = `${controlStyles} ${ghostStyles} ${smallControlStyles} min-w-10`;
---

{
  pageCount > 0 && (
    <nav aria-label={label} class="flex flex-wrap items-center gap-1">
      <a href={currentPage > 1 ? `${href}${currentPage - 1}` : undefined} role="link" aria-label="Previous page" aria-disabled={currentPage === 1 || undefined} tabindex={currentPage === 1 ? -1 : undefined} class={styles}>
        ←
      </a>
      {pages.map((page) =>
        page === "ellipsis" ? (
          <span aria-hidden="true" class="grid min-h-10 min-w-6 place-items-center text-muted-label">
            …
          </span>
        ) : (
          <a href={`${href}${page}`} aria-label={`Page ${page}`} aria-current={page === currentPage ? "page" : undefined} class={`${styles} aria-[current=page]:bg-accent aria-[current=page]:text-accent-label`}>
            {page}
          </a>
        )
      )}
      <a href={currentPage < pageCount ? `${href}${currentPage + 1}` : undefined} role="link" aria-label="Next page" aria-disabled={currentPage === pageCount || undefined} tabindex={currentPage === pageCount ? -1 : undefined} class={styles}>
        →
      </a>
    </nav>
  )
}
