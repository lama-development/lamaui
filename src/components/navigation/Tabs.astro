---
interface Tab {
  id: string;
  label: string;
  disabled?: boolean;
}
interface Props {
  tabs: Tab[];
  active?: string;
  id?: string;
  class?: string;
}
const {
  tabs,
  active = tabs[0]?.id,
  id = "tabs",
  class: className,
} = Astro.props;
---

<div data-tabs class={className}>
  <div
    role="tablist"
    aria-label="Tabs"
    class="lui-tabs"
  >
    {
      tabs.map((tab) => (
        <button
          id={`${id}-${tab.id}-tab`}
          type="button"
          role="tab"
          aria-selected={tab.id === active}
          aria-controls={`${id}-${tab.id}-panel`}
          disabled={tab.disabled}
          class="lui-tab"
          data-tab={tab.id}
        >
          {tab.label}
        </button>
      ))
    }
  </div><div class="mt-4"><slot /></div>
</div>
