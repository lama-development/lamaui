---
interface Tab {
  id: string;
  label: string;
  disabled?: boolean;
}
interface Props {
  tabs: Tab[];
  active?: string;
  id?: string;
  label?: string;
  class?: string;
}
const { tabs, active, id = "tabs", label = "Tabs", class: className } = Astro.props;
const selected = tabs.find((tab) => tab.id === active && !tab.disabled)?.id ?? tabs.find((tab) => !tab.disabled)?.id;
---

<div data-tabs class={className}>
  <div class="lamaui-tabs-scroll max-w-full overflow-x-auto">
    <div role="tablist" aria-label={label} data-fluid-hover class="lamaui-tabs relative isolate inline-flex min-w-max gap-1 rounded-lg border border-(--tab-border) bg-(--tab-track) p-1">
      <span class="lamaui-tab-highlight absolute top-1 bottom-1 left-0 z-1 rounded-[calc(var(--radius-lg)-0.25rem)] bg-(--tab-selected)" aria-hidden="true"></span>
      {
        tabs.map((tab) => (
          <button id={`${id}-${tab.id}-tab`} type="button" role="tab" aria-selected={tab.id === selected} aria-controls={`${id}-${tab.id}-panel`} tabindex={tab.id === selected ? 0 : -1} disabled={tab.disabled} class="lamaui-tab relative z-2 min-h-10 shrink-0 rounded-[calc(var(--radius-lg)-0.25rem)] border-0 bg-transparent px-3 py-2 text-sm font-semibold text-(--tab-muted-label) disabled:opacity-[0.4] aria-selected:text-(--tab-label)" data-tab={tab.id}>
            {tab.label}
          </button>
        ))
      }
    </div>
  </div><div class="mt-4"><slot /></div>
</div>

<style>
  .lamaui-tab-highlight {
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px var(--tab-selected-border),
      var(--shadow-sm);
  }
  .lamaui-tabs :global(.lamaui-fluid-hover) {
    position: absolute;
    z-index: 0;
    background: var(--tab-hover);
  }
  .lamaui-tabs :global(.lamaui-fluid-hover[data-visible="true"]) {
    opacity: 1;
  }
  .lamaui-tab:not(:disabled):hover {
    color: var(--tab-label);
  }
  @media (prefers-reduced-motion: reduce) {
    .lamaui-tab:not(:disabled):not([aria-selected="true"]):hover {
      background: var(--tab-hover);
    }
  }
</style>

<script>
  import "../../scripts/tabs";
</script>
