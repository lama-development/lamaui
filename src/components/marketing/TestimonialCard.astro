---
import { cardStyles } from "@/lib/styles";
interface Props {
  quote: string;
  name: string;
  role?: string;
  initials?: string;
  class?: string;
}
const { quote, name, role, initials = "LM", class: className } = Astro.props;
---

<figure data-surface-level="2" data-surface-lift="1" class:list={[`${cardStyles} m-0 p-6`, className]}>
  <blockquote class="m-0 text-lg leading-tight">
    “{quote}”
  </blockquote><figcaption class="mt-5 flex items-center gap-3">
    <span class="grid size-10 place-items-center rounded-full bg-accent text-sm font-bold text-accent-label">{initials}</span><span><strong class="block">{name}</strong>{role && <span class="muted block text-sm text-muted-label">{role}</span>}</span>
  </figcaption>
</figure>
