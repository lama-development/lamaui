---
import { cardStyles, interactiveStyles } from "@/lib/styles";
import Icon, { type IconName } from "@/components/ui/Icon.astro";
interface Props {
  icon?: IconName;
  title: string;
  description: string;
  href?: string;
  class?: string;
}
const { icon, title, description, href, class: className } = Astro.props;
const Tag = href ? "a" : "article";
---

<Tag href={href} class:list={[`${cardStyles} ${interactiveStyles} block p-5 no-underline`, className]}
  >{
    icon && (
      <span class="mb-4 grid size-11 place-items-center rounded-xl bg-accent-subtle text-sm font-bold text-accent" aria-hidden="true">
        <Icon name={icon} />
      </span>
    )
  }
  <h3 class="m-0 text-lg font-semibold">{title}</h3><p class="muted mt-1 mb-0 text-muted-label">
    {description}
  </p></Tag
>
