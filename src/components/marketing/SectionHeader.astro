---
interface Props { eyebrow?:string; title:string; description?:string; align?:'left'|'center'; class?:string }
const {eyebrow,title,description,align='left',class:className}=Astro.props;
---
<header class:list={['max-w-2xl',align==='center'&&'mx-auto text-center',className]}>{eyebrow&&<p class="eyebrow mb-2">{eyebrow}</p>}<h2 class="m-0 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>{description&&<p class="muted mt-3 mb-0 text-lg">{description}</p>}</header>
