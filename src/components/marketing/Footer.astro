---
interface Props { brand?:string; description?:string; class?:string }
const {brand='LamaUI',description='A calm, tactile design system for Astro.',class:className}=Astro.props;
---
<footer class:list={['border-t border-[var(--border)] bg-[var(--surface)] py-10',className]}><div class="mx-auto flex max-w-[var(--container)] flex-col gap-4 px-4 sm:flex-row sm:items-end"><div><p class="m-0 font-bold">{brand}</p><p class="muted mt-1 mb-0 text-sm">{description}</p></div><div class="muted text-sm sm:ml-auto"><slot /> © {new Date().getFullYear()}</div></div></footer>
