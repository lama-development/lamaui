---
interface Props { name:string; price:string; period?:string; description?:string; features:string[]; featured?:boolean; class?:string }
const {name,price,period='/month',description,features,featured=false,class:className}=Astro.props;
---
<article class:list={['lui-card relative flex flex-col p-6',featured&&'border-[var(--accent)] shadow-[var(--shadow-md)]',className]}>{featured&&<span class="absolute right-4 top-4 rounded-full bg-[var(--accent-subtle)] px-2 py-1 text-xs font-bold text-[var(--accent)]">Popular</span>}<h3 class="m-0 text-lg font-bold">{name}</h3>{description&&<p class="muted mt-1 mb-4 text-sm">{description}</p>}<p class="my-3"><span class="text-4xl font-bold">{price}</span><span class="muted text-sm"> {period}</span></p><ul class="my-5 flex-1 space-y-2 pl-0">{features.map(f=><li class="flex gap-2 text-sm"><span class="text-[var(--accent)]">✓</span>{f}</li>)}</ul><slot /></article>
