---
import { cardStyles } from "@/lib/styles";
import Icon, { type IconName } from "@/components/ui/Icon.astro";
interface Props {
  title: string;
  description: string;
  icon?: IconName;
  class?: string;
}
const { title, description, icon = "data", class: className } = Astro.props;
---

<div class:list={[`${cardStyles} flex flex-col items-center p-8 text-center`, className]}>
  <span class="mb-4 grid size-12 place-items-center rounded-xl bg-accent-subtle text-xl text-accent" aria-hidden="true"><Icon name={icon} /></span><h3 class="m-0 text-lg font-bold">{title}</h3><p class="muted mt-1 mb-5 max-w-md text-muted-label">
    {description}
  </p><slot />
</div>
