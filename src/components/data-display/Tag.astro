---
interface Props {
  removable?: boolean;
  removeLabel?: string;
  class?: string;
}
const { removable = false, removeLabel = "Remove", class: className } = Astro.props;
---

<span data-tag data-surface-level="2" data-surface-lift="1" class:list={["inline-flex min-h-8 items-center gap-1 rounded-xl border border-outline bg-surface px-2.5 text-sm font-semibold", className]}
  ><slot />{
    removable && (
      <button type="button" data-tag-remove aria-label={removeLabel} class="-mr-1 grid size-5 place-items-center rounded-md hover:bg-muted">
        ×
      </button>
    )
  }</span
>

<script>
  // Delegate so tags restored by a preview reset keep their removal behavior.
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest("[data-tag-remove]");
    button?.closest("[data-tag]")?.remove();
  });
</script>
