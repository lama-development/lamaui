---
import type { Status } from '@/types';
interface Props { variant?:Status; dot?:boolean; class?:string }
const {variant='neutral',dot=false,class:className}=Astro.props;
const styles={neutral:'bg-[var(--muted)] text-[var(--muted-foreground)]',info:'bg-[var(--info-subtle)] text-[var(--info)]',success:'bg-[var(--success-subtle)] text-[var(--success)]',warning:'bg-[var(--warning-subtle)] text-[var(--warning)]',destructive:'bg-[var(--destructive-subtle)] text-[var(--destructive)]'};
---
<span class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-bold',styles[variant],className]}>{dot&&<span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>}<slot /></span>
