---
import { cardStyles, interactiveStyles } from "@/lib/styles";
interface Props {
  title?: string;
  description?: string;
  padding?: "sm" | "md" | "lg";
  interactive?: boolean;
  class?: string;
}
const { title, description, padding = "md", interactive = false, class: className } = Astro.props;
const pads = { sm: "p-4", md: "p-5", lg: "p-7" };
---

<article data-surface-level="2" data-surface-lift="1" class:list={[cardStyles, pads[padding], interactive && interactiveStyles, className]}>
  {
    (title || description) && (
      <header class="mb-4">
        {title && <h3 class="m-0 text-lg leading-tight font-semibold">{title}</h3>}
        {description && <p class="muted mt-1 mb-0 text-sm text-muted-label">{description}</p>}
      </header>
    )
  }<slot />
</article>
