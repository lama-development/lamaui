---
import { cardStyles } from "@/lib/styles";
interface Props {
  label: string;
  value: string;
  change?: string;
  trend?: "up" | "down" | "neutral";
  class?: string;
}
const { label, value, change, trend = "neutral", class: className } = Astro.props;
---

<div data-surface-level="2" data-surface-lift="1" class:list={[`${cardStyles} p-5`, className]}>
  <p class="muted m-0 text-sm font-semibold text-muted-label">{label}</p><p class="my-1 text-3xl font-bold tracking-tight">
    {value}
  </p>{
    change && (
      <p class:list={["m-0 text-sm", trend === "up" ? "text-success" : trend === "down" ? "text-destructive" : "muted text-muted-label"]}>
        {trend === "up" ? "↗" : trend === "down" ? "↘" : "→"} {change}
      </p>
    )
  }
</div>
