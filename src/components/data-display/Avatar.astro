---
interface Props {
  src?: string;
  alt?: string;
  initials?: string;
  size?: "sm" | "md" | "lg";
  status?: "online" | "offline";
  class?: string;
}
const {
  src,
  alt = "",
  initials = "LA",
  size = "md",
  status,
  class: className,
} = Astro.props;
const sizes = {
  sm: "size-8 text-xs",
  md: "size-10 text-sm",
  lg: "size-12 text-base",
};
---

<span
  class:list={[
    "relative inline-grid shrink-0 place-items-center rounded-full bg-(--primary) font-bold text-(--primary-foreground) ring-2 ring-(--surface)",
    sizes[size],
    className,
  ]}
  >{
    src ? (
      <img {src} {alt} class="size-full rounded-full object-cover" />
    ) : (
      <span aria-label={alt}>{initials}</span>
    )
  }{
    status && (
      <span
        title={status}
        class:list={[
          "absolute bottom-0 right-0 size-2.5 rounded-full ring-2 ring-(--surface)",
          status === "online" ? "bg-(--success)" : "bg-(--muted-foreground)",
        ]}
      />
    )
  }</span
>
