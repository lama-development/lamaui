---
import { codeToHtml } from "shiki";
import Icon from "@/components/ui/Icon.astro";
interface Props { code: string; language?: string; label?: string }
const { code, language = "astro", label = language } = Astro.props;
const highlighted = await codeToHtml(code, {
  lang: language as any,
  themes: { light: "github-light", dark: "github-dark" },
  defaultColor: false,
});
---
<figure class="code-block" data-code-block>
  <figcaption class="code-toolbar">
    <span>{label}</span>
    <button type="button" class="code-copy" aria-label="Copy code" data-copy-code>
      <span data-copy-default><Icon name="copy" size={16} /></span>
      <span data-copy-success hidden><Icon name="check" size={16} /></span>
      <span data-copy-label>Copy</span>
    </button>
  </figcaption>
  <div class="code-render" set:html={highlighted}></div>
</figure>
