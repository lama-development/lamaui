---
import { codeToHtml } from "shiki";
import Icon from "@/components/ui/Icon.astro";
interface Props { code: string; language?: string; label?: string }
const { code, language = "astro", label = language } = Astro.props;
const highlighted = await codeToHtml(code, {
  lang: language as any,
  themes: { light: "github-light", dark: "github-dark" },
  defaultColor: false,
});
---
<figure class="code-block" data-code-block>
  <figcaption class="code-head">
    <span class="code-language"><Icon name="code" size={20} /><span>{label}</span></span>
    <span class="code-actions">
      <button type="button" class="code-action" aria-label="Wrap lines" aria-pressed="false" title="Wrap lines" data-code-wrap><Icon name="wrap" size={20} /></button>
      <button type="button" class="code-action code-copy" aria-label="Copy code" title="Copy code" data-copy-code>
        <span data-copy-default><Icon name="copy" size={20} /></span>
        <span data-copy-success hidden><Icon name="check" size={20} /></span>
        <span class="sr-only" data-copy-label>Copy</span>
      </button>
    </span>
  </figcaption>
  <div class="code-render" set:html={highlighted}></div>
</figure>
