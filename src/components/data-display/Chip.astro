---
import type { Status } from "@/types";
interface Props {
  variant?: Status | "accent";
  dot?: boolean;
  class?: string;
}
const { variant = "neutral", dot = false, class: className } = Astro.props;
const styles = {
  accent: "bg-accent-subtle text-accent",
  neutral: "bg-muted text-muted-label",
  info: "bg-info-subtle text-info",
  success: "bg-success-subtle text-success",
  warning: "bg-warning-subtle text-warning",
  destructive: "bg-destructive-subtle text-destructive"
};
---

<span class:list={["inline-flex items-center gap-1.5 rounded-full border border-current/20 px-2.5 py-1 text-xs font-bold", styles[variant], className]}>{dot && <span class="size-1.5 rounded-full bg-current" aria-hidden="true" />}<slot /></span>
