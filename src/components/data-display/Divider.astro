---
interface Props {
  label?: string;
  vertical?: boolean;
  class?: string;
}
const { label, vertical = false, class: className } = Astro.props;
---

{
  vertical ? (
    <span role="separator" aria-orientation="vertical" class:list={["mx-2 block self-stretch border-l border-outline", className]} />
  ) : (
    <div role="separator" class:list={["flex items-center gap-3", className]}>
      <span class="h-px flex-1 bg-outline" />
      {label && <span class="muted text-xs font-semibold tracking-wider text-muted-label uppercase">{label}</span>}
      {label && <span class="h-px flex-1 bg-outline" />}
    </div>
  )
}
