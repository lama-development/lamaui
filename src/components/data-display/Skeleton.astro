---
interface Props { width?:string; height?:string; radius?:string; class?:string }
const {width='100%',height='1rem',radius='var(--radius-sm)',class:className}=Astro.props;
---
<span aria-hidden="true" class:list={['block animate-pulse bg-[var(--muted)]',className]} style={`width:${width};height:${height};border-radius:${radius}`}></span>
