---
import { accentPresets } from "@/lib/accents";
import { controlStyles, ghostStyles, iconControlStyles } from "@/lib/styles";
interface Props {
  id?: string;
}
const { id = "accent-picker" } = Astro.props;
---

<div class="lamaui-accent-picker relative flex-none rounded-lg border border-outline bg-surface p-1 [corner-shape:squircle]" data-accent-picker>
  <button type="button" class={`${controlStyles} ${ghostStyles} ${iconControlStyles} rounded-[calc(var(--radius-lg)-0.3125rem)]`} aria-label="Choose accent color, current: Lime" title="Accent color: Lime" aria-expanded="false" aria-controls={`${id}-colors`} data-accent-trigger>
    <span class="size-5 rounded-full border border-black/10 bg-accent" aria-hidden="true"></span>
  </button>
  <div id={`${id}-colors`} class="lamaui-accent-dock absolute right-0 bottom-[calc(100%+0.5rem)] z-10 flex w-max flex-col gap-1 rounded-lg border border-outline bg-surface-elevated p-1 shadow-(--shadow-md) [corner-shape:squircle]" role="group" aria-label="Accent color" inert data-accent-dock>
    {
      accentPresets.map((preset, index) => (
        <button type="button" class="lamaui-accent-choice relative flex size-(--control-md) flex-none cursor-pointer items-center justify-center rounded-[calc(var(--radius-lg)-0.3125rem)] border border-transparent bg-transparent [corner-shape:squircle] hover:bg-surface-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" style={`--swatch-index:${index}`} aria-label={`${preset.label} accent`} aria-pressed={preset.value === "lime"} data-accent-choice={preset.value}>
          <span class="lamaui-accent-swatch block size-5 rounded-full border border-black/10 shadow-(--shadow-sm)" style={`background: light-dark(${preset.light}, ${preset.dark})`} aria-hidden="true" />
        </button>
      ))
    }
  </div>
</div>
<script>
  import { accentPresets } from "@/lib/accents";
  const validAccent = (value: string | null) => accentPresets.some((preset) => preset.value === value);
  const syncAccent = (value: string | null) => {
    const accent = validAccent(value) ? value! : "lime";
    document.documentElement.dataset.accent = accent;
    document.querySelectorAll<HTMLButtonElement>("[data-accent-choice]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.accentChoice === accent));
    });
    const preset = accentPresets.find((preset) => preset.value === accent)!;
    document.querySelectorAll<HTMLButtonElement>("[data-accent-trigger]").forEach((button) => {
      button.setAttribute("aria-label", `Choose accent color, current: ${preset.label}`);
      button.title = `Accent color: ${preset.label}`;
    });
  };
  let savedAccent: string | null = null;
  try {
    savedAccent = localStorage.getItem("lamaui-accent");
  } catch {}
  syncAccent(savedAccent);
  document.querySelectorAll<HTMLElement>("[data-accent-picker]").forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>("[data-accent-trigger]")!;
    const dock = root.querySelector<HTMLElement>("[data-accent-dock]")!;
    const choices = Array.from(dock.querySelectorAll<HTMLButtonElement>("[data-accent-choice]"));
    const setOpen = (open: boolean, restoreFocus = false) => {
      trigger.setAttribute("aria-expanded", String(open));
      root.dataset.open = String(open);
      dock.inert = !open;
      if (restoreFocus) trigger.focus();
    };
    const openWithFocus = () => {
      setOpen(true);
      (choices.find((button) => button.getAttribute("aria-pressed") === "true") ?? choices[0]).focus();
    };
    trigger.addEventListener("click", () => {
      if (root.dataset.open === "true") setOpen(false);
      else openWithFocus();
    });
    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && root.dataset.open === "true") {
        event.preventDefault();
        event.stopPropagation();
        setOpen(false, true);
      } else if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
        event.preventDefault();
        if (root.dataset.open !== "true") return openWithFocus();
        const index = choices.indexOf(document.activeElement as HTMLButtonElement);
        const step = event.key === "ArrowDown" || event.key === "ArrowRight" ? 1 : -1;
        const next = event.key === "Home" ? 0 : event.key === "End" ? choices.length - 1 : (index + step + choices.length) % choices.length;
        choices[next].focus();
      }
    });
    choices.forEach((button) => button.addEventListener("click", () => setOpen(false, true)));
    document.addEventListener("pointerdown", (event) => {
      if (!root.contains(event.target as Node)) setOpen(false);
    });
    root.addEventListener("focusout", (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-accent-choice]").forEach((button) => {
    button.addEventListener("click", () => {
      const accent = button.dataset.accentChoice!;
      syncAccent(accent);
      try {
        localStorage.setItem("lamaui-accent", accent);
      } catch {}
    });
  });
  window.addEventListener("storage", (event) => {
    if (event.key === "lamaui-accent" || event.key === null) syncAccent(event.newValue);
  });
</script>

<style>
  .lamaui-accent-dock {
    visibility: hidden;
    opacity: 0;
    transform: translateY(0.5rem) scaleY(0.72);
    transform-origin: bottom center;
  }
  [data-open="true"] .lamaui-accent-dock {
    visibility: visible;
    opacity: 1;
    transform: translateY(0) scaleY(1);
  }
  .lamaui-accent-choice {
    opacity: 0;
    transform: translateY(0.5rem) scale(0.9);
  }
  [data-open="true"] .lamaui-accent-choice {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  [aria-pressed="true"] .lamaui-accent-swatch {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
