---
export type IconName = "menu" | "close" | "sun" | "moon" | "chevron-right" | "chevron-down" | "copy" | "plus" | "heart" | "more" | "pin" | "home" | "actions" | "forms" | "navigation" | "data" | "feedback" | "overlays" | "layout" | "marketing" | "check" | "user" | "settings" | "search" | "mail" | "code" | "external";
interface Props { name: IconName; size?: number; class?: string; [key: string]: any }
const { name, size = 20, class: className, ...rest } = Astro.props;
---
<svg {...rest} class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "menu" && <><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></>}
  {name === "close" && <><path d="m6 6 12 12"/><path d="M18 6 6 18"/></>}
  {name === "sun" && <><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></>}
  {name === "moon" && <path d="M20 15.6A8.5 8.5 0 0 1 8.4 4 8.5 8.5 0 1 0 20 15.6Z"/>}
  {name === "chevron-right" && <path d="m9 18 6-6-6-6"/>}
  {name === "chevron-down" && <path d="m6 9 6 6 6-6"/>}
  {name === "copy" && <><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></>}
  {name === "plus" && <><path d="M12 5v14"/><path d="M5 12h14"/></>}
  {name === "heart" && <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/>}
  {name === "more" && <><circle cx="5" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1" fill="currentColor" stroke="none"/></>}
  {name === "pin" && <><path d="m15 4 5 5-3 1-4 4-1 5-2-2-2-2 5-1 4-4Z"/><path d="m9 15-5 5"/></>}
  {name === "home" && <><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9"/><path d="M9 20v-6h6v6"/></>}
  {name === "actions" && <><path d="M4 7h10"/><path d="M4 12h16"/><path d="M4 17h7"/><circle cx="17" cy="7" r="2"/><circle cx="14" cy="17" r="2"/></>}
  {name === "forms" && <><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h4"/></>}
  {name === "navigation" && <><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5Z"/></>}
  {name === "data" && <><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/></>}
  {name === "feedback" && <><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"/><path d="M8 9h8M8 13h5"/></>}
  {name === "overlays" && <><rect x="3" y="5" width="14" height="14" rx="2"/><path d="M8 5V3h11a2 2 0 0 1 2 2v11h-4"/></>}
  {name === "layout" && <><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M9 10h12"/></>}
  {name === "marketing" && <><path d="M3 11v2a2 2 0 0 0 2 2h2l3 5h3l-2-5 8-4V5l-12 6Z"/><path d="M19 8h2"/></>}
  {name === "check" && <path d="m5 12 4 4 10-10"/>}
  {name === "user" && <><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></>}
  {name === "settings" && <><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.03 1.56V21h-4v-.09A1.7 1.7 0 0 0 8.94 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15 1.7 1.7 0 0 0 3.09 14H3v-4h.09A1.7 1.7 0 0 0 4.6 8.94a1.7 1.7 0 0 0-.34-1.88L4.2 7l2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6 1.7 1.7 0 0 0 10 3.09V3h4v.09A1.7 1.7 0 0 0 15.06 4.6a1.7 1.7 0 0 0 1.88-.34L17 4.2 19.83 7l-.06.06A1.7 1.7 0 0 0 19.4 9 1.7 1.7 0 0 0 20.91 10H21v4h-.09A1.7 1.7 0 0 0 19.4 15Z"/></>}
  {name === "search" && <><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></>}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></>}
  {name === "code" && <><path d="m8 9-3 3 3 3M16 9l3 3-3 3M14 5l-4 14"/></>}
  {name === "external" && <><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/></>}
</svg>
