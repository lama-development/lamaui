---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"svg">, "set:html"> {
  src: string;
  size?: number;
  class?: string;
}
const { src, size = 20, class: className, ...rest } = Astro.props;
const svg = src.match(/<svg\b([^>]*)>([\s\S]*?)<\/svg>/i);
if (!svg) throw new Error("Icon src must be SVG markup. Import an SVG with ?raw.");
const attributes = Object.fromEntries(Array.from(svg[1].matchAll(/([:\w-]+)\s*=\s*(["'])(.*?)\2/gs), (match) => [match[1], match[3]]));
---

<svg fill="currentColor" {...attributes} {...rest} class:list={["lamaui-icon-svg block flex-none", className]} width={size} height={size} viewBox={attributes.viewBox ?? "0 0 256 256"} aria-hidden="true" set:html={svg[2]} />
