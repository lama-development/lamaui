---
import { controlStyles, outlineStyles } from "@/lib/styles";
interface Props {
  pressed?: boolean;
  label?: string;
  disabled?: boolean;
  class?: string;
}
const { pressed = false, label, disabled = false, class: className } = Astro.props;
---

<button type="button" aria-pressed={pressed} {disabled} aria-label={label} data-toggle class:list={[`${controlStyles} ${outlineStyles} [&.lui-outline[aria-pressed=true]]:border-accent/20 aria-pressed:bg-accent-subtle aria-pressed:text-accent`, className]}><slot /></button>
