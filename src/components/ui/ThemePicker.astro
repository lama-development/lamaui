---
import { controlStyles, ghostStyles, iconControlStyles } from "@/lib/styles";
import Icon from "@/components/ui/Icon.astro";
import Tooltip from "@/components/overlays/Tooltip.astro";
interface Props {
  label?: string;
  class?: string;
}
const { label = "Color theme", class: className } = Astro.props;
const options = [
  { value: "system", label: "System", icon: "system" as const },
  { value: "light", label: "Light", icon: "sun" as const },
  { value: "dark", label: "Dark", icon: "moon" as const }
];
---

<div class:list={["lamaui-theme-picker min-w-0", className]} data-theme-picker>
  <div data-surface-level="2" data-surface-lift="1" class="lamaui-theme-icons lamaui-surface relative isolate inline-flex gap-1 rounded-lg border border-outline p-1 [corner-shape:squircle]" role="group" data-fluid-hover aria-label={label}>
    <span class="t-tabs-pill" aria-hidden="true"></span>
    {
      options.map((option) => (
        <Tooltip text={option.label}>
          <button type="button" class={`${controlStyles} ${ghostStyles} ${iconControlStyles} relative z-1 rounded-[calc(var(--radius-lg)-0.3125rem)] hover:text-label aria-pressed:text-accent aria-pressed:hover:bg-transparent aria-pressed:hover:text-accent`} aria-label={option.label} aria-pressed={option.value === "system"} data-theme-choice={option.value}>
            <Icon name={option.icon} />
          </button>
        </Tooltip>
      ))
    }
  </div>
</div>
<script>
  type Theme = "system" | "light" | "dark";
  const isTheme = (value: unknown): value is Theme => value === "system" || value === "light" || value === "dark";
  let theme: Theme = "system";
  try {
    const stored = localStorage.getItem("lamaui-theme");
    if (isTheme(stored)) theme = stored;
  } catch {}
  const moveHighlight = (root: HTMLElement, animate: boolean) => {
    const pill = root.querySelector<HTMLElement>(".t-tabs-pill");
    const active = root.querySelector<HTMLButtonElement>('[data-theme-choice][aria-pressed="true"]');
    if (!pill || !active) return;
    const previous = pill.style.transition;
    if (!animate) pill.style.transition = "none";
    const tooltip = active.closest<HTMLElement>("[data-tooltip]");
    pill.style.transform = `translateX(${tooltip?.offsetLeft ?? active.offsetLeft}px)`;
    pill.style.width = `${active.offsetWidth}px`;
    if (!animate) {
      void pill.offsetWidth;
      pill.style.transition = previous;
    }
  };
  const sync = (animate = true) => {
    if (theme === "system") delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = theme;
    document.querySelectorAll<HTMLElement>("[data-theme-picker]").forEach((root) => {
      root.querySelectorAll<HTMLButtonElement>("[data-theme-choice]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.themeChoice === theme)));
      moveHighlight(root, animate);
    });
  };
  const cssTimeToMilliseconds = (value: string) => {
    const match = value.trim().match(/^([\d.]+)(ms|s)$/);
    if (!match) return 0;
    return Number(match[1]) * (match[2] === "s" ? 1000 : 1);
  };
  let activeTransition: ViewTransition | undefined;
  let latestRequest = 0;
  const revealWithoutViewTransition = async (update: () => void, origin: HTMLElement) => {
    const bounds = origin.getBoundingClientRect();
    const x = bounds.left + bounds.width / 2;
    const y = bounds.top + bounds.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const reveal = document.createElement("span");
    reveal.className = "lamaui-theme-circle";
    reveal.style.left = `${x}px`;
    reveal.style.top = `${y}px`;
    reveal.style.background = getComputedStyle(document.querySelector(".docs-sidebar") ?? document.body).backgroundColor;
    document.body.append(reveal);
    const animation = reveal.animate([{ transform: "translate(-50%, -50%) scale(0)" }, { transform: `translate(-50%, -50%) scale(${radius})` }], {
      duration: 400,
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fill: "forwards"
    });
    try {
      await animation.finished;
    } catch {}
    update();
    reveal.style.background = getComputedStyle(document.querySelector(".docs-sidebar") ?? document.body).backgroundColor;
    const fade = reveal.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 150, easing: "ease-out", fill: "forwards" });
    try {
      await fade.finished;
    } catch {}
    reveal.remove();
  };
  const apply = async (value: unknown, origin: HTMLElement) => {
    if (!isTheme(value)) return;
    const request = ++latestRequest;
    activeTransition?.skipTransition();
    if (activeTransition) await activeTransition.finished;
    if (request !== latestRequest || value === theme) return;
    const update = () => {
      theme = value;
      try {
        localStorage.setItem("lamaui-theme", theme);
      } catch {}
      sync();
    };
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const nextScheme = value === "system" ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : value;
    if (reducedMotion.matches || getComputedStyle(document.documentElement).colorScheme === nextScheme) {
      update();
      return;
    }
    if (!document.startViewTransition) {
      await revealWithoutViewTransition(() => {
        if (request === latestRequest) update();
      }, origin);
      return;
    }
    const bounds = origin.getBoundingClientRect();
    const x = bounds.left + bounds.width / 2;
    const y = bounds.top + bounds.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const styles = getComputedStyle(document.documentElement);
    const duration = cssTimeToMilliseconds(styles.getPropertyValue("--duration-slow"));
    document.documentElement.classList.add("theme-reveal");
    const transition = document.startViewTransition(update);
    activeTransition = transition;
    const stopMotion = () => {
      if (reducedMotion.matches) transition.skipTransition();
    };
    reducedMotion.addEventListener("change", stopMotion);
    try {
      await transition.ready;
      document.documentElement.animate(
        {
          clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`]
        },
        {
          duration,
          easing: styles.getPropertyValue("--ease-standard").trim(),
          pseudoElement: "::view-transition-new(root)"
        }
      );
    } catch {
      // A skipped transition still applies the chosen theme.
    } finally {
      await transition.finished;
      reducedMotion.removeEventListener("change", stopMotion);
      if (activeTransition === transition) {
        activeTransition = undefined;
        document.documentElement.classList.remove("theme-reveal");
      }
    }
  };
  document.querySelectorAll<HTMLElement>("[data-theme-picker]").forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>("[data-theme-choice]").forEach((button) =>
      button.addEventListener("click", () => {
        void apply(button.dataset.themeChoice, button);
      })
    );
  });
  window.addEventListener("storage", (event) => {
    if (event.key === "lamaui-theme" || event.key === null) {
      latestRequest++;
      activeTransition?.skipTransition();
      theme = isTheme(event.newValue) ? event.newValue : "system";
      sync();
    }
  });
  sync(false);
  window.addEventListener("resize", () => {
    document.querySelectorAll<HTMLElement>("[data-theme-picker]").forEach((root) => moveHighlight(root, false));
  });
</script>

<style>
  :global(.lamaui-theme-circle) {
    position: fixed;
    z-index: 2147483647;
    width: 2px;
    height: 2px;
    border-radius: 999px;
    pointer-events: none;
  }
  .t-tabs-pill {
    position: absolute;
    top: 3px;
    left: 0;
    height: 30px;
    width: 0;
    background: var(--tabs-pill-bg);
    border-radius: 48px;
    transform: translateX(0);
    z-index: 0;
    pointer-events: none;
  }
  .lamaui-theme-icons {
    --tabs-pill-bg: var(--accent-subtle);
  }
  .lamaui-theme-icons .t-tabs-pill {
    top: 4px;
    height: var(--control-md);
    border-radius: calc(var(--radius-lg) - 0.3125rem);
    corner-shape: squircle;
  }
</style>
