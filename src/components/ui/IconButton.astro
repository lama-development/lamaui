---
import Button from './Button.astro';
import type { Variant } from '@/types';
interface Props { label:string; variant?:Variant; type?:'button'|'submit'|'reset'; disabled?:boolean; class?:string; [key:string]:any }
const { label, variant='ghost', class:className, ...rest } = Astro.props;
---
<Button {...rest} {variant} class:list={['lui-icon',className]} aria-label={label}><slot /></Button>
