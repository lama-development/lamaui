---
interface Props {
  label: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---

<div role="group" aria-label={label} data-fluid-hover class:list={["inline-flex max-w-full min-w-0 [&_.lamaui-control]:-ml-px [&_.lamaui-control]:min-w-0! [&_.lamaui-control]:flex-auto [&_.lamaui-control]:rounded-none [&_.lamaui-control]:whitespace-nowrap [&_.lamaui-control:first-child]:ml-0 [&_.lamaui-control:first-child]:rounded-l-xl [&_.lamaui-control:last-child]:rounded-r-xl", className]}><slot /></div>
