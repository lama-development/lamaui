---
import Button from "@/components/ui/Button.astro";
import Icon, { type IconName } from "@/components/ui/Icon.astro";
import { controlStyles, iconControlStyles, menuItemStyles, menuStyles, primaryStyles, secondaryStyles } from "@/lib/styles";
import { cx } from "@/lib/classes";
import type { Variant } from "@/types";

export interface SplitButtonOption {
  label: string;
  href?: string;
  download?: boolean | string;
  icon?: IconName;
  attributes?: Record<string, any>;
}

interface Props {
  label: string;
  options: SplitButtonOption[];
  href?: string;
  download?: boolean | string;
  icon?: IconName;
  variant?: Extract<Variant, "primary" | "secondary">;
  menuLabel?: string;
  class?: string;
  [key: string]: any;
}

const { label, options, href, download, icon, variant = "primary", menuLabel = `More ${label} options`, class: className, ...rest } = Astro.props;
const variantStyles = variant === "primary" ? primaryStyles : secondaryStyles;
---

<div class:list={["lui-split-button relative inline-flex items-stretch", className]} data-split-button>
  <Button {...rest} {variant} {href} {download} {icon} class="flex-1 rounded-r-none">{label}</Button>
  <details class="group -ml-px" data-split-menu>
    <summary class={cx(controlStyles, variantStyles, iconControlStyles, "lui-split-trigger h-full list-none rounded-l-none [&::-webkit-details-marker]:hidden")} aria-label={menuLabel} title={menuLabel}>
      <Icon name="chevron-down" size={16} class="transition-transform group-open:rotate-180" />
    </summary>
    <div class={cx(menuStyles, "right-0 mt-2 grid w-full min-w-52 gap-0.5")}>
      {
        options.map((option) =>
          option.href ? (
            <a {...option.attributes} href={option.href} download={option.download} class={menuItemStyles}>
              {option.icon && <Icon name={option.icon} size={18} />}
              <span>{option.label}</span>
            </a>
          ) : (
            <button {...option.attributes} type="button" class={cx(menuItemStyles, "border-0 bg-transparent font-[inherit]")}>
              {option.icon && <Icon name={option.icon} size={18} />}
              <span>{option.label}</span>
            </button>
          )
        )
      }
    </div>
  </details>
</div>

<style>
  .lui-split-trigger {
    border-left-color: color-mix(in srgb, currentColor 28%, transparent);
    background-image: linear-gradient(color-mix(in srgb, currentColor 6%, transparent), color-mix(in srgb, currentColor 6%, transparent));
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-split-button]").forEach((root) => {
    const details = root.querySelector<HTMLDetailsElement>("[data-split-menu]");
    root.querySelectorAll("a, button").forEach((item) => item.addEventListener("click", () => window.setTimeout(() => details?.removeAttribute("open"))));
    document.addEventListener("pointerdown", (event) => {
      if (!root.contains(event.target as Node)) details?.removeAttribute("open");
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") details?.removeAttribute("open");
    });
  });
</script>
