---
import SplitButton from "@/components/ui/SplitButton.astro";
---

<div class="hidden shrink-0 items-center justify-end min-[621px]:flex print:hidden">
  <SplitButton
    label="Download PDF"
    icon="file-pdf"
    class="w-64"
    data-guide-pdf
    options={[
      { label: "Download Markdown", icon: "file-md", attributes: { "data-guide-download": true } },
      { label: "Copy as text", icon: "clipboard-text", attributes: { "data-guide-copy": true } },
      { label: "Copy link", icon: "link", attributes: { "data-guide-copy-link": true } },
      { label: "Print", icon: "print", attributes: { "data-guide-print": true } }
    ]}
  />
</div>
