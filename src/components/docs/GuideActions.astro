---
import { svgFilePdf, svgFileMd, svgClipboardText, svgLink, svgMore, svgPrint } from "@icons/docs";
import DropdownMenu from "@/components/navigation/DropdownMenu.astro";
import Icon from "@/components/ui/Icon.astro";
import SplitButton from "@/components/ui/SplitButton.astro";
import { menuItemStyles } from "@/lib/styles";
---

<div data-guide-actions class="flex shrink-0 items-center justify-end print:hidden">
  <SplitButton
    label="Download PDF"
    icon={svgFilePdf}
    variant="primary"
    class="guide-pdf-action"
    data-guide-pdf
    options={[
      { label: "Download Markdown", icon: svgFileMd, attributes: { "data-guide-download": true } },
      { label: "Copy as text", icon: svgClipboardText, attributes: { "data-guide-copy": true } },
      { label: "Copy link", icon: svgLink, attributes: { "data-guide-copy-link": true } },
      { label: "Print", icon: svgPrint, attributes: { "data-guide-print": true } }
    ]}
  />
  <DropdownMenu label="Guide actions" icon={svgMore} iconOnly align="end" class="guide-more-action">
    <button type="button" role="menuitem" tabindex="-1" class={menuItemStyles} data-guide-download><Icon src={svgFileMd} size={18} /><span>Download Markdown</span></button>
    <button type="button" role="menuitem" tabindex="-1" class={menuItemStyles} data-guide-copy><Icon src={svgClipboardText} size={18} /><span>Copy as text</span></button>
    <button type="button" role="menuitem" tabindex="-1" class={menuItemStyles} data-guide-copy-link><Icon src={svgLink} size={18} /><span>Copy link</span></button>
    <button type="button" role="menuitem" tabindex="-1" class={menuItemStyles} data-guide-print><Icon src={svgPrint} size={18} /><span>Print</span></button>
  </DropdownMenu>
</div>

<style is:global>
  .guide-pdf-action {
    display: none;
  }
  @media (width >= 1280px) {
    .guide-pdf-action {
      display: inline-flex;
      width: 100%;
    }
    .guide-more-action {
      display: none;
    }
  }
</style>
