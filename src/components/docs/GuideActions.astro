---
import Icon from "@/components/ui/Icon.astro";
import { controlStyles, secondaryStyles, smallControlStyles } from "@/lib/styles";
import { cx } from "@/lib/classes";
---

<div class="-mt-10 hidden items-center justify-end min-[621px]:flex print:hidden">
  <details class="group relative w-64" data-guide-menu>
    <summary class={cx(controlStyles, secondaryStyles, smallControlStyles, "w-full list-none justify-start [&::-webkit-details-marker]:hidden")}>
      <Icon name="export" size={18} class="text-muted-label" />
      Export
      <Icon name="chevron-down" size={14} class="ms-auto transition-transform group-open:rotate-180" />
    </summary>
    <div class="absolute inset-e-0 z-40 mt-2 grid w-full gap-1 rounded-lg border border-outline bg-surface-elevated p-1.5 shadow-(--shadow-md)">
      <button type="button" data-guide-copy class="flex min-h-10 items-center gap-2.5 rounded-md border-0 bg-transparent px-3 py-2.5 text-start text-sm hover:bg-surface-hover focus-visible:bg-surface-hover"><Icon name="copy" size={18} class="text-accent" /><span data-guide-copy-label>Copy page</span></button>
      <button type="button" data-guide-download class="flex min-h-10 items-center gap-2.5 rounded-md border-0 bg-transparent px-3 py-2.5 text-start text-sm hover:bg-surface-hover focus-visible:bg-surface-hover"><Icon name="file-md" size={18} class="text-accent" />Download Markdown</button>
      <button type="button" data-guide-print class="flex min-h-10 items-center gap-2.5 rounded-md border-0 bg-transparent px-3 py-2.5 text-start text-sm hover:bg-surface-hover focus-visible:bg-surface-hover"><Icon name="file-pdf" size={18} class="text-accent" />Print / Save as PDF</button>
    </div>
  </details>
</div>
