---
import { actions, foundations, forms, navigation, data, feedback, overlays, layout } from "@icons/docs";
import Icon from "@/components/ui/Icon.astro";
interface Props {
  group: string;
  size?: number;
  class?: string;
}
const { group, ...rest } = Astro.props;
const icons: Record<string, string> = { foundations, actions, forms, navigation, "data-display": data, feedback, overlays, layout };
---

<Icon src={icons[group]} {...rest} />
