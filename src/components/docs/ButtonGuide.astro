---
import GuideNote from "./GuideNote.astro";
import Table from "./ReferenceTable.astro";
import InlineCode from "@/components/data-display/InlineCode.astro";
import ComponentExample from "./ComponentExample.astro";
const props = [
  ["variant", '"primary" | "secondary" | "outline" | "ghost" | "destructive"', '"primary"', "Visual emphasis and action intent."],
  ["size", '"sm" | "md" | "lg"', '"md"', "Control height and padding."],
  ["type", '"button" | "submit" | "reset"', '"button"', "Native button behavior; applies without href."],
  ["href", "string", "—", "Renders a navigation link instead of a button."],
  ["disabled", "boolean", "false", "Prevents activation; disabled links lose their destination and leave the tab order."],
  ["loading", "boolean", "false", "Shows a spinner, sets aria-busy, and prevents activation."],
  ["icon", "string", "—", "SVG markup imported with ?raw; accepts any Phosphor icon."],
  ["iconPosition", '"start" | "end"', '"start"', "Places the icon before or after the label."],
  ["fullWidth", "boolean", "false", "Fills the width of its container."],
  ["class", "string", "—", "Additional classes for layout or customization."]
];
const examples = [
  { title: "Variants", description: "Choose the emphasis: `primary` for the main action, `secondary` or `outline` for supporting actions, `ghost` for subtle controls, and `destructive` for deletion." },
  { title: "Sizes", description: "Choose a size for the context; `md` is the default." },
  { title: "Icons and links", description: "Add an icon before or after the label. Set `href` to navigate. For icon-only actions, use `IconButton`." },
  { title: "States", description: "Disable unavailable actions. Set `loading` while a request is running to show a spinner and prevent repeated clicks." },
  { title: "Full width", description: "Width follows the parent container." },
  { title: "Forms", description: 'Set `type="submit"` to submit a form. The default is `type="button"`.' }
];
---

<div class="guide-sections">
  <section aria-labelledby="examples" class="guide-section">
    <h2 id="examples" class="m-0 text-[1.375rem] font-semibold tracking-tight">Examples</h2>
    <div class="guide-example-list">
      {examples.map((example) => <ComponentExample slug={`button-${example.title.toLowerCase().replaceAll(" ", "-")}`} title={example.title} description={example.description} />)}
    </div>
  </section>
  <section aria-labelledby="props" class="guide-section">
    <h2 id="props" class="m-0 text-[1.375rem] font-semibold tracking-tight">Props</h2>
    <Table
      caption="Button props, defaults, and behavior"
      columns={[
        { key: "name", label: "Prop", code: true, rowHeader: true },
        { key: "type", label: "Type", code: true, wrap: true },
        { key: "default", label: "Default", code: true },
        { key: "description", label: "Description" }
      ]}
      rows={props.map(([name, type, value, description]) => ({ name, type, default: value, description }))}
    />
    <GuideNote>Place the button label in the default slot. Standard HTML attributes pass through to the button or link.</GuideNote>
  </section>
  <section aria-labelledby="accessibility" class="guide-section">
    <h2 id="accessibility" class="m-0 text-[1.375rem] font-semibold tracking-tight">Accessibility</h2>
    <dl data-surface-level="2" data-surface-lift="1" class="guide-definition lamaui-surface">
      <div><dt>Keyboard</dt><dd>Buttons activate with <InlineCode>Enter</InlineCode> or <InlineCode>Space</InlineCode>; links activate with <InlineCode>Enter</InlineCode>. Keyboard focus has a visible ring.</dd></div>
      <div><dt>Loading</dt><dd><InlineCode>loading</InlineCode> prevents activation and sets <InlineCode>aria-busy</InlineCode>. Clear it when the request finishes and announce the result.</dd></div>
      <div><dt>Disabled</dt><dd>Disabled controls leave the tab order. Links also lose their destination and expose <InlineCode>aria-disabled</InlineCode>.</dd></div>
      <div><dt>Icons</dt><dd>Use an accessible label with <a href="/components/icon-button">IconButton</a> for an action without visible text. Import any Phosphor SVG and pass it to <InlineCode>icon</InlineCode>.</dd></div>
    </dl>
  </section>
</div>
