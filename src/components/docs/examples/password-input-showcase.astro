---
import FormField from "@/components/forms/FormField.astro";
import PasswordInput from "@/components/forms/PasswordInput.astro";
import Stack from "@/components/layout/Stack.astro";
---

<div class="w-full max-w-md min-w-0 justify-self-center">
  <Stack gap={5}>
    <FormField id="preview-password" label="Password">
      <PasswordInput id="preview-password" value="lamaui-demo" />
    </FormField>
    <FormField id="preview-password-disabled" label="Disabled password">
      <PasswordInput id="preview-password-disabled" value="locked-demo" disabled />
    </FormField>
  </Stack>
</div>
