---
import svgPlus from "@phosphor-icons/core/bold/plus-bold.svg?raw";
import svgExternal from "@phosphor-icons/core/duotone/arrow-square-out-duotone.svg?raw";
import Button from "@/components/ui/Button.astro";
---

<div class="flex flex-wrap items-center gap-3">
  <Button icon={svgPlus}>Create</Button>
  <Button variant="secondary" href="https://phosphoricons.com/" icon={svgExternal} iconPosition="end">Browse Phosphor</Button>
</div>
