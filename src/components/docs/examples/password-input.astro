---
import Label from "@/components/forms/Label.astro";
import PasswordInput from "@/components/forms/PasswordInput.astro";
import Button from "@/components/ui/Button.astro";
---

<form data-native-example="password-input" class="grid gap-4">
  <Label for="current-password">Password</Label>
  <PasswordInput id="current-password" name="password" label="Password" autocomplete="current-password" required />
  <div class="flex flex-wrap gap-2">
    <Button type="submit">Read form value</Button>
    <Button type="reset" variant="secondary">Reset</Button>
  </div>
  <output aria-live="polite" class="block text-sm text-muted-label">Submit to inspect the value. Data stays in this preview.</output>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-native-example="password-input"]')!;
  const output = form.querySelector<HTMLOutputElement>(":scope > output")!;
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    output.textContent = `Password entered (${String(new FormData(form).get("password") ?? "").length} characters).`;
  });
  form.addEventListener("reset", () => {
    output.textContent = "Form reset to its initial value.";
  });
</script>
