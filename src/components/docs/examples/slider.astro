---
import Slider from "@/components/forms/Slider.astro";
import Button from "@/components/ui/Button.astro";
---

<form data-native-example="slider" class="grid gap-4">
  <Slider name="seats" label="Seats" min={1} max={20} value={5} step={1} />
  <div class="flex flex-wrap gap-2">
    <Button type="submit">Read form value</Button>
    <Button type="reset" variant="secondary">Reset</Button>
  </div>
  <output aria-live="polite" class="block text-sm text-muted-label">Submit to inspect the value. Data stays in this preview.</output>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-native-example="slider"]')!;
  const output = form.querySelector<HTMLOutputElement>(":scope > output")!;
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    output.textContent = JSON.stringify(Object.fromEntries(new FormData(form)));
  });
  form.addEventListener("reset", () => {
    output.textContent = "Form reset to its initial value.";
  });
</script>
