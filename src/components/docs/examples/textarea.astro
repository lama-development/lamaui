---
import FormField from "@/components/forms/FormField.astro";
import Textarea from "@/components/forms/Textarea.astro";
import Button from "@/components/ui/Button.astro";
---

<form data-native-example="textarea" class="grid gap-4">
  <FormField id="feedback" label="Feedback" error="Keep feedback under 500 characters.">
    <Textarea id="feedback" name="feedback" maxlength={500} invalid aria-describedby="feedback-message" />
  </FormField>
  <div class="flex flex-wrap gap-2">
    <Button type="submit">Read form value</Button>
    <Button type="reset" variant="secondary">Reset</Button>
  </div>
  <output aria-live="polite" class="block text-sm text-muted-label">Submit to inspect the value. Data stays in this preview.</output>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-native-example="textarea"]')!;
  const output = form.querySelector<HTMLOutputElement>(":scope > output")!;
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    output.textContent = JSON.stringify(Object.fromEntries(new FormData(form)));
  });
  form.addEventListener("reset", () => {
    output.textContent = "Form reset to its initial value.";
  });
</script>
