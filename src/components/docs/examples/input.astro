---
import FormField from "@/components/forms/FormField.astro";
import Input from "@/components/forms/Input.astro";
import Button from "@/components/ui/Button.astro";
---

<form data-native-example="input" class="grid gap-4">
  <FormField id="email" label="Work email" error="Enter a valid email address.">
    <Input id="email" name="email" type="email" value="not-an-email" invalid aria-describedby="email-message" required />
  </FormField>
  <div class="flex flex-wrap gap-2">
    <Button type="submit">Read form value</Button>
    <Button type="reset" variant="secondary">Reset</Button>
  </div>
  <output aria-live="polite" class="block text-sm text-muted-label">Submit to inspect the value. Data stays in this preview.</output>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-native-example="input"]')!;
  const output = form.querySelector<HTMLOutputElement>(":scope > output")!;
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    output.textContent = JSON.stringify(Object.fromEntries(new FormData(form)));
  });
  form.addEventListener("reset", () => {
    output.textContent = "Form reset to its initial value.";
  });
</script>
