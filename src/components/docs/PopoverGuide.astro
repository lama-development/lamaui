---
import Card from "@/components/data-display/Card.astro";
import CodeBlock from "@/components/data-display/CodeBlock.astro";
import InlineCode from "@/components/data-display/InlineCode.astro";
import Table from "@/components/data-display/Table.astro";

const props = [
  { name: "label", type: "string", default: "Required", description: "Visible label for the trigger." },
  { name: "position", type: '"left" | "right"', default: '"left"', description: "Aligns the panel with the trigger edge." },
  { name: "class", type: "string", default: "—", description: "Additional classes for layout or customization." }
];
---

<div class="mt-14 flex flex-col gap-14">
  <section aria-labelledby="examples">
    <header class="mb-6">
      <h2 id="examples" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Example</h2>
      <p class="mt-2.5 mb-0 max-w-4xl text-base leading-normal text-muted-label">Use a popover for short contextual content or controls.</p>
    </header>
    <CodeBlock code={'<div class="flex gap-3">\n  <Popover label="Left aligned" position="left">\n    <strong>Left aligned</strong>\n    <p>The panel starts at the trigger’s left edge.</p>\n  </Popover>\n\n  <Popover label="Right aligned" position="right">\n    <strong>Right aligned</strong>\n    <p>The panel ends at the trigger’s right edge.</p>\n  </Popover>\n</div>'} />
  </section>

  <section aria-labelledby="props" class="flex flex-col gap-5">
    <h2 id="props" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Props</h2>
    <Table
      columnBorders
      columns={[
        { key: "name", label: "Prop", code: true, rowHeader: true },
        { key: "type", label: "Type", code: true, wrap: true },
        { key: "default", label: "Default", code: true },
        { key: "description", label: "Description" }
      ]}
      rows={props}
      caption="Popover props"
    />
  </section>

  <section aria-labelledby="accessibility" class="flex flex-col gap-4">
    <h2 id="accessibility" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Accessibility</h2>
    <Card>
      <dl class="m-0 [&_dd]:m-0 [&_dd]:text-base [&_dd]:leading-normal [&_dd]:text-muted-label [&_dt]:text-base [&_dt]:leading-normal [&_dt]:font-semibold [&>div]:grid [&>div]:grid-cols-[8rem_minmax(0,1fr)] [&>div]:gap-5 [&>div]:py-4 max-[620px]:[&>div]:grid-cols-1 max-[620px]:[&>div]:gap-2 [&>div+div]:border-t [&>div+div]:border-outline [&>div:first-child]:pt-0 [&>div:last-child]:pb-0">
        <div><dt>Keyboard</dt><dd><InlineCode>Enter</InlineCode> or <InlineCode>Space</InlineCode> toggles the panel. <InlineCode>Escape</InlineCode> closes it and restores focus.</dd></div>
        <div><dt>Dismissal</dt><dd>Moving focus away or selecting outside the popover closes it.</dd></div>
        <div><dt>Touch</dt><dd>Tap the trigger to toggle the panel and tap outside it to dismiss.</dd></div>
      </dl>
    </Card>
  </section>
</div>
