---
import Table from "./ReferenceTable.astro";
import { componentReference } from "@/lib/component-reference";
interface Props {
  name: string;
}
const { name } = Astro.props;
const reference = componentReference(name);
const slotDescriptions: Record<string, string> = {
  InlineCode: "Short code token or identifier displayed inline with surrounding text.",
  ToastRegion: "Direct Toast children that the runtime stacks inside this fixed region.",
  Button: "Visible action label. Keep icons decorative and use clear action text.",
  IconButton: "Decorative icon; the label prop names the action.",
  ButtonGroup: "Adjacent Button or IconButton children, each retaining native interaction.",
  Toggle: "Visible toggle text or a decorative icon with a label prop.",
  ToggleGroup: "Toggle children representing mutually exclusive pressed choices.",
  Label: "Visible field label; for must match the control’s ID.",
  FormField: "A native field or field component. Set its ID, aria-describedby, and invalid state explicitly.",
  Textarea: "Initial plain-text value. Do not use value to set textarea content.",
  Tabs: "TabPanel children with matching IDs and parent tabsId.",
  TabPanel: "Content visible when its corresponding tab is active.",
  DropdownMenu: "Buttons or links with role=menuitem and tabindex=-1, plus optional separators.",
  Card: "Card body and actions below the optional heading.",
  Chip: "Short textual status label.",
  AvatarGroup: "Avatar children in display order.",
  Tag: "Tag label; the remove button is rendered separately.",
  Alert: "Message explaining the status and the next step.",
  Toast: "Short notification message below its title.",
  Dialog: "Dialog body, forms, and actions. Mark closing controls with data-dialog-close.",
  Drawer: "Scrollable supplementary content and actions.",
  Popover: "Short contextual content or controls; focus remains in normal document order.",
  Tooltip: "One focusable trigger with its own accessible name.",
  Surface: "Content placed on this surface.",
  Container: "Content within the selected maximum width.",
  Stack: "Children arranged vertically in source order.",
  Inline: "Children arranged horizontally, wrapping by default.",
  Grid: "Children arranged in responsive columns, retaining source order.",
  Section: "Section content, including an appropriate heading."
};
const rows = reference.slots.map((slot) => ({ name: slot, description: slotDescriptions[name] ?? "Content rendered in the component body." }));
const title = reference.types.length ? (reference.slots.length ? "Slots and data types" : "Data types") : "Slots";
---

<section aria-labelledby="slots" class="guide-section mt-14">
  <h2 id="slots" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">{title}</h2>
  {
    rows.length > 0 && (
      <dl data-surface-level="2" data-surface-lift="1" class="guide-definition lamaui-surface">
        {rows.map((slot) => (
          <div>
            <dt class="text-sm font-semibold">
              <code>{slot.name}</code>
            </dt>
            <dd class="m-0 text-base leading-normal text-muted-label">{slot.description}</dd>
          </div>
        ))}
      </dl>
    )
  }
  {
    reference.types.map((type) => (
      <div class="flex min-w-0 flex-col gap-4">
        <>
          <h3 class="m-0 text-base font-semibold">{type.name}</h3>
          <Table
            caption={`${name} ${type.name} properties`}
            columns={[
              { key: "name", label: "Property", code: true, rowHeader: true },
              { key: "type", label: "Type", code: true, wrap: true },
              { key: "default", label: "Presence", code: true },
              { key: "description", label: "Description" }
            ]}
            rows={type.props}
          />
        </>
      </div>
    ))
  }
</section>
