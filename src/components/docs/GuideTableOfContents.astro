---
import GuideIndex from "./GuideIndex.astro";
import { cardStyles } from "@/lib/styles";

interface Props {
  sections: { id: string; label: string }[];
  variant: "mobile" | "desktop";
}
const { sections, variant } = Astro.props;
---

<div data-guide-toc data-surface-level="2" data-surface-lift="1" class:list={[cardStyles, "min-w-0 print:hidden", variant === "mobile" ? "mt-4 mb-8 p-2 min-[1280px]:hidden" : "hidden p-3 min-[1280px]:block"]}>
  <GuideIndex {sections} horizontal={variant === "mobile"} />
</div>
