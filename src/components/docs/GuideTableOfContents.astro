---
import GuideIndex from "./GuideIndex.astro";
import Icon from "@/components/ui/Icon.astro";
import { cardStyles, controlStyles, primaryStyles, menuStyles, menuItemStyles } from "@/lib/styles";

interface Props {
  sections: { id: string; label: string }[];
  variant: "mobile" | "desktop";
}

const { sections, variant } = Astro.props;
---

{
  variant === "mobile" ? (
    <div class="mt-4 mb-8 flex items-start gap-2 min-[1280px]:hidden print:hidden">
      <div class:list={[cardStyles, "t-acc min-w-0 flex-1"]} data-guide-mobile-index data-open="false">
        <button type="button" class="guide-index-toggle flex min-h-14 w-full cursor-pointer items-center gap-3 rounded-lg border-0 bg-transparent px-3 text-start text-sm font-semibold [corner-shape:squircle] hover:bg-surface-hover" aria-expanded="false" data-guide-index-toggle>
          <span class="grid size-8 shrink-0 place-items-center rounded-md bg-accent-subtle text-accent">
            <Icon name="clipboard-text" size={18} />
          </span>
          <span class="flex-1">On this page</span>
          <span class="t-acc-chevron text-muted-label">
            <Icon name="chevron-down" size={16} />
          </span>
        </button>
        <div class="t-acc-panel">
          <div class="t-acc-panel-inner">
            <div class="mx-3 border-t border-outline py-3">
              <GuideIndex {sections} />
            </div>
          </div>
        </div>
      </div>
      <details class="group relative shrink-0 min-[621px]:hidden" data-guide-menu>
        <summary aria-label="Export page" title="Export page" class:list={[controlStyles, primaryStyles, "size-14 list-none rounded-lg p-0 [&::-webkit-details-marker]:hidden"]}>
          <Icon name="export" size={20} />
        </summary>
        <div class:list={[menuStyles, "inset-e-0 mt-2 grid w-60 max-w-[calc(100vw-2rem)] gap-0.5"]}>
          <button type="button" data-guide-pdf class={menuItemStyles}>
            <Icon name="file-pdf" size={18} />
            <span>Download PDF</span>
          </button>
          <button type="button" data-guide-download class={menuItemStyles}>
            <Icon name="file-md" size={18} />
            <span>Download Markdown</span>
          </button>
          <button type="button" data-guide-copy class={menuItemStyles}>
            <Icon name="clipboard-text" size={18} />
            <span>Copy as text</span>
          </button>
          <button type="button" data-guide-copy-link class={menuItemStyles}>
            <Icon name="link" size={18} />
            <span>Copy link</span>
          </button>
          <button type="button" data-guide-print class={menuItemStyles}>
            <Icon name="print" size={18} />
            <span>Print</span>
          </button>
        </div>
      </details>
    </div>
  ) : (
    <aside class:list={[cardStyles, "hidden self-start p-3 min-[1280px]:sticky min-[1280px]:top-8 min-[1280px]:mt-3 min-[1280px]:block print:hidden"]}>
      <div class="mb-3 flex items-center gap-3 border-b border-outline pb-3 text-sm font-semibold">
        <span class="grid size-8 shrink-0 place-items-center rounded-md bg-accent-subtle text-accent">
          <Icon name="clipboard-text" size={18} />
        </span>
        <span>On this page</span>
      </div>
      <GuideIndex {sections} />
    </aside>
  )
}

<style>
  .t-acc-panel {
    display: grid;
    grid-template-rows: 0fr;
  }
  .t-acc[data-open="true"] .t-acc-panel {
    grid-template-rows: 1fr;
  }
  .t-acc-panel-inner {
    overflow: hidden;
    opacity: 0;
    filter: blur(2px);
  }
  .t-acc[data-open="true"] .t-acc-panel-inner {
    opacity: 1;
    filter: blur(0);
  }
  .t-acc-chevron {
    display: inline-flex;
    transform: scaleY(1);
    transform-origin: center;
  }
  .t-acc-chevron :global(path) {
    vector-effect: non-scaling-stroke;
  }
  .t-acc[data-open="true"] .t-acc-chevron {
    transform: scaleY(-1);
  }
</style>
