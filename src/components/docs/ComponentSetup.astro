---
import svgCode from "@phosphor-icons/core/bold/code-bold.svg?raw";
import CodeBlock from "@/components/data-display/CodeBlock.astro";
import Button from "@/components/ui/Button.astro";
import Dialog from "@/components/overlays/Dialog.astro";
import { componentReference } from "@/lib/component-reference";
import { components } from "@/lib/components";
interface Props {
  name: string;
}
const { name } = Astro.props;
const reference = componentReference(name);
const dependencies = [
  ...new Set(
    Array.from(reference.source.matchAll(/(?:\bfrom\s+|\bimport\s*)["']([^"']+)["']/g), (match) => {
      const path = match[1];
      if (path.startsWith("@/") || path.startsWith(".")) return path;
      return path
        .split("/")
        .slice(0, path.startsWith("@") ? 2 : 1)
        .join("/");
    })
  )
].filter((path) => path !== "astro");
const setup = '---\nimport "@/styles/global.css";\n---\n\n<slot />\n<script>\n  import "@/scripts/components";\n</script>';
---

<section aria-labelledby="setup" class="guide-section mt-14">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 id="setup" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Installation</h2>
    <Button variant="ghost" size="sm" icon={svgCode} data-dialog-open="component-source" data-guide-no-export>View source</Button>
  </div>
  <div class="guide-installation grid min-w-0 gap-5">
    <p class="m-0 text-base leading-relaxed text-muted-label">Copy the component and its dependencies into your Astro project. Add the shared styles and browser behavior once in your layout.</p>
    <CodeBlock code={setup} label="Layout.astro" />
    {
      dependencies.length > 0 && (
        <div>
          <h3 class="m-0 mb-2 text-base font-semibold">Dependencies</h3>
          <ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-2 p-0 text-base text-muted-label">
            {dependencies.map((path) => {
              const dependency = components.find((component) => path.endsWith(`/${component.name}.astro`) || path === `./${component.name}.astro`);
              return (
                <li>
                  {dependency ? (
                    <a href={`/components/${dependency.slug}`} class="underline decoration-outline underline-offset-4 hover:text-label">
                      {dependency.name}
                    </a>
                  ) : (
                    <code class="text-sm [overflow-wrap:anywhere]">{path}</code>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
    <p class="m-0 text-[0.9375rem] leading-relaxed text-muted-label">The <code>@/</code> alias points to <code>src/</code>. Requires Tailwind CSS with <code>@tailwindcss/vite</code>. If your app replaces pages on the client, initialize the shared controls after navigation.</p>
  </div>
</section>

<Dialog id="component-source" title={`${name} source`} size="lg" class="guide-source-dialog print:hidden" data-guide-no-export data-guide-source>
  <CodeBlock code={reference.source} label={`${name}.astro`} />
</Dialog>

<style>
  :global(.guide-source-dialog) {
    max-width: 64rem;
  }
</style>
