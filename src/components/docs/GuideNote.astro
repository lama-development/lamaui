---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<div class="guide-note">
  {title && <h3>{title}</h3>}
  <div class="guide-note-content"><slot /></div>
</div>

<style>
  .guide-note {
    min-width: 0;
    max-width: 72ch;
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.0625rem;
    font-weight: 650;
  }
  .guide-note-content {
    color: var(--muted-label);
    font-size: 1rem;
    line-height: 1.65;
  }
  .guide-note-content > :global(:first-child) {
    margin-top: 0;
  }
  .guide-note-content > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
