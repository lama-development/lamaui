---
import { svgInfo } from "@icons/docs";
import { svgWarning } from "@/icons/package";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  variant?: "plain" | "info" | "warning";
}
const { variant = "plain" } = Astro.props;
---

<div class:list={["guide-note", variant !== "plain" && "guide-note-callout", variant === "warning" && "guide-note-warning"]} role={variant !== "plain" ? "note" : undefined}>
  {variant !== "plain" && <Icon src={variant === "warning" ? svgWarning : svgInfo} size={20} class="guide-note-icon" />}
  <div class="guide-note-content"><slot /></div>
</div>

<style>
  .guide-note {
    width: 100%;
    min-width: 0;
    max-width: none;
  }
  .guide-note-callout {
    --note-color: var(--info);
    --note-background: var(--info-subtle);
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--note-color) 25%, transparent);
    border-radius: var(--radius-md);
    background: var(--note-background);
    color: var(--note-color);
  }
  .guide-note-warning {
    --note-color: var(--warning);
    --note-background: var(--warning-subtle);
  }
  .guide-note-content {
    color: var(--muted-label);
    font-size: 1rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .guide-note-callout .guide-note-content {
    color: inherit;
  }
  .guide-note-content > :global(:first-child) {
    margin-top: 0;
  }
  .guide-note-content > :global(:last-child) {
    margin-bottom: 0;
  }
  @media (width >= 640px) {
    .guide-note-callout {
      padding: 1.125rem 1.25rem;
    }
  }
</style>
