---
import { svgChevronRight } from "@icons/docs";
import Icon from "@/components/ui/Icon.astro";
interface Page {
  name: string;
  slug: string;
}
interface Props {
  previous?: Page;
  next?: Page;
}
const { previous, next } = Astro.props;
const linkStyles = "component-pagination-link flex min-w-0 min-h-13 items-center gap-3 rounded-sm no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring hover:[&_strong]:underline hover:[&_strong]:underline-offset-4";
const labelStyles = "mb-1 block text-sm leading-tight text-muted-label";
const titleStyles = "block truncate text-base leading-tight font-semibold";
---

<nav class:list={["component-pagination mt-12 grid grid-cols-2 gap-6 border-t border-outline pt-6", (!previous || !next) && "component-pagination-single max-[861px]:grid-cols-1"]} aria-label="Component pages">
  {
    previous ? (
      <a href={`/components/${previous.slug}`} class={linkStyles}>
        <Icon src={svgChevronRight} class="size-4 rotate-180 min-[861px]:size-5" />
        <span class="min-w-0">
          <>
            <small class={labelStyles}>Previous</small>
            <strong class={titleStyles}>{previous.name}</strong>
          </>
        </span>
      </a>
    ) : (
      <span class="component-pagination-placeholder hidden min-[861px]:block" />
    )
  }
  {
    next ? (
      <a href={`/components/${next.slug}`} class:list={[linkStyles, "component-pagination-next justify-end text-right"]}>
        <span class="min-w-0">
          <>
            <small class={labelStyles}>Next</small>
            <strong class={titleStyles}>{next.name}</strong>
          </>
        </span>
        <Icon src={svgChevronRight} class="size-4 min-[861px]:size-5" />
      </a>
    ) : (
      <span class="component-pagination-placeholder hidden min-[861px]:block" />
    )
  }
</nav>
