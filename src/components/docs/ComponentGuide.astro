---
import GuideActions from "./GuideActions.astro";
import GuideTableOfContents from "./GuideTableOfContents.astro";
import Alert from "@/components/feedback/Alert.astro";
interface Props {
  title: string;
  slug: string;
  description: string;
  sections: { id: string; label: string }[];
}
const { title, slug, description, sections } = Astro.props;
---

<div data-guide data-guide-title={title} data-guide-slug={slug} data-guide-description={description}>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <slot name="breadcrumb" />
    <GuideActions />
  </div>
  <Alert variant="success" title="Action complete" class="fixed right-4 bottom-4 z-100 w-[min(24rem,calc(100%-2rem))] shadow-(--shadow-lg)" data-guide-alert="success" data-dismiss-hide hidden>
    <span data-guide-alert-message>Page action completed.</span>
  </Alert>
  <Alert variant="destructive" title="Action failed" class="fixed right-4 bottom-4 z-100 w-[min(24rem,calc(100%-2rem))] shadow-(--shadow-lg)" data-guide-alert="error" data-dismiss-hide hidden>
    <span data-guide-alert-message>Try again.</span>
  </Alert>
  <GuideTableOfContents {sections} variant="mobile" />
  <div class="grid min-w-0 gap-8 min-[1280px]:grid-cols-[minmax(0,1fr)_16rem] print:block">
    <article class="min-w-0" data-guide-content><slot /></article>
    <GuideTableOfContents {sections} variant="desktop" />
  </div>
</div>
<script>
  import "@/scripts/component-guide";
</script>
