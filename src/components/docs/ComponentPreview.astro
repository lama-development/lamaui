---
import { menuItemStyles } from "@/lib/styles";
import Button from "@/components/ui/Button.astro";
import IconButton from "@/components/ui/IconButton.astro";
import ButtonGroup from "@/components/ui/ButtonGroup.astro";
import SplitButton from "@/components/ui/SplitButton.astro";
import Toggle from "@/components/ui/Toggle.astro";
import ToggleGroup from "@/components/ui/ToggleGroup.astro";
import Icon from "@/components/ui/Icon.astro";
import ThemePicker from "@/components/ui/ThemePicker.astro";
import Label from "@/components/forms/Label.astro";
import FormField from "@/components/forms/FormField.astro";
import Input from "@/components/forms/Input.astro";
import Textarea from "@/components/forms/Textarea.astro";
import Select from "@/components/forms/Select.astro";
import CustomSelect from "@/components/forms/CustomSelect.astro";
import Checkbox from "@/components/forms/Checkbox.astro";
import RadioGroup from "@/components/forms/RadioGroup.astro";
import Switch from "@/components/forms/Switch.astro";
import Slider from "@/components/forms/Slider.astro";
import SearchInput from "@/components/forms/SearchInput.astro";
import PasswordInput from "@/components/forms/PasswordInput.astro";
import NumberInput from "@/components/forms/NumberInput.astro";
import Navbar from "@/components/navigation/Navbar.astro";
import Sidebar from "@/components/navigation/Sidebar.astro";
import Breadcrumb from "@/components/navigation/Breadcrumb.astro";
import Tabs from "@/components/navigation/Tabs.astro";
import TabPanel from "@/components/navigation/TabPanel.astro";
import Pagination from "@/components/navigation/Pagination.astro";
import Stepper from "@/components/navigation/Stepper.astro";
import DropdownMenu from "@/components/navigation/DropdownMenu.astro";
import Card from "@/components/data-display/Card.astro";
import Chip from "@/components/data-display/Chip.astro";
import Avatar from "@/components/data-display/Avatar.astro";
import AvatarGroup from "@/components/data-display/AvatarGroup.astro";
import Table from "@/components/data-display/Table.astro";
import DescriptionList from "@/components/data-display/DescriptionList.astro";
import Stat from "@/components/data-display/Stat.astro";
import Progress from "@/components/data-display/Progress.astro";
import Skeleton from "@/components/data-display/Skeleton.astro";
import Divider from "@/components/data-display/Divider.astro";
import Tag from "@/components/data-display/Tag.astro";
import CodeBlock from "@/components/data-display/CodeBlock.astro";
import EmptyState from "@/components/data-display/EmptyState.astro";
import Alert from "@/components/feedback/Alert.astro";
import Toast from "@/components/feedback/Toast.astro";
import ToastRegion from "@/components/feedback/ToastRegion.astro";
import Spinner from "@/components/feedback/Spinner.astro";
import Dialog from "@/components/overlays/Dialog.astro";
import Drawer from "@/components/overlays/Drawer.astro";
import Popover from "@/components/overlays/Popover.astro";
import Tooltip from "@/components/overlays/Tooltip.astro";
import Container from "@/components/layout/Container.astro";
import Surface from "@/components/layout/Surface.astro";
import Stack from "@/components/layout/Stack.astro";
import Inline from "@/components/layout/Inline.astro";
import Grid from "@/components/layout/Grid.astro";
import Section from "@/components/layout/Section.astro";
import PageShell from "@/components/layout/PageShell.astro";
import Hero from "@/components/marketing/Hero.astro";
import FeatureCard from "@/components/marketing/FeatureCard.astro";
import FeatureGrid from "@/components/marketing/FeatureGrid.astro";
import CTA from "@/components/marketing/CTA.astro";
import PricingCard from "@/components/marketing/PricingCard.astro";
import TestimonialCard from "@/components/marketing/TestimonialCard.astro";
import SectionHeader from "@/components/marketing/SectionHeader.astro";
import Footer from "@/components/marketing/Footer.astro";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const selectOptions = [
  { value: "design", label: "Design", icon: "forms" as const },
  { value: "engineering", label: "Engineering", icon: "code" as const },
  { value: "research", label: "Research", icon: "search" as const }
];
---

<div data-surface-level="2" class="component-preview relative flex min-h-48 items-center justify-center rounded-lg bg-surface-2 bg-[linear-gradient(color-mix(in_srgb,var(--outline)_45%,transparent)_1px,transparent_1px),linear-gradient(90deg,color-mix(in_srgb,var(--outline)_45%,transparent)_1px,transparent_1px)] bg-size-[24px_24px] p-8 [border:1px_dashed_color-mix(in_srgb,var(--outline),var(--muted-label)_22%)] [corner-shape:squircle] [@media(width<=620px)]:min-h-40 [@media(width<=620px)]:p-4">
  {
    ["alert", "tag"].includes(slug) && (
      <div class="absolute top-2 right-2 z-10">
        <Tooltip text="Reset preview" position="bottom">
          <button type="button" class="inline-flex size-8 items-center justify-center rounded-lg border-0 bg-surface p-0 text-muted-label hover:bg-surface-hover hover:text-label active:scale-[0.96]" aria-label="Reset preview" data-preview-reset>
            <Icon name="reset" size={20} />
          </button>
        </Tooltip>
      </div>
    )
  }
  <div class:list={["component-preview-column w-[min(100%,36rem)] min-w-0", ["alert", "tag"].includes(slug) && "pt-8"]}>
    {slug === "theme-picker" && <ThemePicker label="Preview color theme" />}
    {
      slug === "icon" && (
        <div class="demo-row flex flex-wrap items-center gap-2.5 text-muted-label">
          <>
            <Icon name="home" />
            <Icon name="search" />
            <Icon name="mail" />
            <Icon name="settings" />
            <Icon name="copy" />
            <Icon name="external" />
          </>
        </div>
      )
    }
    {
      slug === "button" && (
        <div class="space-y-6">
          <div>
            <>
              <p class="mb-3 text-sm font-semibold text-muted-label">Variants</p>
              <div class="flex flex-wrap items-center gap-2.5">
                <>
                  <Button>Primary</Button>
                  <Button variant="secondary">Secondary</Button>
                  <Button variant="outline">Outline</Button>
                  <Button variant="ghost">Ghost</Button>
                  <Button variant="destructive">Delete</Button>
                </>
              </div>
            </>
          </div>
          <div>
            <>
              <p class="mb-3 text-sm font-semibold text-muted-label">Sizes</p>
              <div class="flex flex-wrap items-center gap-2.5">
                <>
                  <Button size="sm">Small</Button>
                  <Button>Medium</Button>
                  <Button size="lg">Large</Button>
                </>
              </div>
            </>
          </div>
          <div>
            <>
              <p class="mb-3 text-sm font-semibold text-muted-label">Icons and links</p>
              <div class="flex flex-wrap items-center gap-2.5">
                <>
                  <Button icon="plus">Create</Button>
                  <Button variant="secondary" href="/components/icon" icon="external" iconPosition="end">
                    Browse icons
                  </Button>
                </>
              </div>
            </>
          </div>
          <div>
            <>
              <p class="mb-3 text-sm font-semibold text-muted-label">States</p>
              <div class="flex flex-wrap items-center gap-2.5">
                <>
                  <Button disabled>Disabled</Button>
                  <Button loading>Saving…</Button>
                  <Button variant="secondary" loading>
                    Uploading…
                  </Button>
                  <Button href="/" disabled variant="outline">
                    Disabled link
                  </Button>
                </>
              </div>
            </>
          </div>
          <div>
            <>
              <p class="mb-3 text-sm font-semibold text-muted-label">Full width</p>
              <Button fullWidth>Continue</Button>
            </>
          </div>
        </div>
      )
    }
    {
      slug === "split-button" && (
        <SplitButton
          label="Download PDF"
          icon="file-pdf"
          options={[
            { label: "Download Markdown", icon: "file-md" },
            { label: "Copy as text", icon: "clipboard-text" }
          ]}
        />
      )
    }
    {
      slug === "icon-button" && (
        <div class="demo-row flex flex-wrap items-center gap-2.5">
          <>
            <IconButton label="Add">
              <Icon name="plus" />
            </IconButton>
            <IconButton label="Copy" variant="secondary">
              <Icon name="copy" />
            </IconButton>
            <IconButton label="More actions" variant="ghost">
              <Icon name="more" />
            </IconButton>
          </>
        </div>
      )
    }
    {
      slug === "button-group" && (
        <ButtonGroup label="Alignment">
          <>
            <Button variant="secondary">Left</Button>
            <Button variant="secondary">Center</Button>
            <Button variant="secondary">Right</Button>
          </>
        </ButtonGroup>
      )
    }
    {
      slug === "toggle" && (
        <div class="demo-row flex flex-wrap items-center gap-2.5">
          <>
            <Toggle pressed>
              <Icon name="pin" size={18} /> Pinned
            </Toggle>
            <Toggle>Compact view</Toggle>
          </>
        </div>
      )
    }
    {
      slug === "toggle-group" && (
        <ToggleGroup label="View">
          <>
            <Toggle pressed>List</Toggle>
            <Toggle>Grid</Toggle>
            <Toggle>Board</Toggle>
          </>
        </ToggleGroup>
      )
    }

    {
      slug === "label" && (
        <div>
          <>
            <Label for="label-demo" required>
              Email address
            </Label>
            <Input id="label-demo" type="email" placeholder="name@company.com" />
          </>
        </div>
      )
    }
    {
      slug === "form-field" && (
        <FormField id="field-demo" label="Full name" help="Use the name shown on your profile.">
          <Input id="field-demo" value="Ari Lane" />
        </FormField>
      )
    }
    {
      slug === "input" && (
        <Stack gap={4}>
          <>
            <Input placeholder="Default input" />
            <Input value="Focused and editable" />
            <Input value="Invalid value" invalid />
            <Input value="Disabled" disabled />
          </>
        </Stack>
      )
    }
    {slug === "textarea" && <Textarea placeholder="Write a short note…">The dashboard components use compact, direct copy.</Textarea>}
    {slug === "select" && <Select options={selectOptions} value="design" aria-label="Team" />}
    {slug === "custom-select" && <CustomSelect id="team-select" name="team" label="Team" options={selectOptions} value="design" />}
    {
      slug === "checkbox" && (
        <Stack gap={4}>
          <>
            <Checkbox id="email-updates" label="Email updates" description="Receive important workspace changes." checked />
            <Checkbox id="disabled-check" label="Unavailable option" disabled />
          </>
        </Stack>
      )
    }
    {
      slug === "radio-group" && (
        <RadioGroup
          name="workspace"
          label="Workspace type"
          value="team"
          options={[
            { value: "personal", label: "Personal" },
            { value: "team", label: "Team", description: "Shared with your organization" },
            { value: "enterprise", label: "Enterprise", disabled: true }
          ]}
        />
      )
    }
    {
      slug === "switch" && (
        <Stack gap={4}>
          <>
            <Switch label="Animations" description="Use interface motion and transitions." checked />
            <Switch label="Weekly summary" />
          </>
        </Stack>
      )
    }
    {slug === "slider" && <Slider label="Interface density" value={62} />}
    {slug === "search-input" && <SearchInput placeholder="Search components…" />}
    {slug === "password-input" && <PasswordInput value="lamaui-demo" />}
    {slug === "number-input" && <NumberInput min={1} max={20} value={4} aria-label="Quantity" />}

    {
      slug === "navbar" && (
        <div class="-m-8 max-[621px]:-m-4">
          <>
            <Navbar
              menuId="preview-navbar"
              links={[
                { label: "Dashboard", href: "#", active: true },
                { label: "News", href: "#" },
                { label: "Branding", href: "#" }
              ]}
            >
              <Button size="sm" variant="secondary">
                Account
              </Button>
            </Navbar>
            <div class="muted h-24 p-4 text-muted-label">Resize the page to test the mobile menu.</div>
          </>
        </div>
      )
    }
    {
      slug === "sidebar" && (
        <div class="flex justify-center">
          <Sidebar
            items={[
              { label: "Dashboard", href: "#", active: true, icon: "home" },
              { label: "Company news", href: "#", icon: "feedback" },
              { label: "Branding", href: "#", icon: "marketing" }
            ]}
          />
        </div>
      )
    }
    {slug === "breadcrumb" && <Breadcrumb items={[{ label: "Dashboard", href: "#" }, { label: "Components", href: "#" }, { label: "Breadcrumb" }]} />}
    {
      (slug === "tabs" || slug === "tab-panel") && (
        <Tabs
          id="preview-tabs"
          tabs={[
            { id: "overview", label: "Overview" },
            { id: "activity", label: "Activity" },
            { id: "settings", label: "Settings" }
          ]}
          active="overview"
        >
          <>
            <TabPanel id="overview" tabsId="preview-tabs" active>
              <Card title="Overview">The selected tab controls this panel.</Card>
            </TabPanel>
            <TabPanel id="activity" tabsId="preview-tabs">
              <Card title="Activity">Recent changes appear here.</Card>
            </TabPanel>
            <TabPanel id="settings" tabsId="preview-tabs">
              <Card title="Settings">Workspace preferences appear here.</Card>
            </TabPanel>
          </>
        </Tabs>
      )
    }
    {slug === "pagination" && <Pagination current={3} total={5} />}
    {slug === "stepper" && <Stepper current={2} steps={[{ label: "Details" }, { label: "Members" }, { label: "Review" }]} />}
    {
      slug === "dropdown-menu" && (
        <DropdownMenu label="Actions">
          <>
            <button class={menuItemStyles}>
              <Icon name="copy" size={18} />
              Duplicate
            </button>
            <button class={menuItemStyles}>
              <Icon name="settings" size={18} />
              Settings
            </button>
            <button class={`${menuItemStyles} text-destructive`}>
              <Icon name="close" size={18} />
              Delete
            </button>
          </>
        </DropdownMenu>
      )
    }

    {
      slug === "card" && (
        <Card title="Email signature" description="Create a consistent company signature." interactive>
          <Button size="sm">Open tool</Button>
        </Card>
      )
    }
    {
      slug === "chip" && (
        <div class="demo-row flex flex-wrap items-center gap-2.5">
          <>
            <Chip>Draft</Chip>
            <Chip variant="info">In review</Chip>
            <Chip variant="success">Published</Chip>
            <Chip variant="warning">Attention</Chip>
            <Chip variant="destructive">Error</Chip>
          </>
        </div>
      )
    }
    {
      slug === "avatar" && (
        <div class="demo-row flex flex-wrap items-center gap-2.5">
          <>
            <Avatar initials="AL" size="sm" />
            <Avatar initials="MP" status="online" />
            <Avatar initials="TM" size="lg" />
          </>
        </div>
      )
    }
    {
      slug === "avatar-group" && (
        <AvatarGroup label="Contributors">
          <>
            <Avatar initials="AL" />
            <Avatar initials="MP" />
            <Avatar initials="TM" />
            <Avatar initials="DV" />
          </>
        </AvatarGroup>
      )
    }
    {
      slug === "table" && (
        <Table
          caption="Members"
          columns={[
            { key: "name", label: "Name", rowHeader: true },
            { key: "role", label: "Role" },
            { key: "status", label: "Status", align: "right" }
          ]}
          rows={[
            { name: "Ari Lane", role: "Designer", status: "Active" },
            { name: "Mina Park", role: "Engineer", status: "Away" },
            { name: "Theo Moss", role: "Researcher", status: "Active" }
          ]}
        />
      )
    }
    {
      slug === "description-list" && (
        <DescriptionList
          columns={2}
          items={[
            { term: "Owner", detail: "Design systems" },
            { term: "Last updated", detail: "Today, 14:32" },
            { term: "Version", detail: "0.1.0" },
            { term: "License", detail: "MIT" }
          ]}
        />
      )
    }
    {
      slug === "stat" && (
        <div class="grid gap-4 sm:grid-cols-2">
          <>
            <Stat label="Components" value="60" change="8 added" trend="up" />
            <Stat label="Build time" value="0.4s" change="12% faster" trend="up" />
          </>
        </div>
      )
    }
    {
      slug === "progress" && (
        <Stack gap={6}>
          <>
            <Progress value={72} label="Documentation" showValue />
            <Progress value={38} label="Migration" showValue />
          </>
        </Stack>
      )
    }
    {
      slug === "skeleton" && (
        <Stack gap={3}>
          <>
            <Skeleton height="8rem" radius="var(--radius-lg)" />
            <Skeleton width="72%" height="1.25rem" />
            <Skeleton width="48%" />
          </>
        </Stack>
      )
    }
    {
      slug === "divider" && (
        <Stack gap={5}>
          <>
            <span>Account details</span>
            <Divider />
            <span>Security settings</span>
            <Divider label="or" />
            <span>Continue another way</span>
          </>
        </Stack>
      )
    }
    {
      slug === "tag" && (
        <div class="demo-row tag-row flex flex-wrap items-center gap-1">
          <>
            <Tag>Astro</Tag>
            <Tag removable>Design system</Tag>
            <Tag removable>Tailwind CSS</Tag>
          </>
        </div>
      )
    }
    {slug === "code-block" && <CodeBlock code={'<Button variant="primary">Save</Button>'} />}
    {
      slug === "empty-state" && (
        <EmptyState title="No saved links" description="Save frequently used tools so they are easy to find.">
          <Button size="sm">Add link</Button>
        </EmptyState>
      )
    }

    {
      slug === "alert" && (
        <Stack gap={3}>
          <>
            <Alert title="Information" dismissible data-dismiss-hide>
              Your changes are saved locally.
            </Alert>
            <Alert variant="success" title="Published">
              The new version is available.
            </Alert>
            <Alert variant="warning" title="Review required">
              Two fields need attention.
            </Alert>
            <Alert variant="destructive" title="Could not save">
              Try again in a moment.
            </Alert>
            <Alert icon="heart" color="var(--accent)" background="var(--accent-subtle)" title="Custom alert">
              Pass any icon and theme-aware colors.
            </Alert>
          </>
        </Stack>
      )
    }
    {
      slug === "toast" && (
        <>
          <>
            <Button data-toast-open="preview-toast">Show toast</Button>
            <ToastRegion>
              <Toast id="preview-toast" title="Preferences saved">
                Your changes are ready.
              </Toast>
            </ToastRegion>
          </>
        </>
      )
    }
    {
      slug === "spinner" && (
        <div class="demo-row flex flex-wrap items-center gap-2.5">
          <>
            <Spinner size="sm" />
            <Spinner />
            <Spinner size="lg" />
            <Button variant="secondary">
              <Spinner size="sm" /> Saving
            </Button>
          </>
        </div>
      )
    }

    {
      slug === "dialog" && (
        <>
          <>
            <Button data-dialog-open="preview-dialog">Open dialog</Button>
            <Dialog id="preview-dialog" title="Publish changes?" description="This creates a new component version.">
              <div class="flex justify-end gap-2">
                <>
                  <Button variant="ghost" data-dialog-close>
                    Cancel
                  </Button>
                  <Button data-dialog-close>Publish</Button>
                </>
              </div>
            </Dialog>
          </>
        </>
      )
    }
    {
      slug === "drawer" && (
        <div class="flex flex-wrap items-center justify-center gap-3">
          <Button variant="secondary" data-dialog-open="preview-left-drawer">
            Open left drawer
          </Button>
          <Drawer id="preview-left-drawer" title="Left drawer" side="left">
            <p class="m-0 text-sm text-muted-label">Drawer content.</p>
          </Drawer>
          <Button data-dialog-open="preview-drawer">Open right drawer</Button>
          <Drawer id="preview-drawer" title="Right drawer" side="right">
            <p class="m-0 text-sm text-muted-label">Drawer content.</p>
          </Drawer>
        </div>
      )
    }
    {
      slug === "popover" && (
        <div class="flex flex-wrap items-center justify-center gap-3">
          <Popover label="Left aligned" position="left">
            <>
              <strong>Left aligned</strong>
              <p class="muted mb-0 text-sm text-muted-label">The panel starts at the trigger’s left edge.</p>
            </>
          </Popover>
          <Popover label="Right aligned" position="right">
            <>
              <strong>Right aligned</strong>
              <p class="muted mb-0 text-sm text-muted-label">The panel ends at the trigger’s right edge.</p>
            </>
          </Popover>
        </div>
      )
    }
    {
      slug === "tooltip" && (
        <div class="flex flex-wrap items-center justify-center gap-3">
          <Tooltip text="Copy component" position="top">
            <IconButton label="Copy component" variant="secondary">
              <Icon name="copy" />
            </IconButton>
          </Tooltip>
          <Tooltip text="Open documentation" position="bottom">
            <IconButton label="Open documentation" variant="secondary">
              <Icon name="external" />
            </IconButton>
          </Tooltip>
        </div>
      )
    }

    {
      slug === "surface" && (
        <Surface level={1} class="grid gap-4 border border-outline">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <strong>Page substrate</strong>
              <p class="mt-1 mb-0 text-sm text-muted-label">Each child lifts from the surface around it.</p>
            </div>
            <span class="text-xs font-semibold text-muted-label">Level 1</span>
          </div>
          <Surface lift={1} class="grid gap-4 border border-outline">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <strong>Card</strong>
              <span class="text-xs font-semibold text-muted-label">Level 2</span>
            </div>
            <Surface lift={1} class="flex flex-wrap items-center justify-between gap-4 border border-outline" padding="sm">
              <span class="text-sm font-semibold">Nested popover</span>
              <span class="text-xs font-semibold text-muted-label">Level 3</span>
            </Surface>
          </Surface>
        </Surface>
      )
    }
    {
      slug === "container" && (
        <Container size="sm" class="border border-dashed border-accent py-5">
          Constrained content
        </Container>
      )
    }
    {
      slug === "stack" && (
        <Stack gap={3}>
          <>
            <Card padding="sm">First item</Card>
            <Card padding="sm">Second item</Card>
            <Card padding="sm">Third item</Card>
          </>
        </Stack>
      )
    }
    {
      slug === "inline" && (
        <Inline gap={3}>
          <>
            <Button size="sm">Save</Button>
            <Button size="sm" variant="secondary">
              Cancel
            </Button>
            <Button size="sm" variant="ghost">
              Preview
            </Button>
          </>
        </Inline>
      )
    }
    {
      slug === "grid" && (
        <Grid columns={3}>
          <>
            <Card padding="sm">One</Card>
            <Card padding="sm">Two</Card>
            <Card padding="sm">Three</Card>
          </>
        </Grid>
      )
    }
    {
      slug === "section" && (
        <Section padding="sm" class="rounded-2xl bg-muted px-5">
          <>
            <h3 class="m-0">Section content</h3>
            <p class="muted mb-0 text-muted-label">Consistent vertical rhythm.</p>
          </>
        </Section>
      )
    }
    {
      slug === "page-shell" && (
        <div class="max-h-72 overflow-hidden rounded-2xl border border-outline">
          <PageShell>
            <>
              <div slot="navigation" class="border-b border-outline bg-surface p-3 font-semibold">
                Navigation
              </div>
              <div class="p-6">Main page content</div>
              <div slot="footer" class="muted border-t border-outline bg-surface p-3 text-sm text-muted-label">
                Footer
              </div>
            </>
          </PageShell>
        </div>
      )
    }

    {
      slug === "hero" && (
        <Hero title="Build clear internal tools." description="A focused hero with direct language and two useful actions.">
          <>
            <Button>Get started</Button>
            <Button variant="secondary">View guide</Button>
          </>
        </Hero>
      )
    }
    {slug === "feature-card" && <FeatureCard title="Email signatures" description="Create a consistent company signature for every role." href="#" />}
    {
      slug === "feature-grid" && (
        <FeatureGrid>
          <>
            <FeatureCard title="QR codes" description="Create branded contact codes." />
            <FeatureCard title="Signatures" description="Build consistent email signatures." />
            <FeatureCard title="Branding" description="Find approved brand assets." />
          </>
        </FeatureGrid>
      )
    }
    {
      slug === "cta" && (
        <CTA title="Ready to publish?" description="Review the component changes before creating a version.">
          <Button>Publish</Button>
        </CTA>
      )
    }
    {
      slug === "pricing-card" && (
        <PricingCard name="Team" price="€18" description="For growing product teams." features={["All components", "Dark theme", "Typed props"]}>
          <Button fullWidth>Choose Team</Button>
        </PricingCard>
      )
    }
    {slug === "testimonial-card" && <TestimonialCard quote="The defaults are clear and the interactions feel deliberate." name="Ari Lane" role="Product designer" initials="AL" />}
    {slug === "section-header" && <SectionHeader title="Company tools" description="Useful utilities for everyday work." />}
    {
      slug === "footer" && (
        <div class="-m-8 max-[621px]:-m-4">
          <Footer />
        </div>
      )
    }
  </div>
</div>
