---
import ComponentExample from "./ComponentExample.astro";
import InlineCode from "@/components/data-display/InlineCode.astro";
import Table from "./ReferenceTable.astro";

const props = [
  { name: "text", type: "string", default: "Required", description: "Short supplemental label shown in the tooltip." },
  { name: "position", type: '"top" | "bottom"', default: '"top"', description: "Preferred position. The tooltip flips when space is limited." },
  { name: "class", type: "string", default: "—", description: "Additional classes for layout or customization." }
];
---

<div class="guide-sections">
  <section aria-labelledby="examples" class="guide-section">
    <ComponentExample slug="tooltip-positions" title="Tooltip placement" headingLevel="h2" headingId="examples" description="Use a tooltip to supplement an already accessible control with a short label." />
  </section>

  <section aria-labelledby="props" class="guide-section">
    <h2 id="props" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Props</h2>
    <Table
      columns={[
        { key: "name", label: "Prop", code: true, rowHeader: true },
        { key: "type", label: "Type", code: true, wrap: true },
        { key: "default", label: "Default", code: true },
        { key: "description", label: "Description" }
      ]}
      rows={props}
      caption="Tooltip props"
    />
  </section>

  <section aria-labelledby="accessibility" class="guide-section">
    <h2 id="accessibility" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Accessibility</h2>
    <dl data-surface-level="2" data-surface-lift="1" class="guide-definition lamaui-surface">
      <div><dt>Label</dt><dd>The trigger still needs its own accessible name. Tooltip text is supplemental and connected with <InlineCode>aria-describedby</InlineCode>.</dd></div>
      <div><dt>Keyboard</dt><dd>Focusing the trigger shows the tooltip. Moving focus away or pressing <InlineCode>Escape</InlineCode> hides it.</dd></div>
      <div><dt>Pointer</dt><dd>Hover shows the tooltip and moving away hides it. It remains visible while hovered or focused.</dd></div>
      <div><dt>Touch</dt><dd>Touch does not require or intercept a tap to show the tooltip. Essential information belongs in a visible label or the control’s accessible name.</dd></div>
    </dl>
  </section>
</div>
