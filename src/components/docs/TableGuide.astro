---
import GuideNote from "./GuideNote.astro";
import Table from "./ReferenceTable.astro";
import ComponentExample from "./ComponentExample.astro";
import InlineCode from "@/components/data-display/InlineCode.astro";
const props = [
  { name: "columns", type: "Column[]", default: "Required", description: "Ordered column definitions." },
  { name: "rows", type: "Record[]", default: "Required", description: "Objects keyed by column key; values are strings, numbers, null, or undefined." },
  { name: "caption", type: "string", default: "—", description: "Screen-reader caption describing the data." },
  { name: "hoverable", type: "boolean", default: "false", description: "Highlights a row on hover; adds no click behavior." },
  { name: "columnBorders", type: "boolean", default: "false", description: "Adds vertical borders between columns in the header and body." },
  { name: "striped", type: "boolean", default: "false", description: "Adds a subtle background to alternating rows." },
  { name: "density", type: '"compact" | "comfortable" | "spacious"', default: '"comfortable"', description: "Controls header and cell padding." },
  { name: "emptyMessage", type: "string", default: '"No results found."', description: "Message displayed when rows is empty." },
  { name: "class", type: "string", default: "—", description: "Additional classes on the native table." }
];
const columnProps = [
  { name: "key", description: "Required. Matches a key in each row object." },
  { name: "label", description: "Required. Text for the column heading." },
  { name: "align", description: '"left" (default), "center", or "right". Right-align numeric values.' },
  { name: "rowHeader", description: "Uses a header cell with scope=row to identify each record." },
  { name: "code", description: "Formats cell values as inline code." },
  { name: "wrap", description: "Allows code values to wrap, including long tokens. Default false; applies with code=true." }
];
---

<div class="guide-sections">
  <section aria-labelledby="examples" class="guide-section">
    <h2 id="examples" class="mt-0 mb-6 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Examples</h2>
    <div class="guide-example-list">
      <ComponentExample slug="table-highlight" title={"Row highlighting"} description={"Use `hoverable` to help readers follow a row across columns in dense data. Documentation tables keep this off."} note={"Put links or buttons inside interactive cells. Hover alone does not provide a keyboard action."} />
      <ComponentExample slug="table-density" title={"Density"} description={"Choose padding for the amount of data. The default is `comfortable`."} />
      <ComponentExample slug="table-striped" title={"Striped rows"} description={"Alternating backgrounds help separate adjacent records without requiring a pointer."} />
      <ComponentExample slug="table-borders" title={"Column borders"} description={"Use `columnBorders` when columns need a stronger visual separation."} />
      <ComponentExample slug="table-empty" title={"Empty state"} description={"Keep the column headings visible and explain why no records are shown."} />
    </div>
  </section>
  <section aria-labelledby="props" class="guide-section">
    <h2 id="props" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Props</h2>
    <GuideNote><p class="m-0">Native table attributes, including <InlineCode>id</InlineCode> and <InlineCode>aria-label</InlineCode>, pass through to the table.</p></GuideNote>
    <Table
      columns={[
        { key: "name", label: "Prop", code: true, rowHeader: true },
        { key: "type", label: "Type", code: true, wrap: true },
        { key: "default", label: "Default", code: true },
        { key: "description", label: "Description" }
      ]}
      rows={props}
      caption="Table props"
    />
    <h3 class="m-0 pt-3 text-base font-semibold">Column definition</h3>
    <Table
      columns={[
        { key: "name", label: "Property", code: true, rowHeader: true },
        { key: "description", label: "Description" }
      ]}
      rows={columnProps}
      caption="Column properties"
    />
  </section>
  <section aria-labelledby="accessibility" class="guide-section">
    <h2 id="accessibility" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Accessibility</h2>
    <dl data-surface-level="2" data-surface-lift="1" class="guide-definition lamaui-surface">
      <div><dt>Semantics</dt><dd>Column headings use <InlineCode>scope="col"</InlineCode>. Set <InlineCode>rowHeader</InlineCode> on the column that identifies each record, and provide a caption or accessible label.</dd></div>
      <div><dt>Scrolling</dt><dd>Wide tables scroll horizontally within their container. Prop names and code values stay intact.</dd></div>
      <div><dt>Data behavior</dt><dd>Rows render in the order supplied. Your page controls sorting, filtering, pagination, and selection.</dd></div>
    </dl>
  </section>
</div>
