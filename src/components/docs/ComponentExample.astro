---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import ExampleFrame from "./ExampleFrame.astro";
interface Props {
  slug: string;
  title?: string;
  label?: string;
  headingLevel?: "h2" | "h3";
  headingId?: string;
  description?: string;
  note?: string;
  codeOnly?: boolean;
  previewClass?: string;
}
const { slug, ...rest } = Astro.props;
const examples = import.meta.glob<{ default: AstroComponentFactory }>("./examples/*.astro", { eager: true });
const sources = import.meta.glob<string>("./examples/*.astro", { query: "?raw", import: "default", eager: true });
const path = `./examples/${slug}.astro`;
const Example = examples[path]?.default;
if (!Example) throw new Error(`Missing executable example for ${slug}`);
---

<ExampleFrame id={`example-${slug}`} code={sources[path]} resettable={["alert", "alert-showcase", "tag-showcase"].includes(slug)} {...rest}><Example /></ExampleFrame>
