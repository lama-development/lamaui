---
interface Props {
  sections: { id: string; label: string }[];
}
const { sections } = Astro.props;
---

<nav aria-label="On this page">
  <ul class="m-0 grid list-none gap-1 p-0">
    {
      sections.map((section) => (
        <li>
          <a href={`#${section.id}`} data-guide-anchor={section.id} class="flex min-h-11 items-center rounded-md px-3 py-2 text-sm font-semibold leading-snug text-muted-label no-underline transition-[background-color,color] duration-(--duration-fast) [corner-shape:squircle] hover:bg-surface-hover hover:text-label aria-[current=location]:bg-accent-subtle aria-[current=location]:text-accent">
            {section.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
