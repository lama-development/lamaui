---
import ComponentExample from "./ComponentExample.astro";
import InlineCode from "@/components/data-display/InlineCode.astro";
import Table from "./ReferenceTable.astro";

const props = [
  { name: "id", type: "string", default: "Required", description: "Connects the drawer to controls that use data-dialog-open." },
  { name: "title", type: "string", default: "Required", description: "Visible heading and accessible name for the drawer." },
  { name: "side", type: '"left" | "right"', default: '"right"', description: "Desktop edge from which the drawer opens. Mobile drawers open from the bottom." },
  { name: "class", type: "string", default: "—", description: "Additional classes for layout or customization." }
];
---

<div class="guide-sections">
  <section aria-labelledby="examples" class="guide-section">
    <header class="mb-6">
      <h2 id="examples" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Example</h2>
    </header>
    <ComponentExample slug="drawer-sides" title={"Drawer placement"} description={"Use a drawer for supporting content that should remain separate from the page."} />
  </section>

  <section aria-labelledby="props" class="guide-section">
    <h2 id="props" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Props</h2>
    <Table
      columns={[
        { key: "name", label: "Prop", code: true, rowHeader: true },
        { key: "type", label: "Type", code: true, wrap: true },
        { key: "default", label: "Default", code: true },
        { key: "description", label: "Description" }
      ]}
      rows={props}
      caption="Drawer props"
    />
  </section>

  <section aria-labelledby="accessibility" class="guide-section">
    <h2 id="accessibility" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Accessibility</h2>
    <dl data-surface-level="2" data-surface-lift="1" class="guide-definition lamaui-surface">
      <div><dt>Keyboard</dt><dd><InlineCode>Escape</InlineCode> closes the drawer. Modal focus stays inside and returns to the opener after closing.</dd></div>
      <div><dt>Scrolling</dt><dd>The page stays fixed while drawer content scrolls independently.</dd></div>
      <div><dt>Mobile</dt><dd>The drawer becomes a bottom sheet. Drag its header down to close it.</dd></div>
      <div><dt>Safe area</dt><dd>Bottom padding includes the device safe area so content remains reachable.</dd></div>
    </dl>
  </section>
</div>
