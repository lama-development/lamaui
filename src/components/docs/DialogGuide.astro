---
import Card from "@/components/data-display/Card.astro";
import CodeBlock from "@/components/data-display/CodeBlock.astro";
import InlineCode from "@/components/data-display/InlineCode.astro";
import Table from "@/components/data-display/Table.astro";

const props = [
  { name: "id", type: "string", default: "Required", description: "Connects the dialog to controls that use data-dialog-open." },
  { name: "title", type: "string", default: "Required", description: "Visible heading and accessible name for the dialog." },
  { name: "description", type: "string", default: "—", description: "Optional supporting text connected with aria-describedby." },
  { name: "size", type: '"sm" | "md" | "lg"', default: '"md"', description: "Maximum width. Every size keeps a one-rem viewport inset." },
  { name: "class", type: "string", default: "—", description: "Additional classes for layout or customization." }
];
---

<div class="mt-14 flex flex-col gap-14">
  <section aria-labelledby="examples">
    <header class="mb-6">
      <h2 id="examples" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Examples</h2>
      <p class="mt-2.5 mb-0 max-w-4xl text-base leading-normal text-muted-label">Use dialogs for short decisions and focused tasks that must interrupt the current flow.</p>
    </header>

    <div class="flex flex-col gap-10">
      <div class="flex flex-col gap-4">
        <h3 class="m-0 text-base font-semibold">Basic dialog</h3>
        <CodeBlock code={'<Button data-dialog-open="example-dialog">Open dialog</Button>\n\n<Dialog id="example-dialog" title="Dialog title" description="Short description.">\n  <Button data-dialog-close>Close</Button>\n</Dialog>'} />
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="m-0 text-base font-semibold">Destructive confirmation</h3>
        <p class="m-0 max-w-4xl text-base leading-normal text-muted-label">State the consequence in the title and repeat it on the destructive action. Keep Cancel available.</p>
        <CodeBlock code={'<Dialog id="delete-project" title="Delete this project?" size="sm">\n  <Button variant="ghost" data-dialog-close>Cancel</Button>\n  <Button variant="destructive">Delete project</Button>\n</Dialog>'} />
      </div>
    </div>
  </section>

  <section aria-labelledby="props" class="flex flex-col gap-5">
    <h2 id="props" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Props</h2>
    <p class="m-0 max-w-4xl text-base leading-normal text-muted-label">Native dialog attributes pass through to the underlying <InlineCode>dialog</InlineCode> element.</p>
    <Table
      columnBorders
      columns={[
        { key: "name", label: "Prop", code: true, rowHeader: true },
        { key: "type", label: "Type", code: true, wrap: true },
        { key: "default", label: "Default", code: true },
        { key: "description", label: "Description" }
      ]}
      rows={props}
      caption="Dialog props"
    />
  </section>

  <section aria-labelledby="accessibility" class="flex flex-col gap-4">
    <h2 id="accessibility" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Accessibility</h2>
    <Card>
      <dl class="m-0 [&_dd]:m-0 [&_dd]:text-base [&_dd]:leading-normal [&_dd]:text-muted-label [&_dt]:text-base [&_dt]:leading-normal [&_dt]:font-semibold [&>div]:grid [&>div]:grid-cols-[8rem_minmax(0,1fr)] [&>div]:gap-5 [&>div]:py-4 max-[620px]:[&>div]:grid-cols-1 max-[620px]:[&>div]:gap-2 [&>div+div]:border-t [&>div+div]:border-outline [&>div:first-child]:pt-0 [&>div:last-child]:pb-0">
        <div><dt>Name</dt><dd>The visible title labels the dialog. The optional description supplies additional context.</dd></div>
        <div><dt>Keyboard</dt><dd><InlineCode>showModal()</InlineCode> keeps <InlineCode>Tab</InlineCode> focus inside the dialog. <InlineCode>Escape</InlineCode> closes it.</dd></div>
        <div><dt>Focus</dt><dd>The browser moves focus into the modal and returns it to the opener when the dialog closes. Put the most useful control first in DOM order.</dd></div>
        <div><dt>Actions</dt><dd>Use specific labels such as “Delete project” or “Send invitation.” Avoid ambiguous confirmation labels such as “Yes” and “OK.”</dd></div>
        <div><dt>Scrolling</dt><dd>The dialog stays within the viewport and scrolls internally when its content is long. Test at 200% zoom and at narrow widths.</dd></div>
      </dl>
    </Card>
  </section>
</div>
