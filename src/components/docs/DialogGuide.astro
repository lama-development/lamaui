---
import GuideNote from "./GuideNote.astro";
import DialogFormExample from "./DialogFormExample.astro";
import formExampleSource from "./DialogFormExample.astro?raw";
import ExampleFrame from "./ExampleFrame.astro";
import ComponentExample from "./ComponentExample.astro";
import InlineCode from "@/components/data-display/InlineCode.astro";
import Table from "./ReferenceTable.astro";

const props = [
  { name: "id", type: "string", default: "Required", description: "Connects the dialog to controls that use data-dialog-open." },
  { name: "title", type: "string", default: "Required", description: "Visible heading and accessible name for the dialog." },
  { name: "description", type: "string", default: "—", description: "Optional supporting text connected with aria-describedby." },
  { name: "size", type: '"sm" | "md" | "lg"', default: '"md"', description: "Maximum width. Every size keeps a one-rem viewport inset." },
  { name: "class", type: "string", default: "—", description: "Additional classes for layout or customization." }
];
---

<div class="guide-sections">
  <section aria-labelledby="examples" class="guide-section">
    <header class="mb-6">
      <h2 id="examples" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Examples</h2>
    </header>

    <div class="guide-example-list">
      <ComponentExample slug="dialog-basic" title={"Basic dialog"} />

      <ComponentExample slug="dialog-destructive" title={"Destructive confirmation"} description={"State the consequence in the title and repeat it on the destructive action. Keep Cancel available."} />
      <ComponentExample slug="dialog-sizes" title={"Sizes and long content"} description={"Choose sm for a confirmation, md for a short task, and lg for a wider form. The dialog keeps a one-rem viewport inset and scrolls vertically when content is long. Keep the title and actions concise; do not put a second fixed-height scroller around the entire body."} />
      <ComponentExample slug="dialog-native-form" title={"Native form confirmation"} description={'A form with method="dialog" closes the modal after native validation and sets returnValue from the submit button’s value. It does not send an HTTP request. Use this for local decisions, then handle the dialog’s close event in your application.'} />
      <ExampleFrame id="example-dialog-async" code={formExampleSource} title={"Asynchronous save and retry"} description={"Try a successful save, then enable the simulated failure to test retry. The example uses a short local delay and makes no network request. Replace saveProject with your API call and check the HTTP response before closing. Keep the dialog open on errors, preserve entered values, announce the failure, and re-enable submission. Cancel and Escape remain available and abort the pending request."} note={'Use type="submit" for the save button and do not add data-dialog-close to it. Native required and maxlength constraints run before the submit event. Server validation remains necessary. Mark pending work busy, prevent duplicate submissions, focus an actionable error, and only call close after success.'}><DialogFormExample /></ExampleFrame>
    </div>
  </section>

  <section aria-labelledby="props" class="guide-section">
    <h2 id="props" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Props</h2>
    <GuideNote><p class="m-0">Native dialog attributes pass through to the underlying <InlineCode>dialog</InlineCode> element.</p></GuideNote>
    <Table
      columns={[
        { key: "name", label: "Prop", code: true, rowHeader: true },
        { key: "type", label: "Type", code: true, wrap: true },
        { key: "default", label: "Default", code: true },
        { key: "description", label: "Description" }
      ]}
      rows={props}
      caption="Dialog props"
    />
  </section>

  <section aria-labelledby="accessibility" class="guide-section">
    <h2 id="accessibility" class="m-0 scroll-mt-24 text-[1.375rem] font-semibold tracking-tight">Accessibility</h2>
    <dl data-surface-level="2" data-surface-lift="1" class="guide-definition lamaui-surface">
      <div><dt>Name</dt><dd>The visible title labels the dialog. The optional description supplies additional context.</dd></div>
      <div><dt>Keyboard</dt><dd><InlineCode>showModal()</InlineCode> keeps <InlineCode>Tab</InlineCode> focus inside the dialog. <InlineCode>Escape</InlineCode> closes it.</dd></div>
      <div><dt>Focus</dt><dd>The browser moves focus into the modal and returns it to the opener when the dialog closes. Put the most useful control first in DOM order.</dd></div>
      <div><dt>Actions</dt><dd>Use specific labels such as “Delete project” or “Send invitation.” Avoid ambiguous confirmation labels such as “Yes” and “OK.”</dd></div>
      <div><dt>Scrolling</dt><dd>The dialog stays within the viewport and scrolls internally when its content is long. Test at 200% zoom and at narrow widths.</dd></div>
    </dl>
  </section>
</div>
