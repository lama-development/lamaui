---
import { svgClose, svgSearch } from "@icons/docs";
import Icon from "@/components/ui/Icon.astro";
import { components } from "@/lib/components";
import { guideContent } from "@/lib/guide-content";
import { componentReference } from "@/lib/component-reference";
import { searchAliases, type SearchEntry } from "@/lib/search";
const sections = [
  { id: "usage", title: "Usage", keywords: "usage import example component" },
  { id: "examples", title: "Examples", keywords: "variants composition demo" },
  { id: "props", title: "Props", keywords: "api reference attributes options defaults" },
  { id: "accessibility", title: "Accessibility", keywords: "keyboard focus aria responsive reduced motion" },
  { id: "data-types", title: "Data types", keywords: "interfaces types structured data" }
];
const entries: SearchEntry[] = [
  { title: "Components", component: "Components", group: "Documentation", href: "/", description: "Browse every reusable building block.", keywords: "overview catalog primitives" },
  { title: "Getting started", component: "Getting started", group: "Documentation", href: "/getting-started", description: "Install LamaUI once and use your first component.", keywords: "setup install styles requirements npm integration" },
  { title: "Troubleshooting", component: "Getting started", group: "Documentation", href: "/getting-started#troubleshooting", description: "Fix missing styles, dialog triggers, and missing form values.", keywords: "troubleshooting help unstyled broken not working missing styles form submit dialog open" },
  ...components.flatMap((component) => {
    const content = guideContent[component.slug];
    const reference = componentReference(component.name, content?.props);
    const base = { component: component.name, group: component.group, description: component.description, keywords: searchAliases(component.slug) };
    const availableSections = sections.filter((section) => section.id !== "data-types" || reference.types.length > 0);
    return [{ ...base, title: component.name, href: `/components/${component.slug}` }, ...availableSections.map((section) => ({ ...base, title: `${component.name} · ${section.title}`, section: section.title, href: `/components/${component.slug}#${section.id}`, description: section.id === "examples" ? (content?.example.description ?? component.description) : section.id === "accessibility" ? (content?.accessibility ?? component.description) : component.description, keywords: `${base.keywords} ${section.keywords} ${section.id === "props" ? reference.props.map((prop) => prop.name).join(" ") : ""}` }))];
  })
];
---

<dialog id="docs-search" aria-labelledby="docs-search-title" data-surface-level="3" class="docs-search fixed inset-x-0 top-[min(16vh,8rem)] m-0 mx-auto max-h-[calc(100dvh-2rem)] w-[min(calc(100%-2rem),40rem)] overflow-hidden rounded-2xl border border-outline bg-surface-3 p-0 text-label shadow-(--shadow-overlay) backdrop:bg-overlay print:hidden">
  <h2 id="docs-search-title" class="sr-only">Search documentation</h2>
  <div class="search-input-row flex items-center gap-3 border-b border-outline px-4 py-2">
    <Icon src={svgSearch} size={20} class="shrink-0 text-muted-label" />
    <input id="docs-search-input" type="text" role="combobox" aria-label="Search components and guides" aria-autocomplete="list" aria-controls="docs-search-results" aria-expanded="false" aria-describedby="docs-search-help" autocomplete="off" spellcheck="false" placeholder="Search docs…" class="min-h-10 min-w-0 flex-1 border-0 bg-transparent text-base text-label outline-none placeholder:text-muted-label" />
    <button type="button" data-search-close aria-label="Close search" class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-md border-0 bg-transparent text-muted-label hover:bg-surface-hover focus-visible:outline-2 focus-visible:outline-ring"><Icon src={svgClose} size={18} /></button>
  </div>
  <div class="flex items-center justify-between px-4 pt-3 pb-2 text-xs font-semibold text-muted-label"><span data-search-heading>Suggested</span><span role="status" aria-live="polite" aria-atomic="true" data-search-status></span></div>
  <div id="docs-search-results" role="listbox" aria-label="Search results" data-fluid-hover data-fluid-hover-local class="relative isolate max-h-[min(26rem,50dvh)] overflow-y-auto overscroll-contain px-2 pb-3"></div>
  <p data-search-empty hidden class="m-0 px-5 py-10 text-center text-sm text-muted-label">No matches. Try a component name, “modal”, “forms”, or “button props”.</p>
  <footer id="docs-search-help" class="search-shortcuts flex items-center justify-center gap-5 border-t border-outline px-4 py-3 text-xs text-muted-label">
    <span class="search-shortcut inline-flex items-center gap-1.5">
      <span class="inline-flex gap-1" aria-hidden="true"><kbd class="search-key">↑</kbd><kbd class="search-key">↓</kbd></span>
      <span class="search-shortcut-label" aria-hidden="true">Navigate</span><span class="sr-only">Use Arrow Up and Arrow Down to navigate results.</span>
    </span>
    <span class="search-shortcut inline-flex items-center gap-1.5">
      <kbd class="search-key search-key-enter" aria-hidden="true">Enter</kbd>
      <span class="search-shortcut-label" aria-hidden="true">Open</span><span class="sr-only">Press Enter to open the selected result.</span>
    </span>
    <span class="search-shortcut inline-flex items-center gap-1.5">
      <kbd class="search-key search-key-escape" aria-hidden="true">Esc</kbd>
      <span class="search-shortcut-label" aria-hidden="true">Close</span><span class="sr-only">Press Escape to close search.</span>
    </span>
  </footer>
</dialog>
<script type="application/json" id="docs-search-index" set:html={JSON.stringify(entries).replaceAll("<", "\\u003c")} />
<script>
  import "@/scripts/docs-search";
</script>
<style>
  .docs-search[open] {
    animation: search-enter 160ms ease-out;
  }
  .docs-search {
    --search-result-hover: color-mix(in srgb, var(--label) 9%, var(--surface-3));
  }
  .docs-search :global(.lamaui-fluid-hover) {
    position: absolute;
    z-index: 0;
    background: var(--search-result-hover);
  }
  .docs-search :global(.lamaui-fluid-hover[data-visible="true"]) {
    opacity: 1;
  }
  .search-key {
    display: inline-grid;
    width: 1.75rem;
    height: 1.625rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--label) 18%, var(--outline));
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--surface-1) 72%, var(--surface-2));
    box-shadow:
      inset 0 -2px 0 color-mix(in srgb, var(--label) 14%, transparent),
      0 1px 1px rgb(0 0 0 / 12%);
    color: var(--label);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 650;
    line-height: 1;
  }
  .search-key-enter {
    width: 3.25rem;
  }
  .search-key-escape {
    width: 2.5rem;
  }
  :global(html:has(#docs-search[open])) {
    overflow: hidden;
  }
  @keyframes search-enter {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .docs-search[open] {
      animation: none;
    }
  }
  @media (width <= 620px) {
    .docs-search {
      top: 0.5rem;
      width: calc(100% - 1rem);
      max-height: calc(100dvh - 1rem);
      border-radius: var(--radius-lg);
    }
    .search-shortcuts {
      justify-content: center;
      gap: 1rem;
    }
    .search-shortcut-label {
      display: none;
    }
    .docs-search :global(.search-result-description) {
      display: none;
    }
  }
</style>
