---
import ComponentGuide from "@/components/docs/ComponentGuide.astro";
import ComponentPagination from "@/components/docs/ComponentPagination.astro";
import DocsLayout from "@/layouts/DocsLayout.astro";
import ComponentPreview from "@/components/docs/ComponentPreview.astro";
import CodeBlock from "@/components/data-display/CodeBlock.astro";
import Breadcrumb from "@/components/navigation/Breadcrumb.astro";
import { components, type ComponentDoc } from "@/lib/components";

export function getStaticPaths() {
  return components.map((component) => ({ params: { slug: component.slug }, props: { component } }));
}

interface Props {
  component: ComponentDoc & { group: string; groupSlug: string };
}
const { component } = Astro.props;
const index = components.findIndex((item) => item.slug === component.slug);
const previous = components[index - 1];
const next = components[index + 1];
const sections = [
  { id: "preview-heading", label: "Live preview" },
  { id: "usage-heading", label: "Quick start" }
];
const usage = component.usage;
---

<DocsLayout title={`${component.name} - LamaUI`} description={component.description} currentSlug={component.slug}>
  <ComponentGuide title={component.name} slug={component.slug} description={component.description} {sections}>
    <Breadcrumb slot="breadcrumb" items={[{ label: "Components", href: "/" }, { label: component.group, href: `/#${component.groupSlug}` }, { label: component.name }]} />
    <header data-guide-no-export class="docs-page-header mt-4 mb-8 [&_h1]:m-0 [&_h1]:text-[clamp(2rem,4vw,2.75rem)] [&_h1]:leading-[1.08] [&_h1]:tracking-[-0.035em] [&_p]:m-[0.75rem_0_0] [&_p]:max-w-2xl [&_p]:text-muted-label">
      <h1>{component.name}</h1>
      <p>{component.description}</p>
      <div class="component-meta mt-4 flex flex-wrap gap-1 text-[0.8125rem] text-muted-label [&_span]:inline-flex [&_span]:min-h-7 [&_span]:items-center [&_span]:rounded-(--radius-full) [&_span]:border [&_span]:border-outline [&_span]:bg-surface [&_span]:p-[0.25rem_0.625rem] [&_span]:leading-none"><span>Astro component</span><span>Keyboard accessible</span><span>Theme tokens</span></div>
    </header>

    <section data-guide-no-export class="component-section mt-10 print:hidden [&_h2]:m-[0_0_1rem] [&_h2]:text-2xl" aria-labelledby="preview-heading">
      <h2 id="preview-heading" class="scroll-mt-24">Live preview</h2>
      <ComponentPreview slug={component.slug} />
    </section>

    <section class="component-section mt-10 [&_h2]:m-[0_0_1rem] [&_h2]:text-2xl" aria-labelledby="usage-heading">
      <h2 id="usage-heading" class="scroll-mt-24">Quick start</h2>
      <CodeBlock code={usage} />
    </section>

    <div data-guide-no-export class="print:hidden"><ComponentPagination {previous} {next} /></div>
  </ComponentGuide>
</DocsLayout>
