---
import StandardComponentGuide from "@/components/docs/StandardComponentGuide.astro";
import ComponentDataTypes from "@/components/docs/ComponentDataTypes.astro";
import GuideNote from "@/components/docs/GuideNote.astro";
import InlineCode from "@/components/data-display/InlineCode.astro";
import { guideContent } from "@/lib/guide-content";
import { componentReference, withImports } from "@/lib/component-reference";
import TableGuide from "@/components/docs/TableGuide.astro";
import ButtonGuide from "@/components/docs/ButtonGuide.astro";
import DialogGuide from "@/components/docs/DialogGuide.astro";
import DrawerGuide from "@/components/docs/DrawerGuide.astro";
import PopoverGuide from "@/components/docs/PopoverGuide.astro";
import CustomSelectGuide from "@/components/docs/CustomSelectGuide.astro";
import DropdownMenuGuide from "@/components/docs/DropdownMenuGuide.astro";
import TooltipGuide from "@/components/docs/TooltipGuide.astro";
import ComponentGuide from "@/components/docs/ComponentGuide.astro";
import ComponentPagination from "@/components/docs/ComponentPagination.astro";
import DocsLayout from "@/layouts/DocsLayout.astro";
import ComponentPreview from "@/components/docs/ComponentPreview.astro";
import CodeBlock from "@/components/data-display/CodeBlock.astro";
import { components, type ComponentDoc } from "@/lib/components";

export function getStaticPaths() {
  return components.map((component) => ({ params: { slug: component.slug }, props: { component } }));
}

interface Props {
  component: ComponentDoc & { group: string; groupSlug: string };
}
const { component } = Astro.props;
const index = components.findIndex((item) => item.slug === component.slug);
const previous = components[index - 1];
const next = components[index + 1];
const content = guideContent[component.slug];
const dedicated = new Set(["button", "table", "dialog", "drawer", "popover", "tooltip", "dropdown-menu", "custom-select"]);
if (!content && !dedicated.has(component.slug)) throw new Error(`Missing guide for ${component.name}`);
// Validate every reference at build time, including the dedicated guides.
const reference = componentReference(component.name, content?.props);
const hasDataTypes = reference.types.length > 0;
const sections = [{ id: "preview", label: "Preview" }, { id: "usage", label: "Usage" }, { id: "examples", label: "Examples" }, { id: "props", label: "Props" }, { id: "accessibility", label: "Accessibility" }, ...(hasDataTypes ? [{ id: "data-types", label: "Data types" }] : [])];
const usage = withImports(content?.usage ?? component.usage);
---

<DocsLayout title={`${component.name} - LamaUI`} description={component.description} currentSlug={component.slug}>
  <ComponentGuide title={component.name} slug={component.slug} description={component.description} {sections}>
    <header slot="header" data-guide-no-export class="docs-page-header mb-8 [&_h1]:m-0 [&_h1]:text-[clamp(2.25rem,4vw,2.75rem)] [&_h1]:leading-[1.08] [&_h1]:tracking-[-0.035em] [&_p]:m-[0.75rem_0_0] [&_p]:w-full [&_p]:max-w-none [&_p]:text-[1.0625rem] [&_p]:leading-relaxed [&_p]:text-muted-label">
      <h1>{component.name}</h1>
      <p>{component.description}</p>
    </header>

    <section data-guide-no-export class="guide-section mt-10 print:hidden" aria-labelledby="preview">
      <div class="flex items-center gap-2">
        <h2 id="preview" class="m-0 scroll-mt-24">Preview</h2>
      </div>
      <ComponentPreview slug={component.slug} />
    </section>

    <section class="guide-section mt-14" aria-labelledby="usage">
      <h2 id="usage" class="scroll-mt-24">Usage</h2>
      {
        component.slug === "icon" && (
          <GuideNote>
            Lama uses{" "}
            <a href="https://phosphoricons.com/" target="_blank" rel="noopener noreferrer" class="font-semibold text-label underline underline-offset-4">
              Phosphor icons<span class="sr-only"> (opens in a new tab)</span>
            </a>
            . Run <InlineCode wrap>npm install @phosphor-icons/core</InlineCode>, choose any icon from their catalog, and import its SVG with <InlineCode>?raw</InlineCode>. There is no Lama icon list to maintain.
          </GuideNote>
        )
      }
      <CodeBlock code={usage} label="Usage" />
    </section>

    {content && <StandardComponentGuide name={component.name} slug={component.slug} {content} />}

    {component.slug === "button" && <ButtonGuide />}
    {component.slug === "table" && <TableGuide />}
    {component.slug === "dialog" && <DialogGuide />}
    {component.slug === "drawer" && <DrawerGuide />}
    {component.slug === "popover" && <PopoverGuide />}
    {component.slug === "tooltip" && <TooltipGuide />}
    {component.slug === "dropdown-menu" && <DropdownMenuGuide />}
    {component.slug === "custom-select" && <CustomSelectGuide />}

    {hasDataTypes && <ComponentDataTypes name={component.name} />}

    <div data-guide-no-export class="print:hidden"><ComponentPagination {previous} {next} /></div>
  </ComponentGuide>
</DocsLayout>
