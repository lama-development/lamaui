---
import TableGuide from "@/components/docs/TableGuide.astro";
import ButtonGuide from "@/components/docs/ButtonGuide.astro";
import ComponentGuide from "@/components/docs/ComponentGuide.astro";
import ComponentPagination from "@/components/docs/ComponentPagination.astro";
import DocsLayout from "@/layouts/DocsLayout.astro";
import ComponentPreview from "@/components/docs/ComponentPreview.astro";
import CodeBlock from "@/components/data-display/CodeBlock.astro";
import Breadcrumb from "@/components/navigation/Breadcrumb.astro";
import Icon from "@/components/ui/Icon.astro";
import Tooltip from "@/components/overlays/Tooltip.astro";
import { components, type ComponentDoc } from "@/lib/components";

export function getStaticPaths() {
  return components.map((component) => ({ params: { slug: component.slug }, props: { component } }));
}

interface Props {
  component: ComponentDoc & { group: string; groupSlug: string };
}
const { component } = Astro.props;
const index = components.findIndex((item) => item.slug === component.slug);
const previous = components[index - 1];
const next = components[index + 1];
const sections = [
  { id: "preview", label: "Preview" },
  { id: "quick-start", label: "Quick start" }
];
if (component.slug === "button") sections.push({ id: "examples", label: "Examples" }, { id: "props", label: "Props" }, { id: "accessibility", label: "Accessibility" });
if (component.slug === "table") sections.push({ id: "examples", label: "Examples" }, { id: "props", label: "Props" }, { id: "accessibility", label: "Accessibility" });
const usage = component.usage;
---

<DocsLayout title={`${component.name} - LamaUI`} description={component.description} currentSlug={component.slug}>
  <ComponentGuide title={component.name} slug={component.slug} description={component.description} {sections}>
    <Breadcrumb slot="breadcrumb" items={[{ label: "Components", href: "/" }, { label: component.group, href: `/#${component.groupSlug}` }, { label: component.name }]} />
    <header data-guide-no-export class="docs-page-header mt-4 mb-8 [&_h1]:m-0 [&_h1]:text-[clamp(2rem,4vw,2.75rem)] [&_h1]:leading-[1.08] [&_h1]:tracking-[-0.035em] [&_p]:m-[0.75rem_0_0] [&_p]:max-w-[60ch] [&_p]:text-base [&_p]:leading-relaxed [&_p]:text-muted-label">
      <h1>{component.name}</h1>
      <p>{component.description}</p>
      <div class="component-meta mt-4 flex flex-wrap gap-1 text-[0.8125rem] text-muted-label [&_span]:inline-flex [&_span]:min-h-7 [&_span]:items-center [&_span]:rounded-(--radius-full) [&_span]:border [&_span]:border-outline [&_span]:bg-surface [&_span]:p-[0.25rem_0.625rem] [&_span]:leading-none"><span>Astro component</span><span>Keyboard accessible</span><span>Theme tokens</span></div>
    </header>

    <section data-guide-no-export class="component-section mt-10 print:hidden [&_h2]:text-[1.375rem] [&_h2]:font-semibold [&_h2]:tracking-tight" aria-labelledby="preview">
      <div class="mb-4 flex items-center gap-2">
        <h2 id="preview" class="m-0 scroll-mt-24">Preview</h2>
        <Tooltip text="Reset preview">
          <button type="button" class="inline-flex size-8 items-center justify-center rounded-lg border-0 bg-transparent p-0 text-muted-label hover:bg-surface-hover hover:text-label active:scale-[0.96]" aria-label="Reset preview" data-preview-reset>
            <Icon name="reset" size={20} />
          </button>
        </Tooltip>
      </div>
      <ComponentPreview slug={component.slug} />
    </section>

    <section class="component-section mt-10 [&_h2]:m-[0_0_1rem] [&_h2]:text-[1.375rem] [&_h2]:font-semibold [&_h2]:tracking-tight" aria-labelledby="quick-start">
      <h2 id="quick-start" class="scroll-mt-24">Quick start</h2>
      <CodeBlock code={usage} />
    </section>

    {component.slug === "button" && <ButtonGuide />}
    {component.slug === "table" && <TableGuide />}

    <div data-guide-no-export class="print:hidden"><ComponentPagination {previous} {next} /></div>
  </ComponentGuide>
</DocsLayout>
