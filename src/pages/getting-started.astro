---
import CodeBlock from "@/components/data-display/CodeBlock.astro";
import InlineCode from "@/components/data-display/InlineCode.astro";
import Button from "@/components/ui/Button.astro";
import ComponentGuide from "@/components/docs/ComponentGuide.astro";
import GuideNote from "@/components/docs/GuideNote.astro";
import Accordion from "@/components/navigation/Accordion.astro";
import DocsLayout from "@/layouts/DocsLayout.astro";

const description = "Install LamaUI once, add its styles, and use your first Astro component.";
const sections = [
  { id: "install-lamaui", label: "Install LamaUI" },
  { id: "add-styles", label: "Add the styles" },
  { id: "use-component", label: "Use a component" },
  { id: "troubleshooting", label: "Troubleshooting" },
  { id: "ready", label: "You’re ready" }
];
const installCode = "npm install lamaui";
const layoutCode = `---
// src/layouts/Layout.astro
import "lamaui/styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>My app</title>
  </head>
  <body data-surface-level="1"><slot /></body>
</html>`;
const componentCode = `---
import { Button } from "lamaui";
---

<Button>Save changes</Button>`;
---

<DocsLayout title="Getting started - LamaUI" {description} currentPage="getting-started">
  <ComponentGuide title="Getting started" slug="getting-started" {description} {sections}>
    <header slot="header" data-guide-no-export class="docs-page-header mb-10 [&_h1]:m-0 [&_h1]:text-[clamp(2rem,4vw,2.75rem)] [&_h1]:leading-[1.08] [&_h1]:tracking-[-0.035em] [&_p]:m-[0.75rem_0_0] [&_p]:w-full [&_p]:max-w-none [&_p]:text-muted-label">
      <h1>Getting started</h1>
      <p>Set up LamaUI once for your project. After that, every component is ready to import whenever you need it.</p>
    </header>

    <ol class="m-0 grid w-full min-w-0 list-none grid-cols-[minmax(0,1fr)] gap-10 p-0 sm:gap-12">
      <li>
        <section aria-labelledby="install-lamaui">
          <h2 id="install-lamaui" class="m-0 scroll-mt-24 text-2xl leading-snug font-semibold tracking-tight"><span class="text-muted-label">1.</span> Install LamaUI</h2>
          <p class="mt-2 mb-5 w-full max-w-none leading-[1.6] text-muted-label">Run this once from your Astro project. LamaUI requires Astro and Tailwind CSS 4.</p>
          <div class="mb-5"><GuideNote variant="info">Start with an <a href="https://docs.astro.build/en/install-and-setup/">Astro project</a> and <a href="https://tailwindcss.com/docs/installation/framework-guides/astro">Tailwind CSS 4 configured for Astro</a>.</GuideNote></div>
          <CodeBlock code={installCode} language="bash" label="Terminal" />
        </section>
      </li>

      <li>
        <section aria-labelledby="add-styles">
          <h2 id="add-styles" class="m-0 scroll-mt-24 text-2xl leading-snug font-semibold tracking-tight"><span class="text-muted-label">2.</span> Add the styles</h2>
          <p class="mt-2 mb-5 w-full max-w-none leading-[1.6] text-muted-label">Import the stylesheet once in your root layout. You do not need to repeat it on individual pages or components.</p>
          <CodeBlock code={layoutCode} label="Layout.astro" />
          <p class="mt-4 mb-0 leading-[1.6] text-muted-label">Use this layout on every page that renders LamaUI components. The stylesheet includes the theme tokens, component utilities, and packaged font.</p>
        </section>
      </li>

      <li>
        <section aria-labelledby="use-component">
          <h2 id="use-component" class="m-0 scroll-mt-24 text-2xl leading-snug font-semibold tracking-tight"><span class="text-muted-label">3.</span> Use a component</h2>
          <p class="mt-2 mb-5 w-full max-w-none leading-[1.6] text-muted-label">Import any component by name from <InlineCode>lamaui</InlineCode>. There is nothing else to download or unlock.</p>
          <CodeBlock code={componentCode} label="Page.astro" />
          <div class="mt-5"><GuideNote variant="info">Interactive components load their own behavior. No hydration directive or <InlineCode>lamaui/effects</InlineCode> is needed. Try the <a href="/components/dialog#usage">Dialog usage example</a>.</GuideNote></div>
        </section>
      </li>
    </ol>

    <section aria-labelledby="troubleshooting" class="guide-section mt-14">
      <header><h2 id="troubleshooting">Troubleshooting</h2><p>Check these first if an example does not behave as expected.</p></header>
      <Accordion
        id="setup-troubleshooting"
        label="Common setup questions"
        singleOpen
        items={[
          { id: "styles", title: "Components look unstyled" },
          { id: "dialog", title: "A dialog or drawer does not open" },
          { id: "form", title: "A form field is missing from submitted data" }
        ]}
      >
        <Fragment slot="styles">
          <p class="mt-3 mb-0 leading-[1.6] text-muted-label">Check that <InlineCode>lamaui/styles.css</InlineCode> is imported by the layout used on this page and that Tailwind’s Vite plugin is configured. Follow <a href="#add-styles" class="docs-link font-medium">Add the styles</a>, then restart your development server after changing its configuration.</p>
        </Fragment>
        <Fragment slot="dialog">
          <p class="mt-3 mb-0 leading-[1.6] text-muted-label">Match the trigger’s <InlineCode>data-dialog-open</InlineCode> value to the component’s <InlineCode>id</InlineCode>. IDs must be unique on the page. Compare the working <a href="/components/dialog#usage" class="docs-link font-medium">Dialog example</a> or <a href="/components/drawer#usage" class="docs-link font-medium">Drawer example</a>.</p>
        </Fragment>
        <Fragment slot="form">
          <p class="mt-3 mb-0 leading-[1.6] text-muted-label">Give the control a <InlineCode>name</InlineCode> and place it inside the form. Disabled controls and unchecked checkboxes do not submit a value. Try the <a href="/components/form-field#examples" class="docs-link font-medium">FormField live example</a> to inspect submitted values. Your application handles saving and server validation.</p>
        </Fragment>
      </Accordion>
    </section>

    <aside data-surface-level="2" class="mt-14 grid w-full min-w-0 gap-5 rounded-xl border border-outline bg-surface p-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:p-6">
      <div>
        <h2 id="ready" class="m-0 scroll-mt-24 text-xl">You’re ready</h2>
        <p class="mt-2 mb-0 text-[0.9375rem] leading-[1.6] text-muted-label">Start with <a href="/components/button" class="docs-link font-medium">Button actions</a>, <a href="/components/form-field" class="docs-link font-medium">labeled form fields</a>, or <a href="/components/dialog" class="docs-link font-medium">a Dialog interaction</a>. Each guide includes a live preview, usage code, and related components.</p>
      </div>
      <Button href="/" class="justify-self-start">Browse components</Button>
    </aside>
  </ComponentGuide>
</DocsLayout>
