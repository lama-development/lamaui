---
import CategoryIcon from "@/components/docs/CategoryIcon.astro";
import svgChevronRight from "@phosphor-icons/core/bold/caret-right-bold.svg?raw";
import DocsLayout from "@/layouts/DocsLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import Chip from "@/components/data-display/Chip.astro";
import Tabs from "@/components/navigation/Tabs.astro";
import TabPanel from "@/components/navigation/TabPanel.astro";
import CatalogPreview from "@/components/docs/CatalogPreview.astro";
import { componentGroups, components } from "@/lib/components";
import "@/styles/docs.css";
---

<DocsLayout>
  <header class="docs-page-header mb-8 [&_h1]:m-0 [&_h1]:text-[clamp(2rem,4vw,2.75rem)] [&_h1]:leading-[1.08] [&_h1]:tracking-[-0.035em] [&_p]:m-[0.75rem_0_0] [&_p]:max-w-2xl [&_p]:text-muted-label">
    <h1>Components</h1>
    <p>Astro primitives for controls, surfaces, layout, and interaction.</p>
  </header>

  <section id="catalog" class="catalog" data-catalog aria-label="Component library">
    <span class="sr-only" role="status" aria-live="polite" data-catalog-status>{components.length} components</span>
    <Tabs id="catalog-categories" label="Component category" active="all" tabs={[{ id: "all", label: "All components" }, ...componentGroups.map((group) => ({ id: group.slug, label: group.name }))]} class="catalog-tabs">
      <TabPanel tabsId="catalog-categories" id="all" active class="catalog-panel">
        <div class="catalog-groups" data-category-slot="all">
          {
            componentGroups.map((group) => (
              <section id={group.slug} class="docs-category" aria-labelledby={`${group.slug}-heading`} data-catalog-group={group.slug}>
                <div class="docs-category-head mb-4 flex flex-wrap items-center gap-2.5">
                  <div class="flex items-center gap-2">
                    <CategoryIcon group={group.slug} size={20} class="text-muted-label" aria-hidden="true" />
                    <h2 id={`${group.slug}-heading`} class="m-0 text-lg leading-tight">
                      {group.name}
                    </h2>
                  </div>
                  <Chip variant="accent">
                    <span data-category-count>{group.components.length}</span> components
                  </Chip>
                </div>
                <div class="docs-component-grid">
                  {group.components.map((item) => (
                    <a href={`/components/${item.slug}`} data-surface-level="2" data-surface-lift="1" class="docs-component-card" data-catalog-card data-name={item.name} data-description={item.description} data-category={group.slug}>
                      <CatalogPreview slug={item.slug} group={group.slug} />
                      <div class="catalog-card-copy">
                        <div class="catalog-card-title">
                          <h3>{item.name}</h3>
                          <Icon src={svgChevronRight} size={18} />
                        </div>
                        <p>{item.description}</p>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </TabPanel>
      {
        componentGroups.map((group) => (
          <TabPanel tabsId="catalog-categories" id={group.slug} class="catalog-panel">
            <div class="catalog-groups" data-category-slot={group.slug} />
          </TabPanel>
        ))
      }
    </Tabs>
  </section>
</DocsLayout>

<script>
  import "@/scripts/catalog";
</script>
