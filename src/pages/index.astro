---
import CategoryIcon from "@/components/docs/CategoryIcon.astro";
import { svgChevronRight } from "@icons/docs";
import DocsLayout from "@/layouts/DocsLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import Chip from "@/components/data-display/Chip.astro";
import CatalogPreview from "@/components/docs/CatalogPreview.astro";
import { componentGroups } from "@/lib/components";
import "@/styles/docs.css";

const description = "Astro primitives for controls, surfaces, layout, and interaction.";
---

<DocsLayout description={description}>
  <header class="docs-page-header mb-8 [&_h1]:m-0 [&_h1]:text-[clamp(2rem,4vw,2.75rem)] [&_h1]:leading-[1.08] [&_h1]:tracking-[-0.035em] [&_p]:m-[0.75rem_0_0] [&_p]:w-full [&_p]:max-w-none [&_p]:text-muted-label">
    <h1>Components</h1>
    <p>{description}</p>
  </header>

  <section id="catalog" class="catalog" data-catalog aria-label="Component library">
    <nav class="catalog-tabs" aria-label="Component categories" data-catalog-nav>
      <div class="lamaui-tabs-scroll max-w-full overflow-x-auto">
        <div data-fluid-hover class="lamaui-tabs relative isolate flex w-fit min-w-max gap-1 rounded-lg border border-(--tab-border) bg-(--tab-track) p-1">
          <span class="lamaui-tab-highlight absolute top-1 bottom-1 left-0 z-1 rounded-[calc(var(--radius-lg)-0.25rem)] bg-(--tab-selected)" aria-hidden="true"></span>
          {
            componentGroups.map((group, index) => (
              <a href={`#${group.slug}`} class="lamaui-tab relative z-2 flex min-h-10 shrink-0 items-center rounded-[calc(var(--radius-lg)-0.25rem)] px-3 py-2 text-sm font-semibold text-(--tab-muted-label) no-underline" data-catalog-link={group.slug} aria-current={index === 0 ? "location" : undefined}>
                {group.name}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
    <div class="catalog-groups">
      {
        componentGroups.map((group) => (
          <section id={group.slug} class="docs-category" aria-labelledby={`${group.slug}-heading`} data-catalog-group={group.slug}>
            <div class="docs-category-head mb-4 flex flex-wrap items-center gap-2.5">
              <div class="flex items-center gap-2">
                <CategoryIcon group={group.slug} size={20} class="text-muted-label" aria-hidden="true" />
                <h2 id={`${group.slug}-heading`} class="m-0 text-lg leading-tight">
                  {group.name}
                </h2>
              </div>
              <Chip variant="accent">
                <span data-category-count>{group.components.length}</span> components
              </Chip>
            </div>
            <div class="docs-component-grid">
              {group.components.map((item) => (
                <a href={`/components/${item.slug}`} data-surface-level="2" data-surface-lift="1" class="docs-component-card" data-catalog-card data-name={item.name} data-description={item.description} data-category={group.slug}>
                  <CatalogPreview slug={item.slug} group={group.slug} />
                  <div class="catalog-card-copy">
                    <div class="catalog-card-title">
                      <h3>{item.name}</h3>
                      <Icon src={svgChevronRight} size={18} />
                    </div>
                    <p>{item.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</DocsLayout>

<script>
  import "@/scripts/catalog";
</script>
