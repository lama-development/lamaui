---
import DocsLayout from "@/layouts/DocsLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { componentGroups } from "@/lib/components";
---
<DocsLayout>
  <header class="docs-page-header">
    <h1>Components</h1>
    <p>Reusable Astro components built from the dashboard’s surfaces, spacing, controls, navigation, and motion patterns.</p>
  </header>

  {componentGroups.map(group => (
    <section id={group.slug} class="docs-category" aria-labelledby={`${group.slug}-heading`}>
      <div class="docs-category-head">
        <span><Icon name={group.icon} /></span>
        <div><h2 id={`${group.slug}-heading`}>{group.name}</h2><small class="muted">{group.components.length} components</small></div>
      </div>
      <div class="docs-component-grid">
        {group.components.map(item => (
          <a href={`/components/${item.slug}`} class="docs-component-card">
            <div class="min-w-0 flex-1"><h3>{item.name}</h3><p>{item.description}</p></div>
            <Icon name="chevron-right" size={18} />
          </a>
        ))}
      </div>
    </section>
  ))}
</DocsLayout>
