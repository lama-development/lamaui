---
import "@/styles/global.css";
import Icon from "@/components/ui/Icon.astro";
import { componentGroups } from "@/lib/components";
interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
}
const {
  title = "LamaUI - Components",
  description = "Reusable Astro components extracted from a focused dashboard design language.",
  currentSlug,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width"
    />
    <meta name="description" content={description} /><meta
      name="theme-color"
      content="#619f00"
    />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem("lui-theme");
          if (t) document.documentElement.dataset.theme = t;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="docs-mobile-header">
      <a href="/" class="docs-brand"
        ><span class="docs-mark">L</span><span
          ><strong>LamaUI</strong><small>Components</small></span
        ></a
      >
      <button
        type="button"
        class="lui-control lui-ghost lui-icon"
        aria-label="Open navigation"
        aria-controls="docs-navigation"
        aria-expanded="false"
        data-docs-open><Icon name="menu" /></button
      >
    </header>
    <aside
      id="docs-navigation"
      class="docs-sidebar"
      data-open="false"
      aria-label="Documentation navigation"
    >
      <div class="docs-sidebar-inner">
        <div class="docs-sidebar-head">
          <a href="/" class="docs-brand"
            ><span class="docs-mark">L</span><span
              ><strong>LamaUI</strong><small>Components</small></span
            ></a
          >
          <button
            type="button"
            class="lui-control lui-ghost lui-icon docs-sidebar-close"
            aria-label="Close navigation"
            data-docs-close><Icon name="close" /></button
          >
        </div>
        <nav class="docs-nav">
          <a
            href="/"
            aria-current={!currentSlug ? "page" : undefined}
            class="docs-nav-row"><Icon name="home" /><span>Overview</span></a
          >
          {
            componentGroups.map((group) => {
              const containsCurrent = group.components.some(
                (item) => item.slug === currentSlug,
              );
              return (
                <details class="docs-nav-group" open={containsCurrent}>
                  <summary class="docs-nav-row">
                    <>
                      <Icon name={group.icon} />
                      <span>{group.name}</span>
                      <Icon
                        name="chevron-down"
                        size={16}
                        class="docs-nav-chevron"
                      />
                    </>
                  </summary>
                  <ul>
                    {group.components.map((item) => (
                      <li>
                        <a
                          href={`/components/${item.slug}`}
                          aria-current={
                            item.slug === currentSlug ? "page" : undefined
                          }
                        >
                          {item.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              );
            })
          }
        </nav>
        <div class="docs-sidebar-foot">
          <button type="button" class="docs-preference" data-theme-toggle
            ><span
              ><Icon name="sun" data-theme-icon-light /><Icon
                name="moon"
                data-theme-icon-dark
                hidden
              /></span
            ><span
              ><strong>Appearance</strong><small data-theme-label
                >System theme</small
              ></span
            ></button
          >
        </div>
      </div>
    </aside>
    <button
      class="docs-scrim"
      aria-label="Close navigation"
      data-docs-scrim
      hidden></button>
    <div class="docs-page">
      <main id="main-content" class="docs-content"><slot /></main>
      <footer class="docs-footer">LamaUI 0.1 · Astro and Tailwind CSS</footer>
    </div>
    <script is:inline>
      const $ = (selector, root = document) => root.querySelector(selector);
      const $$ = (selector, root = document) =>
        Array.from(root.querySelectorAll(selector));
      const sidebar = $("#docs-navigation"),
        scrim = $("[data-docs-scrim]"),
        opener = $("[data-docs-open]");
      const setNavigation = (open) => {
        sidebar?.setAttribute("data-open", String(open));
        opener?.setAttribute("aria-expanded", String(open));
        scrim?.toggleAttribute("hidden", !open);
        document.body.classList.toggle("docs-navigation-open", open);
      };
      opener?.addEventListener("click", () => setNavigation(true));
      $("[data-docs-close]")?.addEventListener("click", () =>
        setNavigation(false),
      );
      scrim?.addEventListener("click", () => setNavigation(false));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setNavigation(false);
      });
      $$(".docs-nav-group").forEach((group) =>
        group.addEventListener("toggle", () => {
          if (!group.open) return;
          $$(".docs-nav-group").forEach((other) => {
            if (other !== group) other.open = false;
          });
        }),
      );
      $$('[data-copy-code]').forEach((button) =>
        button.addEventListener("click", async () => {
          const block = button.closest("[data-code-block]"),
            code = $("code", block)?.textContent ?? "",
            label = $("[data-copy-label]", button),
            defaultIcon = $("[data-copy-default]", button),
            successIcon = $("[data-copy-success]", button);
          try {
            await navigator.clipboard.writeText(code);
            defaultIcon?.toggleAttribute("hidden", true);
            successIcon?.toggleAttribute("hidden", false);
            if (label) label.textContent = "Copied";
            button.setAttribute("aria-label", "Code copied");
            window.setTimeout(() => {
              defaultIcon?.toggleAttribute("hidden", false);
              successIcon?.toggleAttribute("hidden", true);
              if (label) label.textContent = "Copy";
              button.setAttribute("aria-label", "Copy code");
            }, 1800);
          } catch {
            if (label) label.textContent = "Copy failed";
          }
        }),
      );
      $$("[data-code-wrap]").forEach((button) =>
        button.addEventListener("click", () => {
          const block = button.closest("[data-code-block]"),
            wrapped = !block.classList.contains("is-wrapped");
          block.classList.toggle("is-wrapped", wrapped);
          button.setAttribute("aria-pressed", String(wrapped));
          button.setAttribute(
            "aria-label",
            wrapped ? "Unwrap lines" : "Wrap lines",
          );
          button.title = wrapped ? "Unwrap lines" : "Wrap lines";
        }),
      );
      const syncTheme = () => {
        const dark =
          document.documentElement.dataset.theme === "dark" ||
          (!document.documentElement.dataset.theme &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        $("[data-theme-icon-light]")?.toggleAttribute("hidden", dark);
        $("[data-theme-icon-dark]")?.toggleAttribute("hidden", !dark);
        const label = $("[data-theme-label]");
        if (label) label.textContent = dark ? "Dark theme" : "Light theme";
      };
      syncTheme();
      $("[data-theme-toggle]")?.addEventListener("click", () => {
        const dark =
          document.documentElement.dataset.theme === "dark" ||
          (!document.documentElement.dataset.theme &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        const next = dark ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("lui-theme", next);
        syncTheme();
      });
      $$("[data-toggle]").forEach((button) =>
        button.addEventListener("click", () =>
          button.setAttribute(
            "aria-pressed",
            String(button.getAttribute("aria-pressed") !== "true"),
          ),
        ),
      );
      $$("[data-toggle-group]").forEach((group) =>
        group.addEventListener("click", (event) => {
          const button = event.target.closest("[data-toggle]");
          if (!button) return;
          $$("[data-toggle]", group).forEach((item) =>
            item.setAttribute("aria-pressed", String(item === button)),
          );
        }),
      );
      $$("[data-password-toggle]").forEach((button) =>
        button.addEventListener("click", () => {
          const input = button
            .closest("[data-password]")
            .querySelector("[data-password-input]");
          const show = input.type === "password";
          input.type = show ? "text" : "password";
          $("[data-password-show]", button)?.toggleAttribute("hidden", show);
          $("[data-password-hide]", button)?.toggleAttribute("hidden", !show);
          button.setAttribute(
            "aria-label",
            `${show ? "Hide" : "Show"} password`,
          );
          button.title = `${show ? "Hide" : "Show"} password`;
        }),
      );
      $$("[data-slider]").forEach((slider) => {
        const output = $("[data-slider-output]", slider.closest("label"));
        const update = () => {
          const min = Number(slider.min),
            max = Number(slider.max),
            value = Number(slider.value),
            progress = ((value - min) / (max - min)) * 100;
          slider.style.setProperty("--slider-progress", `${progress}%`);
          if (output) output.value = slider.value;
        };
        slider.addEventListener("input", update);
        update();
      });
      const dropdowns = [];
      $$("[data-select]").forEach((root) => {
        const trigger = $("[data-select-trigger]", root),
          list = $("[data-select-list]", root),
          input = $("[data-select-input]", root),
          value = $("[data-select-value]", root),
          valueIcon = $("[data-select-value-icon]", root),
          options = $$('[role="option"]', root);
        let closeTimer;
        const close = (focus = false) => {
          if (list.hidden) return;
          list.classList.remove("is-open");
          list.classList.add("is-closing");
          trigger.setAttribute("aria-expanded", "false");
          clearTimeout(closeTimer);
          closeTimer = setTimeout(() => {
            list.hidden = true;
            list.classList.remove("is-closing");
          }, 150);
          if (focus) trigger.focus();
        };
        const open = (where = "selected") => {
          dropdowns.forEach((item) => item.root !== root && item.close());
          list.hidden = false;
          list.classList.remove("is-closing");
          requestAnimationFrame(() => list.classList.add("is-open"));
          trigger.setAttribute("aria-expanded", "true");
          const enabled = options.filter((option) => !option.disabled),
            selected = options.find(
              (option) => option.getAttribute("aria-selected") === "true",
            );
          requestAnimationFrame(() =>
            (where === "first"
              ? enabled[0]
              : where === "last"
                ? enabled.at(-1)
                : selected || enabled[0]
            )?.focus(),
          );
        };
        const choose = (option) => {
          if (option.disabled) return;
          options.forEach((item) => {
            item.setAttribute("aria-selected", String(item === option));
            item.querySelector("[data-option-check]")?.toggleAttribute("hidden", item !== option);
          });
          input.value = option.dataset.value;
          value.classList.add("is-swapping");
          setTimeout(() => {
            value.textContent = option.dataset.label;
            value.classList.remove("is-swapping");
          }, 80);
          if (valueIcon)
            valueIcon.innerHTML =
              option.querySelector("[data-option-icon]")?.innerHTML || "";
          close(true);
        };
        trigger?.addEventListener("click", () =>
          list.hidden ? open() : close(true),
        );
        trigger?.addEventListener("keydown", (event) => {
          if (event.key === "ArrowDown" || event.key === "ArrowUp") {
            event.preventDefault();
            open(event.key === "ArrowDown" ? "first" : "last");
          }
        });
        list?.addEventListener("keydown", (event) => {
          const enabled = options.filter((option) => !option.disabled),
            index = enabled.indexOf(document.activeElement);
          if (event.key === "ArrowDown" || event.key === "ArrowUp") {
            event.preventDefault();
            enabled[
              (index + (event.key === "ArrowDown" ? 1 : -1) + enabled.length) %
                enabled.length
            ]?.focus();
          } else if (
            (event.key === "Enter" || event.key === " ") &&
            document.activeElement.matches('[role="option"]')
          ) {
            event.preventDefault();
            choose(document.activeElement);
          } else if (event.key === "Escape") {
            event.preventDefault();
            close(true);
          }
        });
        options.forEach((option) =>
          option.addEventListener("click", () => choose(option)),
        );
        dropdowns.push({ root, close });
      });
      document.addEventListener("pointerdown", (event) =>
        dropdowns.forEach((item) => {
          if (!item.root.contains(event.target)) item.close();
        }),
      );
      $$("[data-tabs]").forEach((root) => {
        const tabs = $$('[role="tab"]', root),
          panels = $$('[role="tabpanel"]', root);
        const activate = (tab) => {
          tabs.forEach((item) => {
            item.setAttribute("aria-selected", String(item === tab));
            item.tabIndex = item === tab ? 0 : -1;
          });
          panels.forEach(
            (panel) =>
              (panel.hidden = panel.dataset.tabPanel !== tab.dataset.tab),
          );
          tab.focus();
        };
        tabs.forEach((tab) =>
          tab.addEventListener("click", () => activate(tab)),
        );
        root.addEventListener("keydown", (event) => {
          if (!["ArrowLeft", "ArrowRight"].includes(event.key)) return;
          event.preventDefault();
          const index = tabs.indexOf(document.activeElement);
          activate(
            tabs[
              (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) %
                tabs.length
            ],
          );
        });
      });
      $$(".lui-popover").forEach((root) => {
        const summary = $("summary", root),
          panel = $(".lui-popover-panel", root);
        const close = () => {
          if (!root.open || panel.classList.contains("is-closing")) return;
          panel.classList.add("is-closing");
          window.setTimeout(() => {
            root.open = false;
            panel.classList.remove("is-closing");
          }, 160);
        };
        summary?.addEventListener("click", (event) => {
          event.preventDefault();
          if (root.open) return close();
          root.open = true;
          panel.classList.add("is-closing");
          requestAnimationFrame(() =>
            requestAnimationFrame(() => panel.classList.remove("is-closing")),
          );
        });
        document.addEventListener("pointerdown", (event) => {
          if (!root.contains(event.target)) close();
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") close();
        });
      });
      $$("[data-dialog-open]").forEach((button) =>
        button.addEventListener("click", () =>
          document.getElementById(button.dataset.dialogOpen)?.showModal(),
        ),
      );
      $$("[data-dialog-close]").forEach((button) =>
        button.addEventListener("click", () =>
          button.closest("dialog")?.close(),
        ),
      );
      $$("dialog").forEach((dialog) =>
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        }),
      );
      const hideToast = (toast) => {
        if (!toast || toast.classList.contains("hidden")) return;
        toast.classList.remove("is-visible");
        toast.classList.add("is-leaving");
        window.setTimeout(() => {
          toast.classList.remove("flex", "is-leaving");
          toast.classList.add("hidden");
        }, 160);
      };
      $$("[data-toast-open]").forEach((button) =>
        button.addEventListener("click", () => {
          const toast = document.getElementById(button.dataset.toastOpen);
          if (!toast) return;
          toast.classList.remove("hidden", "is-leaving");
          toast.classList.add("flex", "is-visible");
          window.clearTimeout(toast._hideTimer);
          toast._hideTimer = window.setTimeout(() => hideToast(toast), 3500);
        }),
      );
      $$("[data-toast-close]").forEach((button) =>
        button.addEventListener("click", () =>
          hideToast(button.closest("[data-toast]")),
        ),
      );
      $$("[data-dismiss]").forEach((button) =>
        button.addEventListener("click", () =>
          button.closest('[role="alert"],[role="status"]')?.remove(),
        ),
      );
      $$("[data-nav-toggle]").forEach((button) =>
        button.addEventListener("click", () => {
          const nav = document.getElementById(
            button.getAttribute("aria-controls"),
          );
          const opening = nav?.dataset.open !== "true";
          nav.dataset.open = String(opening);
          button.setAttribute("aria-expanded", String(opening));
          button.setAttribute(
            "aria-label",
            opening ? "Close navigation" : "Open navigation",
          );
          button
            .querySelector("[data-nav-open-icon]")
            ?.toggleAttribute("hidden", opening);
          button
            .querySelector("[data-nav-close-icon]")
            ?.toggleAttribute("hidden", !opening);
        }),
      );
    </script>
  </body>
</html>
