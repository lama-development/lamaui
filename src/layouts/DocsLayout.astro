---
import { controlStyles, ghostStyles, iconControlStyles } from "@/lib/styles";
import "@/styles/global.css";
import Icon from "@/components/ui/Icon.astro";
import AccentPicker from "@/components/ui/AccentPicker.astro";
import ThemePicker from "@/components/ui/ThemePicker.astro";
import Llama from "@/assets/icons/llama.svg";
import { componentGroups } from "@/lib/components";
import { version } from "../../package.json";
interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
}
const { title = "LamaUI - Components", description = "Reusable Astro components extracted from a focused dashboard design language.", currentSlug } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} /><meta name="theme-color" content="#fcfdfa" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicons/favicon-96x96.png" />
    <link rel="shortcut icon" href="/favicons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <link rel="preload" href="/fonts/google-sans-flex.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem("lui-theme");
          if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
          const accent = localStorage.getItem("lui-accent");
          if (["lime", "blue", "violet", "rose", "orange", "teal"].includes(accent)) document.documentElement.dataset.accent = accent;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <script>
      import "@/scripts/browser-theme";
      import "@/scripts/ripple";
      import "@/scripts/hover";
      import "@/scripts/brand";
    </script>
    <a href="#main-content" class="skip-link fixed inset-[8px_auto_auto_8px] z-200 transform-[translateY(-80px)] rounded-md bg-accent px-3 py-2 text-sm font-semibold text-accent-label focus:transform-[translateY(0)] print:hidden">Skip to content</a>
    <header class="docs-mobile-header hidden print:hidden [@media(width<=860px)]:sticky [@media(width<=860px)]:top-0 [@media(width<=860px)]:z-40 [@media(width<=860px)]:flex [@media(width<=860px)]:min-h-14 [@media(width<=860px)]:items-center [@media(width<=860px)]:justify-between [@media(width<=860px)]:border-b [@media(width<=860px)]:border-outline [@media(width<=860px)]:bg-surface [@media(width<=860px)]:p-[0.375rem_0.75rem] [@media(width<=860px)]:[backdrop-filter:blur(12px)] [@media(width<=860px)]:[&_.docs-brand]:flex-none [@media(width<=860px)]:[&_.docs-brand_small]:hidden">
      <div class="docs-brand flex min-w-0 flex-1 items-center gap-2.5 rounded-md text-label [&_strong]:block [&_strong]:text-lg [&_strong]:leading-none"><button type="button" class="docs-mascot grid size-8 flex-none place-items-center rounded-full border-0 bg-transparent p-0" aria-label="Play with the llama" data-brand-llama><Llama class="docs-mark size-8" width={32} height={32} aria-hidden="true" focusable="false" /></button><a href="/" class="rounded-sm no-underline"><strong>LamaUI</strong></a></div>
      <button type="button" class={`${controlStyles} ${ghostStyles} ${iconControlStyles}`} aria-label="Open navigation" aria-controls="docs-navigation" aria-expanded="false" data-docs-open><Icon name="menu" /></button>
    </header>
    <aside id="docs-navigation" class="docs-sidebar fixed inset-[0_auto_0_0] z-50 w-60 border-r border-outline bg-surface print:hidden [@media(width<=860px)]:z-80 [@media(width<=860px)]:transform-[translateX(-105%)] [@media(width<=860px)]:shadow-(--shadow-lg) [@media(width<=860px)]:[transition:transform_var(--duration-slow)_var(--ease-standard)] [@media(width<=860px)]:data-[open=true]:transform-[translateX(0)]" data-open="false" aria-label="Documentation navigation">
      <div class="docs-sidebar-inner flex h-full min-h-0 flex-col px-3 pb-3">
        <div class="docs-sidebar-head -mx-3 flex min-h-14 flex-none items-center gap-2 border-b border-outline px-3 py-1.5">
          <div class="docs-brand flex min-w-0 flex-1 items-center gap-2.5 rounded-md text-label [&_strong]:block [&_strong]:text-lg [&_strong]:leading-none"><button type="button" class="docs-mascot grid size-8 flex-none place-items-center rounded-full border-0 bg-transparent p-0" aria-label="Play with the llama" data-brand-llama><Llama class="docs-mark size-8" width={32} height={32} aria-hidden="true" focusable="false" /></button><a href="/" class="rounded-sm no-underline"><strong>LamaUI</strong></a></div>
          <button type="button" class={`${controlStyles} ${ghostStyles} ${iconControlStyles} docs-sidebar-close min-[861px]:hidden!`} aria-label="Close navigation" data-docs-close><Icon name="close" /></button>
        </div>
        <nav class="docs-nav min-h-0 flex-1 overflow-auto py-3 [&>_*_+_*]:mt-1">
          <a href="/" aria-current={!currentSlug ? "page" : undefined} class="docs-nav-row flex min-h-11 cursor-pointer items-center gap-3 rounded-md px-3 py-2 text-sm text-muted-label no-underline [corner-shape:squircle] [transition:background_var(--duration-fast),color_var(--duration-fast)] hover:bg-surface-hover hover:text-label aria-[current=page]:bg-muted aria-[current=page]:font-semibold aria-[current=page]:text-label [&_span]:flex-1 [&_svg]:flex-none"><Icon name="home" /><span>Overview</span></a>
          {
            componentGroups.map((group) => {
              const containsCurrent = group.components.some((item) => item.slug === currentSlug);
              return (
                <div class="docs-nav-group [&_li_a]:flex [&_li_a]:min-h-9 [&_li_a]:items-center [&_li_a]:rounded-[0.625rem] [&_li_a]:p-[0.375rem_0.75rem] [&_li_a]:text-sm [&_li_a]:leading-tight [&_li_a]:text-muted-label [&_li_a]:no-underline [&_li_a:hover]:bg-surface-hover [&_li_a:hover]:text-label [&_li_a[aria-current=page]]:font-semibold [&_li_a[aria-current=page]]:text-accent [&_li+li]:mt-1 [&_ul]:m-0 [&_ul]:list-none [&_ul]:p-[0.25rem_0_0.375rem_2rem] [&[data-open=true]_.docs-nav-chevron]:transform-[rotate(180deg)]" data-open={String(containsCurrent)}>
                  <button type="button" class="docs-nav-row flex min-h-11 w-full cursor-pointer items-center gap-3 rounded-md border-0 bg-transparent px-3 py-2 text-left text-sm text-muted-label no-underline [corner-shape:squircle] [transition:background_var(--duration-fast),color_var(--duration-fast)] hover:bg-surface-hover hover:text-label [&_span]:flex-1 [&_svg]:flex-none" aria-expanded={containsCurrent} aria-controls={`docs-nav-${group.slug}`} data-docs-group-toggle>
                    <>
                      <Icon name={group.icon} />
                      <span>{group.name}</span>
                      <Icon name="chevron-down" size={16} class="docs-nav-chevron [transition:transform_var(--duration-normal)_var(--ease-standard)]" />
                    </>
                  </button>
                  <div id={`docs-nav-${group.slug}`} class="docs-nav-panel" inert={!containsCurrent}>
                    <div class="docs-nav-panel-inner">
                      <ul>
                        {group.components.map((item) => (
                          <li>
                            <a href={`/components/${item.slug}`} aria-current={item.slug === currentSlug ? "page" : undefined}>
                              {item.name}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              );
            })
          }
        </nav>
        <div class="docs-sidebar-foot -mx-3 flex flex-none items-center gap-2 border-t border-outline px-3 pt-3">
          <ThemePicker />
          <AccentPicker id="sidebar-accent" />
        </div>
      </div>
    </aside>
    <button class="docs-scrim print:hidden [@media(width<=860px)]:fixed [@media(width<=860px)]:inset-0 [@media(width<=860px)]:z-70 [@media(width<=860px)]:border-0 [@media(width<=860px)]:bg-overlay" aria-label="Close navigation" data-docs-scrim hidden></button>
    <div class="docs-page min-h-screen pl-60 print:pl-0 [@media(width<=860px)]:pl-0">
      <main id="main-content" class="docs-content mx-auto min-h-[calc(100vh-4rem)] w-[min(100%-6rem,98rem)] pt-12 pb-20 print:min-h-0 print:w-full print:p-0 [@media(620px<width<=860px)]:w-[min(100%-4rem,98rem)] [@media(620px<width<=860px)]:pt-8 [@media(width<=620px)]:w-[min(100%-2rem,98rem)] [@media(width<=620px)]:pt-5 [@media(width<=620px)]:pb-12"><slot /></main>
      <footer class="docs-footer mx-auto flex w-[min(100%-6rem,98rem)] flex-wrap items-center justify-between gap-[0.75rem_1.5rem] border-t border-outline pt-4 pb-8 text-[0.8125rem] text-muted-label print:hidden [@media(620px<width<=860px)]:w-[min(100%-4rem,98rem)] [@media(width<=620px)]:w-[min(100%-2rem,98rem)] [@media(width<=620px)]:flex-col [@media(width<=620px)]:justify-center [@media(width<=620px)]:gap-2 [@media(width<=620px)]:pb-5 [@media(width<=620px)]:text-center">
        <span>&copy; {year} LamaUI</span>
        <div class="docs-footer-links ms-auto flex items-center gap-2 [&_a]:inline-flex [&_a]:items-center [&_a]:gap-1.5 [&_a]:no-underline [&_a:hover]:underline [@media(width<=620px)]:ms-0">
          <span>v{version}</span>
          <span class="size-1 rounded-full bg-current opacity-70" aria-hidden="true"></span>
          <a href="https://github.com/lama-development/lamaui/issues/new" target="_blank" rel="noopener noreferrer">Report a problem<Icon name="external" size={16} /><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </footer>
    </div>
    <script is:inline>
      const $ = (selector, root = document) => root.querySelector(selector);
      const $$ = (selector, root = document) => Array.from(root.querySelectorAll(selector));
      const sidebar = $("#docs-navigation"),
        scrim = $("[data-docs-scrim]"),
        opener = $("[data-docs-open]");
      const setNavigation = (open) => {
        sidebar?.setAttribute("data-open", String(open));
        opener?.setAttribute("aria-expanded", String(open));
        scrim?.toggleAttribute("hidden", !open);
        document.body.classList.toggle("docs-navigation-open", open);
      };
      opener?.addEventListener("click", () => setNavigation(true));
      $("[data-docs-close]")?.addEventListener("click", () => setNavigation(false));
      scrim?.addEventListener("click", () => setNavigation(false));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setNavigation(false);
      });
      $$(".docs-nav-group").forEach((group) => {
        const toggle = $("[data-docs-group-toggle]", group);
        toggle?.addEventListener("click", () => {
          const opening = group.dataset.open !== "true";
          $$(".docs-nav-group").forEach((other) => {
            const open = other === group && opening;
            other.dataset.open = String(open);
            $("[data-docs-group-toggle]", other)?.setAttribute("aria-expanded", String(open));
            const panel = $(".docs-nav-panel", other);
            if (panel) panel.inert = !open;
          });
        });
      });
      $$("[data-copy-code]").forEach((button) =>
        button.addEventListener("click", async () => {
          const block = button.closest("[data-code-block]"),
            code = $("code", block)?.textContent ?? "",
            label = $("[data-copy-label]", button),
            defaultIcon = $("[data-copy-default]", button),
            successIcon = $("[data-copy-success]", button);
          try {
            await navigator.clipboard.writeText(code);
            defaultIcon?.toggleAttribute("hidden", true);
            successIcon?.toggleAttribute("hidden", false);
            if (label) label.textContent = "Copied";
            button.setAttribute("aria-label", "Code copied");
            window.setTimeout(() => {
              defaultIcon?.toggleAttribute("hidden", false);
              successIcon?.toggleAttribute("hidden", true);
              if (label) label.textContent = "Copy";
              button.setAttribute("aria-label", "Copy code");
            }, 1800);
          } catch {
            if (label) label.textContent = "Copy failed";
          }
        })
      );
      $$("[data-code-wrap]").forEach((button) =>
        button.addEventListener("click", () => {
          const block = button.closest("[data-code-block]"),
            wrapped = !block.classList.contains("is-wrapped");
          block.classList.toggle("is-wrapped", wrapped);
          button.setAttribute("aria-pressed", String(wrapped));
          button.setAttribute("aria-label", wrapped ? "Unwrap lines" : "Wrap lines");
          button.title = wrapped ? "Unwrap lines" : "Wrap lines";
          $("[data-wrap-off]", button)?.toggleAttribute("hidden", wrapped);
          $("[data-wrap-on]", button)?.toggleAttribute("hidden", !wrapped);
        })
      );
      $$("[data-toggle]").forEach((button) => button.addEventListener("click", () => button.setAttribute("aria-pressed", String(button.getAttribute("aria-pressed") !== "true"))));
      $$("[data-toggle-group]").forEach((group) =>
        group.addEventListener("click", (event) => {
          const button = event.target.closest("[data-toggle]");
          if (!button) return;
          $$("[data-toggle]", group).forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        })
      );
      $$("[data-password-toggle]").forEach((button) =>
        button.addEventListener("click", () => {
          const input = button.closest("[data-password]").querySelector("[data-password-input]");
          const show = input.type === "password";
          input.type = show ? "text" : "password";
          $("[data-password-show]", button)?.toggleAttribute("hidden", show);
          $("[data-password-hide]", button)?.toggleAttribute("hidden", !show);
          button.setAttribute("aria-label", `${show ? "Hide" : "Show"} password`);
          button.title = `${show ? "Hide" : "Show"} password`;
        })
      );
      $$("[data-slider]").forEach((slider) => {
        const output = $("[data-slider-output]", slider.closest("label"));
        const update = () => {
          const min = Number(slider.min),
            max = Number(slider.max),
            value = Number(slider.value),
            progress = ((value - min) / (max - min)) * 100;
          slider.style.setProperty("--slider-progress", `${progress}%`);
          if (output) output.value = slider.value;
        };
        slider.addEventListener("input", update);
        update();
      });
      $$("[data-tabs]").forEach((root) => {
        const tabs = $$('[role="tab"]', root),
          panels = $$('[role="tabpanel"]', root);
        const highlight = $(".lui-tab-highlight", root);
        const moveHighlight = (tab, animate = true) => {
          if (!highlight || !tab) return;
          const previous = highlight.style.transition;
          if (!animate) highlight.style.transition = "none";
          highlight.style.transform = `translateX(${tab.offsetLeft}px)`;
          highlight.style.width = `${tab.offsetWidth}px`;
          if (!animate) {
            void highlight.offsetWidth;
            highlight.style.transition = previous;
          }
        };
        const activate = (tab) => {
          if (!tab || tab.disabled) return;
          const changed = tab.getAttribute("aria-selected") !== "true";
          tabs.forEach((item) => {
            item.setAttribute("aria-selected", String(item === tab));
            item.tabIndex = item === tab ? 0 : -1;
          });
          panels.forEach((panel) => (panel.hidden = panel.dataset.tabPanel !== tab.dataset.tab));
          moveHighlight(tab);
          if (changed && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            const panel = panels.find((item) => !item.hidden);
            if (panel) {
              panel.getAnimations().forEach((animation) => animation.cancel());
              const styles = getComputedStyle(root);
              panel.animate(
                [
                  { opacity: 0, transform: "translateY(8px)", filter: "blur(2px)" },
                  { opacity: 1, transform: "translateY(0)", filter: "blur(0)" }
                ],
                { duration: parseFloat(styles.getPropertyValue("--duration-normal")), easing: styles.getPropertyValue("--ease-standard").trim() }
              );
            }
          }
          tab.focus();
        };
        tabs.forEach((tab) => tab.addEventListener("click", () => activate(tab)));
        root.addEventListener("keydown", (event) => {
          if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key) || !tabs.includes(document.activeElement)) return;
          event.preventDefault();
          const enabled = tabs.filter((tab) => !tab.disabled);
          const index = enabled.indexOf(document.activeElement);
          activate(enabled[event.key === "Home" ? 0 : event.key === "End" ? enabled.length - 1 : (index + (event.key === "ArrowRight" ? 1 : -1) + enabled.length) % enabled.length]);
        });
        const snapHighlight = () =>
          moveHighlight(
            tabs.find((tab) => tab.getAttribute("aria-selected") === "true"),
            false
          );
        snapHighlight();
        new ResizeObserver(snapHighlight).observe(root);
      });
      $$(".lui-popover").forEach((root) => {
        const summary = $("summary", root),
          panel = $(".lui-popover-panel", root);
        const close = () => {
          if (!root.open || panel.classList.contains("is-closing")) return;
          panel.classList.add("is-closing");
          window.setTimeout(() => {
            root.open = false;
            panel.classList.remove("is-closing");
          }, 160);
        };
        summary?.addEventListener("click", (event) => {
          event.preventDefault();
          if (root.open) return close();
          root.open = true;
          panel.classList.add("is-closing");
          requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.remove("is-closing")));
        });
        document.addEventListener("pointerdown", (event) => {
          if (!root.contains(event.target)) close();
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") close();
        });
      });
      $$("[data-dialog-open]").forEach((button) => button.addEventListener("click", () => document.getElementById(button.dataset.dialogOpen)?.showModal()));
      $$("[data-dialog-close]").forEach((button) => button.addEventListener("click", () => button.closest("dialog")?.close()));
      $$("dialog").forEach((dialog) =>
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        })
      );
      const hideToast = (toast) => {
        if (!toast || toast.classList.contains("hidden")) return;
        toast.classList.remove("is-visible");
        toast.classList.add("is-leaving");
        window.setTimeout(() => {
          toast.classList.remove("flex", "is-leaving");
          toast.classList.add("hidden");
        }, 160);
      };
      $$("[data-toast-open]").forEach((button) =>
        button.addEventListener("click", () => {
          const toast = document.getElementById(button.dataset.toastOpen);
          if (!toast) return;
          toast.classList.remove("hidden", "is-leaving");
          toast.classList.add("flex", "is-visible");
          window.clearTimeout(toast._hideTimer);
          toast._hideTimer = window.setTimeout(() => hideToast(toast), 3500);
        })
      );
      $$("[data-toast-close]").forEach((button) => button.addEventListener("click", () => hideToast(button.closest("[data-toast]"))));
      $$("[data-dismiss]").forEach((button) => button.addEventListener("click", () => button.closest('[role="alert"],[role="status"]')?.remove()));
      $$("[data-nav-toggle]").forEach((button) =>
        button.addEventListener("click", () => {
          const nav = document.getElementById(button.getAttribute("aria-controls"));
          const opening = nav?.dataset.open !== "true";
          nav.dataset.open = String(opening);
          button.setAttribute("aria-expanded", String(opening));
          button.setAttribute("aria-label", opening ? "Close navigation" : "Open navigation");
          button.querySelector("[data-nav-open-icon]")?.toggleAttribute("hidden", opening);
          button.querySelector("[data-nav-close-icon]")?.toggleAttribute("hidden", !opening);
        })
      );
    </script>
  </body>
</html>

<style>
  .docs-nav-panel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    opacity: 0;
    transition:
      grid-template-rows var(--duration-normal) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard);
  }
  .docs-nav-panel-inner {
    min-height: 0;
    overflow: hidden;
  }
  .docs-nav-group[data-open="true"] > .docs-nav-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .docs-nav-panel,
    .docs-nav-chevron {
      transition: none !important;
    }
  }
</style>
