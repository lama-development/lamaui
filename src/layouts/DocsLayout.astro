---
import CategoryIcon from "@/components/docs/CategoryIcon.astro";
import { svgSearch, svgMenu, svgClose, svgPuzzle, svgHouse, svgChevronDown, svgExternal } from "@icons/docs";
import { controlStyles, ghostStyles, iconControlStyles } from "@/lib/styles";
import "@/styles/global.css";
import googleSansFlexUrl from "@/assets/fonts/google-sans-flex.woff2?url";
import Icon from "@/components/ui/Icon.astro";
import AccentPicker from "@/components/ui/AccentPicker.astro";
import ThemePicker from "@/components/ui/ThemePicker.astro";
import DocsSearch from "@/components/docs/DocsSearch.astro";
import Llama from "@/assets/icons/llama.svg";
import { componentGroups } from "@/lib/components";
import { version } from "@package";
interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
  currentPage?: "overview" | "getting-started";
}
const { title = "LamaUI - Components", description = "Reusable Astro components extracted from a focused dashboard design language.", currentSlug, currentPage = currentSlug ? undefined : "overview" } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} /><meta name="theme-color" content="#fcfdfa" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicons/favicon-96x96.png" />
    <link rel="shortcut icon" href="/favicons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <link rel="preload" href={googleSansFlexUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem("lamaui-theme");
          if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
          const accent = localStorage.getItem("lamaui-accent");
          if (["lime", "blue", "violet", "rose", "orange", "teal", "neutral"].includes(accent)) document.documentElement.dataset.accent = accent;
        } catch {}
      })();
    </script>
  </head>
  <body class="bg-surface-1" data-surface-level="1">
    <script>
      import "@/scripts/components";
      import "@/scripts/navbar-scroll";
    </script>
    <a href="#main-content" class="skip-link fixed inset-[8px_auto_auto_8px] z-200 transform-[translateY(-80px)] rounded-md bg-accent px-3 py-2 text-sm font-semibold text-accent-label focus:transform-[translateY(0)] print:hidden">Skip to content</a>
    <header data-surface-level="2" class="docs-mobile-header hidden print:hidden [@media(width<=860px)]:sticky [@media(width<=860px)]:top-0 [@media(width<=860px)]:z-40 [@media(width<=860px)]:flex [@media(width<=860px)]:min-h-14 [@media(width<=860px)]:items-center [@media(width<=860px)]:justify-between [@media(width<=860px)]:border-b [@media(width<=860px)]:border-outline [@media(width<=860px)]:bg-surface-2 [@media(width<=860px)]:p-[0.375rem_0.75rem] [@media(width<=860px)]:[&_.docs-brand_small]:hidden">
      <a href="/" aria-label="LamaUI home" class="docs-brand flex min-w-0 flex-1 items-center gap-2.5 rounded-md text-label no-underline [&_strong]:block [&_strong]:text-lg [&_strong]:leading-none"><Llama class="docs-mark size-8 flex-none" width={32} height={32} aria-hidden="true" focusable="false" /><strong>LamaUI</strong></a>
      <div class="ml-auto flex shrink-0 items-center gap-1">
        <button type="button" class={`${controlStyles} ${ghostStyles} ${iconControlStyles}`} aria-label="Search documentation" aria-haspopup="dialog" aria-controls="docs-search" aria-expanded="false" aria-keyshortcuts="Meta+K Control+K" data-search-open><Icon src={svgSearch} /></button>
        <button type="button" class={`${controlStyles} ${ghostStyles} ${iconControlStyles}`} aria-label="Open navigation" aria-controls="docs-navigation" aria-expanded="false" data-docs-open><Icon src={svgMenu} /></button>
      </div>
    </header>
    <aside data-surface-level="2" id="docs-navigation" class="docs-sidebar fixed inset-[0_auto_0_0] z-50 w-60 border-r border-outline bg-surface-2 print:hidden [@media(width<=860px)]:z-80 [@media(width<=860px)]:transform-[translateX(-105%)] [@media(width<=860px)]:shadow-(--shadow-lg) [@media(width<=860px)]:data-[open=true]:transform-[translateX(0)]" data-open="false" aria-label="Documentation navigation">
      <div class="docs-sidebar-inner flex h-full min-h-0 flex-col px-3 pb-3">
        <div class="docs-sidebar-head -mx-3 flex min-h-14 flex-none items-center gap-2 border-b border-outline px-3 py-1.5">
          <a href="/" aria-label="LamaUI home" class="docs-brand flex min-w-0 flex-1 items-center gap-2.5 rounded-md text-label no-underline [&_strong]:block [&_strong]:text-lg [&_strong]:leading-none"><Llama class="docs-mark size-8 flex-none" width={32} height={32} aria-hidden="true" focusable="false" /><strong>LamaUI</strong></a>
          <button type="button" class={`${controlStyles} ${ghostStyles} ${iconControlStyles} docs-sidebar-close min-[861px]:hidden!`} aria-label="Close navigation" data-docs-close><Icon src={svgClose} /></button>
        </div>
        <button type="button" class="mt-3 flex min-h-11 w-full cursor-pointer items-center gap-2 rounded-md border border-outline bg-surface px-3 text-sm text-muted-label hover:bg-surface-hover focus-visible:outline-2 focus-visible:outline-ring" aria-haspopup="dialog" aria-controls="docs-search" aria-expanded="false" aria-label="Search documentation" aria-keyshortcuts="Meta+K Control+K" data-search-open><Icon src={svgSearch} size={18} /><span class="flex-1 text-left">Search docs…</span><kbd data-search-shortcut class="rounded border border-outline px-1.5 py-0.5 text-[0.6875rem]">⌘ K</kbd></button>
        <nav class="docs-nav -me-3 min-h-0 flex-1 scrollbar-gutter-stable overflow-auto py-3 pe-3" aria-label="Documentation">
          <div aria-labelledby="docs-nav-start">
            <p id="docs-nav-start" class="m-0 px-3 pt-1 pb-1.5 text-sm font-semibold text-label">Start</p>
            <div class="grid gap-1">
              <a href="/getting-started" aria-current={currentPage === "getting-started" ? "page" : undefined} class="docs-nav-row flex min-h-11 cursor-pointer items-center gap-3 rounded-md px-3 py-2 text-sm text-muted-label no-underline [corner-shape:squircle] hover:bg-surface-hover hover:text-label aria-[current=page]:bg-accent-subtle aria-[current=page]:font-semibold aria-[current=page]:text-accent hover:aria-[current=page]:bg-accent-subtle hover:aria-[current=page]:text-accent [&_span]:flex-1 [&_svg]:flex-none"><Icon src={svgHouse} /><span>Getting started</span></a>
              <a href="/" aria-current={currentPage === "overview" ? "page" : undefined} class="docs-nav-row flex min-h-11 cursor-pointer items-center gap-3 rounded-md px-3 py-2 text-sm text-muted-label no-underline [corner-shape:squircle] hover:bg-surface-hover hover:text-label aria-[current=page]:bg-accent-subtle aria-[current=page]:font-semibold aria-[current=page]:text-accent hover:aria-[current=page]:bg-accent-subtle hover:aria-[current=page]:text-accent [&_span]:flex-1 [&_svg]:flex-none"><Icon src={svgPuzzle} /><span>All components</span></a>
            </div>
          </div>
          <div class="mt-5" aria-labelledby="docs-nav-components">
            <p id="docs-nav-components" class="m-0 px-3 pb-1.5 text-sm font-semibold text-label">Components</p>
            <div class="grid gap-1">
              {
                componentGroups.map((group) => {
                  const containsCurrent = group.components.some((item) => item.slug === currentSlug);
                  return (
                    <div class="docs-nav-group [&_li_a]:flex [&_li_a]:min-h-9 [&_li_a]:items-center [&_li_a]:rounded-[0.625rem] [&_li_a]:p-[0.375rem_0.75rem] [&_li_a]:text-sm [&_li_a]:leading-tight [&_li_a]:text-muted-label [&_li_a]:no-underline [&_li_a:hover]:bg-surface-hover [&_li_a:hover]:text-label [&_li_a[aria-current=page]]:bg-accent-subtle [&_li_a[aria-current=page]]:font-semibold [&_li_a[aria-current=page]]:text-accent [&_li_a[aria-current=page]:hover]:bg-accent-subtle [&_li_a[aria-current=page]:hover]:text-accent [&_li+li]:mt-1 [&_ul]:m-0 [&_ul]:list-none [&_ul]:p-[0.25rem_0_0.375rem_2rem] [&[data-open=true]_.docs-nav-chevron]:transform-[rotate(180deg)]" data-open={String(containsCurrent)}>
                      <button type="button" class:list={["docs-nav-row flex min-h-11 w-full cursor-pointer items-center gap-3 rounded-md border-0 bg-transparent px-3 py-2 text-left text-sm text-muted-label no-underline [corner-shape:squircle] hover:bg-surface-hover hover:text-label [&_span]:flex-1 [&_svg]:flex-none", containsCurrent && "font-semibold text-accent hover:text-accent"]} aria-expanded={containsCurrent} aria-controls={`docs-nav-${group.slug}`} data-docs-group-toggle>
                        <>
                          <CategoryIcon group={group.slug} />
                          <span>{group.name}</span>
                          <Icon src={svgChevronDown} size={16} class="docs-nav-chevron" />
                        </>
                      </button>
                      <div id={`docs-nav-${group.slug}`} class="docs-nav-panel" inert={!containsCurrent}>
                        <div class="docs-nav-panel-inner">
                          <ul>
                            {group.components.map((item) => (
                              <li>
                                <a href={`/components/${item.slug}`} aria-current={item.slug === currentSlug ? "page" : undefined}>
                                  {item.name}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </nav>
        <div class="docs-sidebar-foot relative z-1 -mx-3 flex flex-none items-center gap-2 border-t border-outline px-3 pt-3">
          <ThemePicker />
          <AccentPicker id="sidebar-accent" />
        </div>
      </div>
    </aside>
    <button class="docs-scrim print:hidden [@media(width<=860px)]:fixed [@media(width<=860px)]:inset-0 [@media(width<=860px)]:z-70 [@media(width<=860px)]:border-0 [@media(width<=860px)]:bg-overlay" aria-label="Close navigation" data-docs-scrim data-open="false" hidden></button>
    <div data-surface-level="1" class="docs-page min-h-screen bg-page pl-60 print:pl-0 [@media(width<=860px)]:pl-0">
      <main id="main-content" class="docs-content mx-auto min-h-[calc(100vh-4rem)] w-[min(100%-6rem,98rem)] pt-12 pb-20 print:min-h-0 print:w-full print:p-0 [@media(620px<width<=860px)]:w-[min(100%-4rem,98rem)] [@media(620px<width<=860px)]:pt-8 [@media(width<=620px)]:w-[min(100%-2rem,98rem)] [@media(width<=620px)]:pt-5 [@media(width<=620px)]:pb-12"><slot /></main>
      <footer class="docs-footer mx-auto flex w-[min(100%-6rem,98rem)] flex-wrap items-center justify-between gap-[0.75rem_1.5rem] border-t border-outline pt-4 pb-8 text-[0.8125rem] text-muted-label print:hidden [@media(620px<width<=860px)]:w-[min(100%-4rem,98rem)] [@media(width<=620px)]:w-[min(100%-2rem,98rem)] [@media(width<=620px)]:flex-col [@media(width<=620px)]:justify-center [@media(width<=620px)]:gap-2 [@media(width<=620px)]:pb-5 [@media(width<=620px)]:text-center">
        <span>&copy; {year} LamaUI</span>
        <div class="docs-footer-links ms-auto flex items-center gap-2 [&_a]:inline-flex [&_a]:items-center [&_a]:gap-1.5 [&_a]:no-underline [&_a:hover]:underline [@media(width<=620px)]:ms-0">
          <span>v{version}</span>
          <span class="size-1 rounded-full bg-current opacity-70" aria-hidden="true"></span>
          <a href="https://github.com/lama-development/lamaui/issues/new" target="_blank" rel="noopener noreferrer">Report a problem<Icon src={svgExternal} size={16} /><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </footer>
    </div>
    <DocsSearch />
    <script is:inline>
      const $ = (selector, root = document) => root.querySelector(selector);
      const $$ = (selector, root = document) => Array.from(root.querySelectorAll(selector));
      const syncScrollbarCompensation = () => {
        if ($$("dialog[open]").length) return;
        const needsCompensation = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        document.documentElement.style.setProperty("--scrollbar-compensation", `${needsCompensation ? window.innerWidth - document.documentElement.clientWidth : 0}px`);
      };
      syncScrollbarCompensation();
      window.addEventListener("resize", syncScrollbarCompensation);
      const sidebar = $("#docs-navigation"),
        scrim = $("[data-docs-scrim]"),
        opener = $("[data-docs-open]"),
        closer = $("[data-docs-close]"),
        mobileNavigation = window.matchMedia("(max-width: 860px)");
      let scrimHideTimer, navigationFrame;
      const setBackgroundInert = (inert) => {
        $(".docs-page").inert = inert;
        $(".docs-mobile-header").inert = inert;
      };
      const setNavigation = (open) => {
        if (!sidebar || !scrim || !opener) return;
        window.clearTimeout(scrimHideTimer);
        cancelAnimationFrame(navigationFrame);
        if (open) {
          scrim.hidden = false;
          sidebar.inert = false;
          sidebar.setAttribute("role", "dialog");
          sidebar.setAttribute("aria-modal", "true");
          setBackgroundInert(true);
          navigationFrame = requestAnimationFrame(() => {
            sidebar.dataset.open = "true";
            scrim.dataset.open = "true";
            opener.setAttribute("aria-expanded", "true");
            document.body.classList.add("docs-navigation-open");
            closer?.focus();
          });
          return;
        }
        sidebar?.setAttribute("data-open", String(open));
        opener?.setAttribute("aria-expanded", String(open));
        scrim.dataset.open = "false";
        sidebar.removeAttribute("role");
        sidebar.removeAttribute("aria-modal");
        setBackgroundInert(false);
        document.body.classList.toggle("docs-navigation-open", open);
        if (mobileNavigation.matches) sidebar.inert = true;
        scrimHideTimer = window.setTimeout(() => {
          if (scrim.dataset.open === "false") scrim.hidden = true;
        }, 180);
        opener.focus();
      };
      opener?.addEventListener("click", () => setNavigation(true));
      closer?.addEventListener("click", () => setNavigation(false));
      scrim?.addEventListener("click", () => setNavigation(false));
      document.addEventListener("keydown", (event) => {
        if (sidebar?.dataset.open !== "true" || document.querySelector("dialog[open]")) return;
        if (event.key === "Escape") setNavigation(false);
        if (event.key === "Tab") {
          const focusable = $$("a[href], button:not(:disabled), input:not(:disabled), [tabindex='0']", sidebar).filter((element) => element.offsetParent !== null && !element.closest("[inert]"));
          const first = focusable[0],
            last = focusable[focusable.length - 1];
          if (event.shiftKey && (document.activeElement === first || !sidebar.contains(document.activeElement))) {
            event.preventDefault();
            last?.focus();
          } else if (!event.shiftKey && (document.activeElement === last || !sidebar.contains(document.activeElement))) {
            event.preventDefault();
            first?.focus();
          }
        }
      });
      const syncNavigationMode = () => {
        if (mobileNavigation.matches) {
          sidebar.inert = sidebar.dataset.open !== "true";
          return;
        }
        window.clearTimeout(scrimHideTimer);
        cancelAnimationFrame(navigationFrame);
        sidebar.inert = false;
        sidebar.removeAttribute("role");
        sidebar.removeAttribute("aria-modal");
        setBackgroundInert(false);
        sidebar.dataset.open = "false";
        scrim.dataset.open = "false";
        scrim.hidden = true;
        opener.setAttribute("aria-expanded", "false");
        document.body.classList.remove("docs-navigation-open");
      };
      mobileNavigation.addEventListener("change", syncNavigationMode);
      syncNavigationMode();
      $$(".docs-nav-group").forEach((group) => {
        const toggle = $("[data-docs-group-toggle]", group);
        toggle?.addEventListener("click", () => {
          const opening = group.dataset.open !== "true";
          $$(".docs-nav-group").forEach((other) => {
            const open = other === group && opening;
            other.dataset.open = String(open);
            $("[data-docs-group-toggle]", other)?.setAttribute("aria-expanded", String(open));
            const panel = $(".docs-nav-panel", other);
            if (panel) panel.inert = !open;
          });
        });
      });
      $$("[data-preview-reset]").forEach((button) => {
        const preview = button.closest(".component-preview");
        const tagRow = $(".tag-row", preview);
        const initialTags = tagRow ? Array.from(tagRow.childNodes, (node) => node.cloneNode(true)) : [];
        button.addEventListener("click", () => {
          $$("[data-dismiss-hide]", preview).forEach((alert) => (alert.hidden = false));
          if (tagRow) tagRow.replaceChildren(...initialTags.map((node) => node.cloneNode(true)));
        });
      });
    </script>
  </body>
</html>

<style>
  .docs-nav-panel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    opacity: 0;
  }
  .docs-nav-panel-inner {
    min-height: 0;
    overflow: hidden;
  }
  .docs-nav-group[data-open="true"] > .docs-nav-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }
</style>
